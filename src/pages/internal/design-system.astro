---
import DesignSystemExample from '../../components/blocks/internal/DesignSystemExample.astro';
import IconSamples from '../../components/blocks/internal/IconSamples.astro';
import LayerStackDemo from '../../components/blocks/internal/LayerStackDemo.astro';
import MotionDemoCard from '../../components/blocks/internal/MotionDemoCard.astro';
import TokenSwatch from '../../components/blocks/internal/TokenSwatch.astro';
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import LogoCloud from '../../components/blocks/LogoCloud.astro';
import Stats from '../../components/blocks/Stats.astro';
import LayeredPlatform from '../../components/illustrations/scenes/LayeredPlatform.astro';
import Badge from '../../components/primitives/Badge.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Divider from '../../components/primitives/Divider.astro';
import Grid from '../../components/primitives/Grid.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import {layeredPlatformScene} from '../../data/illustrations/layered-platform';
import {memberLogos} from '../../data/member-logos';
import BaseLayout from '../../layouts/BaseLayout.astro';

type TypeScale = 'display-xl' | 'display-l' | 'heading-xl' | 'heading-l' | 'heading-m';
type Principle = {
  title: string;
  description: string;
};
type SurfaceSample = {
  step: string;
  label: string;
  description: string;
  tokenClass: string;
};
type TypeSample = {
  label: string;
  size: TypeScale;
  sample: string;
};
type TextCard = {
  title: string;
  description: string;
};
type ListCard = TextCard & {
  items: string[];
};
type MotionSample = {
  name: string;
  duration: string;
  usage: string;
};

const principles: Principle[] = [
  {
    title: 'Dark-first identity',
    description: 'Use deep infrastructure surfaces as the default brand canvas for high-impact pages.',
  },
  {
    title: 'Layers create trust',
    description: 'Surface steps, borders, and elevation should imply isolation, virtualization, and safety.',
  },
  {
    title: 'Reusable foundations',
    description: 'Prefer tokens, layout primitives, and small components over page-specific visual inventions.',
  },
];

const surfaces: SurfaceSample[] = [
  {
    step: '0',
    label: 'Base canvas',
    description: 'Page background and deepest system layer.',
    tokenClass: 'uno-bg-xp-surface-0',
  },
  {
    step: '1',
    label: 'Section canvas',
    description: 'Default dark section for high-impact brand moments.',
    tokenClass: 'uno-bg-xp-surface-1',
  },
  {
    step: '2',
    label: 'Raised surface',
    description: 'Cards, callouts, and proof blocks above a section.',
    tokenClass: 'uno-bg-xp-surface-2',
  },
  {
    step: '3',
    label: 'Active surface',
    description: 'Interactive, selected, or highest local emphasis.',
    tokenClass: 'uno-bg-xp-surface-3',
  },
];

const typography: TypeSample[] = [
  {
    label: 'Display XL',
    size: 'display-xl',
    sample: 'A mature hypervisor for infrastructure that cannot fail.',
  },
  {
    label: 'Display L',
    size: 'display-l',
    sample: 'Layered virtualization, built in the open.',
  },
  {
    label: 'Heading XL',
    size: 'heading-xl',
    sample: 'Systems confidence',
  },
  {
    label: 'Heading L',
    size: 'heading-l',
    sample: 'A foundation for secure platforms',
  },
  {
    label: 'Heading M',
    size: 'heading-m',
    sample: 'Isolation layer',
  },
];

const layouts: TextCard[] = [
  {
    title: 'Container',
    description: 'Constrain reading width with xp-content, page layouts with xp-page, and broad compositions with xp-wide.',
  },
  {
    title: 'Section',
    description: 'Use full-width bands on surface 0 or 1. Sections should not need decorative wrappers.',
  },
  {
    title: 'Stack',
    description: 'Use vertical rhythm for prose, forms, and ordered content.',
  },
  {
    title: 'Flow',
    description: 'Let related text and actions follow source order with predictable gaps.',
  },
  {
    title: 'Grid',
    description: 'Use equal-weight proof, feature, member, and resource collections.',
  },
  {
    title: 'Split',
    description: 'Pair an argument with evidence, media, or a compact technical panel.',
  },
  {
    title: 'Cluster',
    description: 'Wrap badges, actions, filters, and metadata without layout shifts.',
  },
];

const primitives: TextCard[] = [
  {
    title: 'Button',
    description: 'Primary, secondary, and text actions. Keep labels short and states obvious.',
  },
  {
    title: 'Card',
    description: 'A repeated item on surface 2. Use for proof, resources, features, and links.',
  },
  {
    title: 'Badge',
    description: 'Compact status, category, release, or ecosystem labels.',
  },
  {
    title: 'Divider',
    description: 'A structural line that separates layers or content groups.',
  },
  {
    title: 'Surface',
    description: 'A token-backed background step: 0, 1, 2, 3, or intentional light.',
  },
  {
    title: 'Heading',
    description: 'Semantic heading with display and content sizes.',
  },
  {
    title: 'Text',
    description: 'Body, lead, caption, eyebrow, and monospaced annotations.',
  },
];

const iconography: TextCard[] = [
  {
    title: 'Size',
    description: 'Use 20px for inline UI, 24px for compact cards, and 32px only for larger explanatory moments.',
  },
  {
    title: 'Style',
    description: 'Prefer simple line icons with a consistent stroke. Filled icons are reserved for status or brand marks.',
  },
  {
    title: 'Alignment',
    description: 'Align icons to text cap height or center them in fixed-size controls to prevent layout shift.',
  },
  {
    title: 'Purpose',
    description: 'Use icons to clarify actions, statuses, systems, or navigation. Do not use them as decoration.',
  },
];

const accessibility: TextCard[] = [
  {
    title: 'Focus',
    description: 'Keyboard focus uses a visible token-backed ring on dark and light surfaces.',
  },
  {
    title: 'Keyboard',
    description: 'Interactive primitives must be reachable and usable without pointer input.',
  },
  {
    title: 'Contrast',
    description: 'Use documented text and surface pairings; do not invent opacity-based text tones.',
  },
  {
    title: 'Reduced motion',
    description: 'Motion should have a reduced-motion fallback and never hide content.',
  },
];

const motion: MotionSample[] = [
  {
    name: 'Fast',
    duration: '120ms',
    usage: 'Hover color, focus affordance, compact state change.',
  },
  {
    name: 'Base',
    duration: '200ms',
    usage: 'Elevation, small transform, disclosure.',
  },
  {
    name: 'Slow',
    duration: '360ms',
    usage: 'Section reveal or larger layered transition.',
  },
];

const foundationDetails: TextCard[] = [
  {
    title: 'Color',
    description: 'Use surface, text, border, accent, warning, and danger tokens as documented pairings.',
  },
  {
    title: 'Spacing',
    description: 'Use the 4px-based spacing scale and section rhythm. Dense technical content should remain scannable.',
  },
  {
    title: 'Elevation',
    description: 'Use elevation to show layer order, not to create decorative depth.',
  },
  {
    title: 'Motion',
    description: 'Motion clarifies relationship, emphasis, or state. It should be short, reversible, and optional.',
  },
];

const futureIllustrationScenes: TextCard[] = [
  {
    title: 'Safety boundary',
    description: 'Reuse layer planes, connector brackets, and HTML callouts to explain isolation, containment, and assurance.',
  },
  {
    title: 'Automotive stack',
    description: 'Reuse the platform scene with hardware emphasis, domain labels, and restrained generated interiors.',
  },
  {
    title: 'Community network',
    description: 'Reuse SVG topology lines, labels, and muted node surfaces to show governance and ecosystem relationships.',
  },
  {
    title: 'Downloads flow',
    description: 'Reuse layer index, connector paths, and proof callouts to explain releases, artifacts, verification, and docs.',
  },
];

const diagramStates: ListCard[] = [
  {
    title: 'Exploded',
    description: 'Teach architecture, reveal ownership, explain separation, and show boundaries.',
    items: ['Hero sections', 'Architecture explanations', 'Educational content'],
  },
  {
    title: 'Assembled',
    description: 'Show composition, complete systems, ecosystem projects, and deployment or reference architecture stories.',
    items: ['Ecosystem sections', 'Deployment patterns', 'Reference architecture summaries'],
  },
];

const layerSemantics: ListCard[] = [
  {
    title: 'Typical stack',
    description: 'Each layer should represent a meaningful architectural boundary.',
    items: ['Applications', 'Guest systems', 'Xen Hypervisor', 'Hardware'],
  },
  {
    title: 'Authoring rule',
    description: 'Labels may change for a domain, but the mental model should stay explicit.',
    items: ['Avoid decorative layers', 'Avoid non-architectural layers', 'Preserve boundaries and ownership'],
  },
];

const diagramMotionGuidance: ListCard[] = [
  {
    title: 'Preferred',
    description: 'Motion should communicate engineering, not entertainment.',
    items: ['Slight lift', 'Subtle brightening', 'Restrained depth', 'Gentle breathing', 'Reduced-motion fallback'],
  },
  {
    title: 'Avoid',
    description: 'Movement should never compete with technical content.',
    items: ['Bouncing', 'Spinning', 'Elastic easing', 'Continuous attention-grabbing loops', 'Distracting motion'],
  },
];

const vocabularyGuidance: ListCard[] = [
  {
    title: 'Prefer',
    description: 'Use language that makes architecture visible and testable.',
    items: ['explicit', 'visible', 'inspectable', 'ownership', 'isolation', 'architecture', 'maintainable', 'platform', 'deterministic', 'long-lived', 'mixed-criticality', 'composable', 'open engineering'],
  },
  {
    title: 'Avoid',
    description: 'Keep the voice technical and concrete.',
    items: ['magic', 'seamless', 'effortless', 'revolutionary', 'futuristic', 'generic cyber/cloud language', 'hype-driven AI language'],
  },
];

const solutionPageArc = ['Hero', 'Problem', 'Architecture principles', 'Technical capabilities', 'Domain example', 'Ecosystem', 'Evaluation', 'Participation', 'CTA'];

const blockActions = [
  {label: 'Primary action', href: '#blocks'},
  {label: 'Secondary action', href: '#composition', variant: 'secondary' as const},
];

const blockFeatures = [
  {
    icon: 'i-carbon-layers',
    title: 'Layered systems',
    description: 'Use cards for reusable proof, capabilities, and technical explanations.',
    href: '#composition',
    linkLabel: 'View composition',
  },
  {
    icon: 'i-carbon-security',
    title: 'Trust signals',
    description: 'Pair claims with evidence that future pages can reuse without custom layout code.',
  },
  {
    icon: 'i-carbon-ibm-cloud-vpc',
    title: 'Infrastructure fit',
    description: 'Keep dense technical content scannable across small and large screens.',
  },
];

const blockStats = [
  {
    value: '20+ years',
    label: 'Open development',
    description: 'A long-running project needs proof blocks that feel mature, not nostalgic.',
    sourceHref: 'https://xenproject.org/',
    sourceLabel: 'Project site',
  },
  {
    value: '3 layers',
    label: 'Reusable hierarchy',
    description: 'Primitives, blocks, and pages keep layout decisions in the right place.',
  },
  {
    value: '0 legacy CSS',
    label: 'Clean boundary',
    description: 'New blocks stay independent of the migrated Sass cascade.',
  },
];
---

<BaseLayout title="Design System" description="Internal Xen Project design system reference." robots="noindex, nofollow" bodyClass="xp-design-system">
  <main class="uno-min-h-screen uno-bg-xp-surface-0 uno-text-xp-text-primary">
    <div class="uno-px-4 uno-pt-4 md:uno-px-6">
      <Container>
        <Surface as="aside" tone="1" padding="sm" class="uno-bg-[linear-gradient(90deg,rgb(133_194_65_/_0.10),transparent_26rem)]" aria-label="Internal development resource">
          <Cluster align="start">
            <Text as="span" size="caption" tone="accent-primary" class="uno-shrink-0 uno-font-bold">Internal development resource</Text>
            <Text size="caption">
              This page documents the Xen Design System and is intended for contributors and maintainers. It is not part of the public website.
            </Text>
          </Cluster>
        </Surface>
      </Container>
    </div>

    <Section variant="hero">
      <Container>
        <Split align="center">
          <Stack gap="5" class="uno-max-w-xp-page">
            <Text size="eyebrow" tone="accent-primary">Xen Design System</Text>
            <Heading as="h1" size="display-xl" class="uno-max-w-5xl">Dark layered foundations for infrastructure-grade pages.</Heading>
            <Text size="lead" class="uno-max-w-xp-content">
              This page is the source of truth for new XenProject.org pages. It keeps the system small: principles, tokens, layout rules, primitives, accessibility, and a few compositions.
            </Text>
          </Stack>
          <LayerStackDemo />
        </Split>
      </Container>
    </Section>

    <Section>
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Principles</Text>
            <Heading size="heading-xl">Small, dark-first, composable.</Heading>
            <Text>
              The system should define the homepage, not the other way around. Add only foundations and primitives that will serve multiple future pages.
            </Text>
          </Stack>
          <Grid columns="3">
            {principles.map(principle => (
              <Card>
                <Heading as="h3" size="heading-m">{principle.title}</Heading>
                <Text size="caption" class="uno-mt-3">{principle.description}</Text>
              </Card>
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section surface="1">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Foundations</Text>
            <Heading size="heading-xl">Surfaces carry the identity.</Heading>
            <Text>
              Dark surfaces are the brand canvas. Light surfaces are secondary tools for readability, data density, or intentional contrast.
            </Text>
          </Stack>
          <Grid columns="4">
            {surfaces.map(surface => (
              <TokenSwatch step={surface.step} label={surface.label} description={surface.description} tokenClass={surface.tokenClass} />
            ))}
          </Grid>
          <Grid columns="2">
            {foundationDetails.map(detail => (
              <Stack gap="3">
                <Divider />
                <Heading as="h3" size="heading-m">{detail.title}</Heading>
                <Text size="caption">{detail.description}</Text>
              </Stack>
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section>
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Typography</Text>
            <Heading size="heading-xl">A calm technical scale.</Heading>
            <Text>Inter carries the main voice. JetBrains Mono is reserved for version labels, code-like metadata, and technical annotations.</Text>
          </Stack>
          <Stack gap="5">
            {typography.map(typeSample => (
              <div class="uno-grid uno-grid-cols-1 uno-gap-2 uno-border-0 uno-border-t uno-border-solid uno-border-xp-border-muted uno-pt-5 md:uno-grid-cols-[minmax(7rem,0.22fr)_minmax(0,1fr)] md:uno-gap-5">
                <Text size="mono-small" tone="muted">{typeSample.label}</Text>
                <Heading as="h3" size={typeSample.size}>{typeSample.sample}</Heading>
              </div>
            ))}
            <div class="uno-grid uno-grid-cols-1 uno-gap-2 uno-border-0 uno-border-t uno-border-solid uno-border-xp-border-muted uno-pt-5 md:uno-grid-cols-[minmax(7rem,0.22fr)_minmax(0,1fr)] md:uno-gap-5">
              <Text size="mono-small" tone="muted">Body</Text>
              <Text>Body copy explains the claim with enough technical specificity to build confidence without adding visual noise.</Text>
            </div>
            <div class="uno-grid uno-grid-cols-1 uno-gap-2 uno-border-0 uno-border-t uno-border-solid uno-border-xp-border-muted uno-pt-5 md:uno-grid-cols-[minmax(7rem,0.22fr)_minmax(0,1fr)] md:uno-gap-5">
              <Text size="mono-small" tone="muted">Caption</Text>
              <Text size="caption" tone="muted">Caption text supports metadata, labels, timestamps, and lower-emphasis explanatory copy.</Text>
            </div>
          </Stack>
        </Stack>
      </Container>
    </Section>

    <Section surface="1">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Layout</Text>
            <Heading size="heading-xl">Seven layout primitives are enough.</Heading>
            <Text>Pages should be composed from a small set of repeatable layout behaviors before introducing named blocks.</Text>
          </Stack>
          <Grid columns="2">
            {layouts.map(layout => (
              <Card>
                <Heading as="h3" size="heading-m">{layout.title}</Heading>
                <Text size="caption" class="uno-mt-2">{layout.description}</Text>
              </Card>
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section>
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Primitives</Text>
            <Heading size="heading-xl">Reusable before expressive.</Heading>
            <Text>Primitives own semantics, variants, and state. Shortcuts should only capture shared visual recipes.</Text>
          </Stack>
          <Split align="center">
            <Stack gap="5">
              <Cluster>
                <Button href="#composition">Primary action</Button>
                <Button href="#accessibility" variant="secondary">Secondary action</Button>
                <Button href="#motion" variant="text">Text link</Button>
              </Cluster>
              <Cluster>
                <Badge>Stable</Badge>
                <Badge variant="info">Open source</Badge>
                <Badge variant="muted">Hypervisor</Badge>
              </Cluster>
            </Stack>
            <Grid columns="2">
              {primitives.map(primitive => (
                <Card>
                  <Heading as="h3" size="heading-m">{primitive.title}</Heading>
                  <Text size="caption" class="uno-mt-2">{primitive.description}</Text>
                </Card>
              ))}
            </Grid>
          </Split>
        </Stack>
      </Container>
    </Section>

    <Section surface="1">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Iconography</Text>
            <Heading size="heading-xl">Icons support technical clarity.</Heading>
            <Text>Use icons sparingly and consistently. They should identify system concepts, actions, status, or navigation faster than text alone.</Text>
          </Stack>
          <Split align="center">
            <IconSamples />
            <Grid columns="2">
              {iconography.map(iconRule => (
                <Card>
                  <Heading as="h3" size="heading-m">{iconRule.title}</Heading>
                  <Text size="caption" class="uno-mt-2">{iconRule.description}</Text>
                </Card>
              ))}
            </Grid>
          </Split>
        </Stack>
      </Container>
    </Section>

    <Section id="accessibility" surface="1">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Accessibility</Text>
            <Heading size="heading-xl">Accessibility is part of the visual system.</Heading>
            <Text>New primitives and blocks must preserve focus, keyboard operation, contrast, and reduced-motion behavior by default.</Text>
          </Stack>
          <Grid columns="2">
            {accessibility.map(accessibilityRule => (
              <Card>
                <Heading as="h3" size="heading-m">{accessibilityRule.title}</Heading>
                <Text size="caption" class="uno-mt-2">{accessibilityRule.description}</Text>
              </Card>
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section id="motion">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Motion</Text>
            <Heading size="heading-xl">Subtle movement, clear purpose.</Heading>
            <Text>Use standard easing for most states and emphasized easing only when a layer changes position or prominence.</Text>
          </Stack>
          <Grid columns="3">
            {motion.map(motionSample => (
              <MotionDemoCard name={motionSample.name} duration={motionSample.duration} usage={motionSample.usage} />
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section id="illustrations" surface="1">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Illustration system</Text>
            <Heading size="heading-xl">Layered architecture is the primary visual language.</Heading>
            <Text>
              The Xen Project visual identity is built around layered platform architecture. Layer diagrams are not illustrations added after page design. They are first-class design components that communicate architecture, isolation, ownership, explicit boundaries, and inspectable systems.
            </Text>
            <Text>
              Future solution pages should reuse this language before inventing unrelated visual metaphors.
            </Text>
          </Stack>
          <Split align="center">
            <LayeredPlatform id="internal-layered-platform" variant="compact" motion="none" />
            <Stack gap="4">
              <Heading as="h3" size="heading-m">{layeredPlatformScene.title}</Heading>
              <Text size="caption">{layeredPlatformScene.description}</Text>
              <Grid columns="2">
                {layeredPlatformScene.assetPlan.map(asset => (
                  <Surface tone="2" border="muted" padding="md" radius="md" shadow="sm">
                    <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">{asset.complexity}</Text>
                    <Heading as="h4" size="heading-m" class="uno-mt-2">{asset.id}</Heading>
                    <Text size="caption" class="uno-mt-2">{asset.purpose}</Text>
                  </Surface>
                ))}
              </Grid>
            </Stack>
          </Split>
          <Grid columns="2">
            {diagramStates.map(state => (
              <Card>
                <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">Canonical state</Text>
                <Heading as="h3" size="heading-m" class="uno-mt-2">{state.title}</Heading>
                <Text size="caption" class="uno-mt-2">{state.description}</Text>
                <ul class="uno-mt-4 uno-grid uno-gap-2 uno-pl-4 uno-text-sm uno-text-xp-text-muted">
                  {state.items.map(item => <li>{item}</li>)}
                </ul>
              </Card>
            ))}
          </Grid>
          <Grid columns="2">
            {layerSemantics.map(rule => (
              <Surface tone="2" border="muted" padding="md" radius="md" shadow="sm">
                <Heading as="h3" size="heading-m">{rule.title}</Heading>
                <Text size="caption" class="uno-mt-2">{rule.description}</Text>
                <Cluster gap="2" class="uno-mt-4">
                  {rule.items.map(item => <Badge variant="muted">{item}</Badge>)}
                </Cluster>
              </Surface>
            ))}
          </Grid>
          <Grid columns="2">
            {diagramMotionGuidance.map(rule => (
              <Stack gap="3">
                <Divider />
                <Heading as="h3" size="heading-m">{rule.title}</Heading>
                <Text size="caption">{rule.description}</Text>
                <Text size="caption" tone="muted">{rule.items.join(' · ')}</Text>
              </Stack>
            ))}
          </Grid>
          <Grid columns="4">
            {futureIllustrationScenes.map(scene => (
              <Card>
                <Heading as="h3" size="heading-m">{scene.title}</Heading>
                <Text size="caption" class="uno-mt-2">{scene.description}</Text>
              </Card>
            ))}
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section id="experience-guidance">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Experience guidance</Text>
            <Heading size="heading-xl">Pages should feel related, not templated.</Heading>
            <Text>
              Solution pages should teach the system before marketing the outcome. Use the same architectural vocabulary and narrative rhythm, then adapt the emphasis to the domain.
            </Text>
          </Stack>
          <Grid columns="2">
            {vocabularyGuidance.map(rule => (
              <Card>
                <Heading as="h3" size="heading-m">{rule.title}</Heading>
                <Text size="caption" class="uno-mt-2">{rule.description}</Text>
                <Cluster gap="2" class="uno-mt-4">
                  {rule.items.map(item => <Badge variant={rule.title === 'Prefer' ? 'info' : 'muted'}>{item}</Badge>)}
                </Cluster>
              </Card>
            ))}
          </Grid>
          <Surface tone="2" border="muted" padding="lg" radius="md" shadow="sm">
            <Stack gap="4">
              <Stack gap="2" class="uno-max-w-xp-content">
                <Heading as="h3" size="heading-m">Solution-page arc</Heading>
                <Text size="caption">
                  This is guidance, not a rigid template. It helps future pages feel like siblings while still fitting their subject.
                </Text>
              </Stack>
              <Cluster gap="2">
                {solutionPageArc.map(step => <Badge>{step}</Badge>)}
              </Cluster>
            </Stack>
          </Surface>
        </Stack>
      </Container>
    </Section>

    <Section id="blocks" surface="1">
      <Container>
        <Stack gap="7">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Blocks</Text>
            <Heading size="heading-xl">Reusable sections for high-impact pages.</Heading>
            <Text>
              Blocks compose primitives into repeatable content patterns. These examples show the component APIs without defining a future homepage.
            </Text>
          </Stack>
        </Stack>
      </Container>
    </Section>

    <Hero
      id="block-hero"
      eyebrow="Hero block"
      title="A reusable lead section for technical pages."
      description="The Hero block supports a focused argument, primary and secondary actions, optional media, and compact proof without relying on page-specific code."
      actions={blockActions}
      headingLevel="h2"
    >
      <Surface slot="media" tone="2" border="strong" radius="lg" shadow="md" padding="lg" aria-label="Layered infrastructure visual">
        <Stack gap="4">
          <Cluster justify="between">
            <Badge variant="accent">Surface 2</Badge>
            <Text as="span" size="mono-small" tone="muted">media slot</Text>
          </Cluster>
          <div class="uno-grid uno-gap-3">
            <div class="uno-h-16 uno-rounded-xp-md uno-border uno-border-solid uno-border-xp-border-muted uno-bg-[linear-gradient(90deg,rgb(133_194_65_/_0.18),transparent)]"></div>
            <div class="uno-ml-6 uno-h-16 uno-rounded-xp-md uno-border uno-border-solid uno-border-xp-border-muted uno-bg-xp-surface-3"></div>
            <div class="uno-ml-12 uno-h-16 uno-rounded-xp-md uno-border uno-border-solid uno-border-xp-border-muted uno-bg-xp-surface-2"></div>
          </div>
        </Stack>
      </Surface>
      <Surface slot="proof" tone="3" border="strong" padding="md" radius="md" shadow="sm">
        <Text size="caption" tone="accent-primary" class="uno-font-bold">Proof slot</Text>
        <Text size="caption" class="uno-mt-2">Use this area for credible metadata, not decoration.</Text>
      </Surface>
    </Hero>

    <LogoCloud
      id="block-logo-cloud"
      eyebrow="LogoCloud block"
      title="Credibility without carousel behavior."
      description="LogoCloud presents members, sponsors, users, or ecosystem marks in a static accessible grid."
      headingLevel="h2"
      surface="light"
      logos={memberLogos}
    />

    <FeatureGrid
      id="block-feature-grid"
      eyebrow="FeatureGrid block"
      title="Reusable cards for technical arguments."
      description="FeatureGrid is the default workhorse for capabilities, benefits, and use-case summaries."
      features={blockFeatures}
    />

    <Stats
      id="block-stats"
      eyebrow="Stats block"
      title="Proof that reads as content."
      description="Stats uses strong typography and optional source links without animated counters."
      stats={blockStats}
    />

    <CTA
      id="block-cta"
      eyebrow="CTA block"
      title="A standard next step for redesigned pages."
      description="CTA keeps action areas consistent while allowing dark-first and light contrast surfaces."
      actions={blockActions}
      align="center"
    />

    <Section id="block-callout" surface="0">
      <Container>
        <Stack gap="5">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Callout block</Text>
            <Heading size="heading-xl">Compact highlights for important context.</Heading>
          </Stack>
          <Grid columns="2">
            <Callout
              title="Accent callout"
              description="Use this for release notes, sponsor moments, or page-specific emphasis that should remain bounded."
              action={{label: 'Read more', href: '#blocks', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-information"></span>
            </Callout>
            <Callout
              title="Warning callout"
              description="Important notices include a visible label so the message does not rely on color alone."
              variant="warning"
              action={{label: 'Review notice', href: '#accessibility', variant: 'secondary'}}
            >
              <span slot="icon" class="i-carbon-warning-alt"></span>
            </Callout>
          </Grid>
        </Stack>
      </Container>
    </Section>

    <Section id="composition" surface="1">
      <Container>
        <Stack gap="6">
          <Stack gap="3" class="uno-max-w-xp-content">
            <Text size="eyebrow" tone="muted">Composition</Text>
            <Heading size="heading-xl">Dark identity, intentional light rhythm.</Heading>
            <Text>
              This miniature composition shows how a page can move from dark canvas to raised dark panels, use one light contrast callout, then return to a dark action surface.
            </Text>
          </Stack>
          <DesignSystemExample>
            <Surface tone="1" padding="md">
              <Stack gap="4">
                <Stack gap="3">
                  <Text size="eyebrow" tone="accent-primary">Dark section</Text>
                  <Heading as="h3" size="heading-l">Layered infrastructure narrative.</Heading>
                </Stack>
                <Grid columns="2">
                  <Card>
                    <span class="i-carbon-layers uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
                    <Heading as="h4" size="heading-m" class="uno-mt-4">Isolation layer</Heading>
                    <Text size="caption" class="uno-mt-2">A raised card on surface 2 for reusable proof or feature content.</Text>
                  </Card>
                  <Card active>
                    <span class="i-carbon-security uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
                    <Heading as="h4" size="heading-m" class="uno-mt-4">Trust layer</Heading>
                    <Text size="caption" class="uno-mt-2">Surface 3 marks the active or locally emphasized panel.</Text>
                  </Card>
                </Grid>
                <Surface as="aside" tone="light-raised" border="light" shadow="md">
                  <Heading as="h4" size="heading-m" tone="on-light">Light contrast callout</Heading>
                  <Text size="caption" tone="on-light-muted" class="uno-mt-2">Use light surfaces for readability, dense data, or a deliberate rhythm change. Keep them bounded.</Text>
                </Surface>
                <Surface tone="3" border="strong">
                  <Cluster justify="between" gap="4">
                    <div>
                      <Heading as="h4" size="heading-m">Return to dark</Heading>
                      <Text size="caption" class="uno-mt-2">The composition ends on the primary brand canvas instead of drifting into a light theme.</Text>
                    </div>
                    <Button href="#top">Primary action</Button>
                  </Cluster>
                </Surface>
              </Stack>
            </Surface>
          </DesignSystemExample>
        </Stack>
      </Container>
    </Section>
  </main>
</BaseLayout>
