---
import Heading from '../../components/primitives/Heading.astro';
import Text from '../../components/primitives/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

type TypeScale = 'display-xl' | 'display-l' | 'heading-xl' | 'heading-l' | 'heading-m';
type TypeSample = [string, TypeScale, string];

const principles = [
  ['Dark-first identity', 'Use deep infrastructure surfaces as the default brand canvas for high-impact pages.'],
  ['Layers create trust', 'Surface steps, borders, and elevation should imply isolation, virtualization, and safety.'],
  ['Reusable foundations', 'Prefer tokens, layout primitives, and small components over page-specific visual inventions.'],
];

const surfaces = [
  ['0', 'Base canvas', 'Page background and deepest system layer.', 'uno-bg-xp-surface-0'],
  ['1', 'Section canvas', 'Default dark section for high-impact brand moments.', 'uno-bg-xp-surface-1'],
  ['2', 'Raised surface', 'Cards, callouts, and proof blocks above a section.', 'uno-bg-xp-surface-2'],
  ['3', 'Active surface', 'Interactive, selected, or highest local emphasis.', 'uno-bg-xp-surface-3'],
];

const typography: TypeSample[] = [
  ['Display XL', 'display-xl', 'A mature hypervisor for infrastructure that cannot fail.'],
  ['Display L', 'display-l', 'Layered virtualization, built in the open.'],
  ['Heading XL', 'heading-xl', 'Systems confidence'],
  ['Heading L', 'heading-l', 'A foundation for secure platforms'],
  ['Heading M', 'heading-m', 'Isolation layer'],
];

const layouts = [
  ['Container', 'Constrain reading width with xp-content, page layouts with xp-page, and broad compositions with xp-wide.'],
  ['Section', 'Use full-width bands on surface 0 or 1. Sections should not need decorative wrappers.'],
  ['Stack', 'Use vertical rhythm for prose, forms, and ordered content.'],
  ['Flow', 'Let related text and actions follow source order with predictable gaps.'],
  ['Grid', 'Use equal-weight proof, feature, member, and resource collections.'],
  ['Split', 'Pair an argument with evidence, media, or a compact technical panel.'],
  ['Cluster', 'Wrap badges, actions, filters, and metadata without layout shifts.'],
];

const primitives = [
  ['Button', 'Primary, secondary, and text actions. Keep labels short and states obvious.'],
  ['Card', 'A repeated item on surface 2. Use for proof, resources, features, and links.'],
  ['Badge', 'Compact status, category, release, or ecosystem labels.'],
  ['Divider', 'A structural line that separates layers or content groups.'],
  ['Surface', 'A token-backed background step: 0, 1, 2, 3, or intentional light.'],
  ['Heading', 'Semantic heading with display and content sizes.'],
  ['Text', 'Body, lead, caption, eyebrow, and monospaced annotations.'],
];

const iconography = [
  ['Size', 'Use 20px for inline UI, 24px for compact cards, and 32px only for larger explanatory moments.'],
  ['Style', 'Prefer simple line icons with a consistent stroke. Filled icons are reserved for status or brand marks.'],
  ['Alignment', 'Align icons to text cap height or center them in fixed-size controls to prevent layout shift.'],
  ['Purpose', 'Use icons to clarify actions, statuses, systems, or navigation. Do not use them as decoration.'],
];

const accessibility = [
  ['Focus', 'Keyboard focus uses a visible token-backed ring on dark and light surfaces.'],
  ['Keyboard', 'Interactive primitives must be reachable and usable without pointer input.'],
  ['Contrast', 'Use documented text and surface pairings; do not invent opacity-based text tones.'],
  ['Reduced motion', 'Motion should have a reduced-motion fallback and never hide content.'],
];

const motion = [
  ['Fast', '120ms', 'Hover color, focus affordance, compact state change.'],
  ['Base', '200ms', 'Elevation, small transform, disclosure.'],
  ['Slow', '360ms', 'Section reveal or larger layered transition.'],
];
---

<BaseLayout title="Design System" description="Internal Xen Project design system reference." robots="noindex, nofollow" bodyClass="xp-design-system">
  <main class="uno-min-h-screen uno-bg-xp-surface-0 uno-text-xp-text-primary">
    <div class="xp-internal-notice-wrap">
      <aside class="xp-internal-notice" aria-label="Internal development resource">
        <span class="xp-internal-notice-kicker">Internal development resource</span>
        <Text size="caption">
          This page documents the Xen Design System and is intended for contributors and maintainers. It is not part of the public website.
        </Text>
      </aside>
    </div>

    <section class="xp-band xp-band-hero">
      <div class="xp-shell xp-layer-grid">
        <div class="uno-max-w-xp-page">
          <Text size="eyebrow" tone="accent-primary">Xen Design System</Text>
          <Heading as="h1" size="display-xl" class="uno-mt-5 uno-max-w-5xl">Dark layered foundations for infrastructure-grade pages.</Heading>
          <Text size="lead" class="uno-mt-6 uno-max-w-xp-content">
            This page is the source of truth for new XenProject.org pages. It keeps the system small: principles, tokens, layout rules, primitives, accessibility, and a few compositions.
          </Text>
        </div>
        <div class="xp-layer-stack" aria-hidden="true">
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
          <span><i></i></span>
        </div>
      </div>
    </section>

    <section class="xp-band">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Principles</Text>
          <Heading size="heading-xl" class="uno-mt-3">Small, dark-first, composable.</Heading>
          <Text class="uno-mt-4">
            The system should define the homepage, not the other way around. Add only foundations and primitives that will serve multiple future pages.
          </Text>
        </div>
        <div class="xp-principle-grid">
          {principles.map(([title, description]) => (
            <article class="xp-card">
              <Heading as="h3" size="heading-m">{title}</Heading>
              <Text size="caption" class="uno-mt-3">{description}</Text>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="xp-band xp-band-raised">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Foundations</Text>
          <Heading size="heading-xl" class="uno-mt-3">Surfaces carry the identity.</Heading>
          <Text class="uno-mt-4">
            Dark surfaces are the brand canvas. Light surfaces are secondary tools for readability, data density, or intentional contrast.
          </Text>
        </div>
        <div class="xp-surface-grid">
          {surfaces.map(([step, label, description, className]) => (
            <article class:list={['xp-surface-swatch', className]}>
              <span class="xp-surface-step">Surface {step}</span>
              <Heading as="h3" size="heading-m" class="uno-mt-4">{label}</Heading>
              <Text size="caption" class="uno-mt-3">{description}</Text>
              <Text size="mono-small" tone="muted" class="uno-mt-6">{className}</Text>
            </article>
          ))}
        </div>
        <div class="xp-foundation-grid">
          <article>
            <Heading as="h3" size="heading-m">Color</Heading>
            <Text size="caption" class="uno-mt-3">Use surface, text, border, accent, warning, and danger tokens as documented pairings.</Text>
          </article>
          <article>
            <Heading as="h3" size="heading-m">Spacing</Heading>
            <Text size="caption" class="uno-mt-3">Use the 4px-based spacing scale and section rhythm. Dense technical content should remain scannable.</Text>
          </article>
          <article>
            <Heading as="h3" size="heading-m">Elevation</Heading>
            <Text size="caption" class="uno-mt-3">Use elevation to show layer order, not to create decorative depth.</Text>
          </article>
          <article>
            <Heading as="h3" size="heading-m">Motion</Heading>
            <Text size="caption" class="uno-mt-3">Motion clarifies relationship, emphasis, or state. It should be short, reversible, and optional.</Text>
          </article>
        </div>
      </div>
    </section>

    <section class="xp-band">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Typography</Text>
          <Heading size="heading-xl" class="uno-mt-3">A calm technical scale.</Heading>
          <Text class="uno-mt-4">Inter carries the main voice. JetBrains Mono is reserved for version labels, code-like metadata, and technical annotations.</Text>
        </div>
        <div class="xp-type-list">
          {typography.map(([label, size, sample]) => (
            <div class="xp-type-row">
              <Text size="mono-small" tone="muted">{label}</Text>
              <Heading as="h3" size={size}>{sample}</Heading>
            </div>
          ))}
          <div class="xp-type-row">
            <Text size="mono-small" tone="muted">Body</Text>
            <Text>Body copy explains the claim with enough technical specificity to build confidence without adding visual noise.</Text>
          </div>
          <div class="xp-type-row">
            <Text size="mono-small" tone="muted">Caption</Text>
            <Text size="caption" tone="muted">Caption text supports metadata, labels, timestamps, and lower-emphasis explanatory copy.</Text>
          </div>
        </div>
      </div>
    </section>

    <section class="xp-band xp-band-raised">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Layout</Text>
          <Heading size="heading-xl" class="uno-mt-3">Seven layout primitives are enough.</Heading>
          <Text class="uno-mt-4">Pages should be composed from a small set of repeatable layout behaviors before introducing named blocks.</Text>
        </div>
        <div class="xp-definition-grid">
          {layouts.map(([name, description]) => (
            <article class="xp-definition">
              <Heading as="h3" size="heading-m">{name}</Heading>
              <Text size="caption" class="uno-mt-2">{description}</Text>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="xp-band">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Primitives</Text>
          <Heading size="heading-xl" class="uno-mt-3">Reusable before expressive.</Heading>
          <Text class="uno-mt-4">Primitives own semantics, variants, and state. Shortcuts should only capture shared visual recipes.</Text>
        </div>
        <div class="xp-primitive-demo">
          <div>
            <div class="xp-cluster">
              <a class="xen-action-primary" href="#composition">Primary action</a>
              <a class="xen-action-secondary" href="#accessibility">Secondary action</a>
              <a class="xp-text-link xen-focus" href="#motion">Text link</a>
            </div>
            <div class="xp-cluster uno-mt-5">
              <span class="xp-badge">Stable</span>
              <span class="xp-badge xp-badge-secondary">Open source</span>
              <span class="xp-badge xp-badge-muted">Hypervisor</span>
            </div>
          </div>
          <div class="xp-definition-grid xp-definition-grid-compact">
            {primitives.map(([name, description]) => (
              <article class="xp-definition">
                <Heading as="h3" size="heading-m">{name}</Heading>
                <Text size="caption" class="uno-mt-2">{description}</Text>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="xp-band xp-band-raised">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Iconography</Text>
          <Heading size="heading-xl" class="uno-mt-3">Icons support technical clarity.</Heading>
          <Text class="uno-mt-4">Use icons sparingly and consistently. They should identify system concepts, actions, status, or navigation faster than text alone.</Text>
        </div>
        <div class="xp-icon-demo">
          <div class="xp-icon-samples" aria-hidden="true">
            <span><i class="i-carbon-layers"></i></span>
            <span><i class="i-carbon-cloud-satellite"></i></span>
            <span><i class="i-carbon-security"></i></span>
            <span><i class="i-carbon-connect"></i></span>
          </div>
          <div class="xp-definition-grid xp-definition-grid-compact">
            {iconography.map(([name, description]) => (
              <article class="xp-definition">
                <Heading as="h3" size="heading-m">{name}</Heading>
                <Text size="caption" class="uno-mt-2">{description}</Text>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="accessibility" class="xp-band xp-band-raised">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Accessibility</Text>
          <Heading size="heading-xl" class="uno-mt-3">Accessibility is part of the visual system.</Heading>
          <Text class="uno-mt-4">New primitives and blocks must preserve focus, keyboard operation, contrast, and reduced-motion behavior by default.</Text>
        </div>
        <div class="xp-definition-grid">
          {accessibility.map(([name, description]) => (
            <article class="xp-definition">
              <Heading as="h3" size="heading-m">{name}</Heading>
              <Text size="caption" class="uno-mt-2">{description}</Text>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="motion" class="xp-band">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Motion</Text>
          <Heading size="heading-xl" class="uno-mt-3">Subtle movement, clear purpose.</Heading>
          <Text class="uno-mt-4">Use standard easing for most states and emphasized easing only when a layer changes position or prominence.</Text>
        </div>
        <div class="xp-motion-grid">
          {motion.map(([name, duration, usage]) => (
            <article class="xp-motion-card">
              <span></span>
              <Text size="mono-small" tone="accent-primary">{duration}</Text>
              <Heading as="h3" size="heading-m" class="uno-mt-2">{name}</Heading>
              <Text size="caption" class="uno-mt-2">{usage}</Text>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="composition" class="xp-band xp-band-raised">
      <div class="xp-shell">
        <div class="xp-section-intro">
          <Text size="eyebrow" tone="muted">Composition</Text>
          <Heading size="heading-xl" class="uno-mt-3">Dark identity, intentional light rhythm.</Heading>
          <Text class="uno-mt-4">
            This miniature composition shows how a page can move from dark canvas to raised dark panels, use one light contrast callout, then return to a dark action surface.
          </Text>
        </div>
        <div class="xp-page-composition">
          <div class="xp-mini-section">
            <Text size="eyebrow" tone="accent-primary">Dark section</Text>
            <Heading as="h3" size="heading-l" class="uno-mt-3">Layered infrastructure narrative.</Heading>
            <div class="xp-mini-card-grid">
              <article class="xp-card">
                <span class="i-carbon-layers xp-card-icon" aria-hidden="true"></span>
                <Heading as="h4" size="heading-m" class="uno-mt-4">Isolation layer</Heading>
                <Text size="caption" class="uno-mt-2">A raised card on surface 2 for reusable proof or feature content.</Text>
              </article>
              <article class="xp-card xp-card-active">
                <span class="i-carbon-security xp-card-icon" aria-hidden="true"></span>
                <Heading as="h4" size="heading-m" class="uno-mt-4">Trust layer</Heading>
                <Text size="caption" class="uno-mt-2">Surface 3 marks the active or locally emphasized panel.</Text>
              </article>
            </div>
            <aside class="xp-mini-light-callout">
              <Heading as="h4" size="heading-m" tone="on-light">Light contrast callout</Heading>
              <Text size="caption" tone="on-light-muted" class="uno-mt-2">Use light surfaces for readability, dense data, or a deliberate rhythm change. Keep them bounded.</Text>
            </aside>
            <div class="xp-mini-cta">
              <div>
                <Heading as="h4" size="heading-m">Return to dark</Heading>
                <Text size="caption" class="uno-mt-2">The composition ends on the primary brand canvas instead of drifting into a light theme.</Text>
              </div>
              <a class="xen-action-primary" href="#top">Primary action</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .xp-band {
    padding: var(--xp-space-section) var(--xp-space-5);
    border-top: 1px solid var(--xp-border-muted);
    background: var(--xp-surface-0);
  }

  .xp-band-hero {
    padding-top: var(--xp-space-8);
    background:
      linear-gradient(180deg, rgb(133 194 65 / 0.10), transparent 34rem),
      var(--xp-surface-0);
  }

  .xp-band-raised {
    background: var(--xp-surface-1);
  }

  .xp-shell {
    width: min(100%, var(--xp-container-wide));
    margin-inline: auto;
  }

  .xp-internal-notice-wrap {
    padding: var(--xp-space-4) var(--xp-space-5) 0;
  }

  .xp-internal-notice {
    display: flex;
    width: min(100%, var(--xp-container-wide));
    margin-inline: auto;
    align-items: center;
    gap: var(--xp-space-3);
    border: 1px solid var(--xp-border-muted);
    border-radius: var(--xp-radius-md);
    background:
      linear-gradient(90deg, rgb(133 194 65 / 0.10), transparent 26rem),
      var(--xp-surface-1);
    padding: var(--xp-space-3) var(--xp-space-4);
    box-shadow: var(--xp-shadow-sm);
  }

  .xp-internal-notice-kicker {
    flex: none;
    color: var(--xp-accent-primary);
    font-size: var(--xp-type-caption);
    font-weight: 700;
  }

  .xp-section-intro {
    max-width: var(--xp-container-content);
  }

  .xp-layer-grid,
  .xp-composition,
  .xp-primitive-demo,
  .xp-icon-demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--xp-space-6);
  }

  .xp-layer-stack {
    position: relative;
    min-height: 24rem;
  }

  .xp-layer-stack span {
    position: absolute;
    right: 0;
    width: min(88%, 36rem);
    height: 6.75rem;
    border: 1px solid var(--xp-border-muted);
    border-radius: var(--xp-radius-lg);
    background:
      linear-gradient(90deg, rgb(133 194 65 / 0.16), transparent 34%),
      linear-gradient(135deg, rgb(255 255 255 / 0.05), transparent 46%),
      var(--xp-surface-2);
    box-shadow: var(--xp-shadow-md);
    transform: translateY(calc(var(--layer-index) * 3rem)) translateX(calc(var(--layer-index) * -2.2rem));
  }

  .xp-layer-stack span::before,
  .xp-layer-stack span::after {
    position: absolute;
    content: "";
    left: 1.25rem;
    right: 1.25rem;
    height: 1px;
    background: linear-gradient(90deg, var(--xp-accent-primary), transparent);
    opacity: 0.45;
  }

  .xp-layer-stack span::before {
    top: 1.25rem;
  }

  .xp-layer-stack span::after {
    bottom: 1.25rem;
  }

  .xp-layer-stack i {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    width: 4.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(133 194 65 / 0.28);
    transform: translateY(-50%);
  }

  .xp-layer-stack span:nth-child(1) {
    --layer-index: 0;
  }

  .xp-layer-stack span:nth-child(2) {
    --layer-index: 1;
  }

  .xp-layer-stack span:nth-child(3) {
    --layer-index: 2;
  }

  .xp-layer-stack span:nth-child(4) {
    --layer-index: 3;
  }

  .xp-layer-stack span:nth-child(5) {
    --layer-index: 4;
  }

  .xp-principle-grid,
  .xp-surface-grid,
  .xp-foundation-grid,
  .xp-definition-grid,
  .xp-motion-grid {
    display: grid;
    gap: var(--xp-space-4);
    margin-top: var(--xp-space-6);
  }

  .xp-card,
  .xp-definition,
  .xp-motion-card,
  .xp-surface-swatch {
    min-width: 0;
    border: 1px solid var(--xp-border-muted);
    border-radius: var(--xp-radius-md);
    background: var(--xp-surface-2);
    padding: var(--xp-space-5);
    box-shadow: var(--xp-shadow-sm);
  }

  .xp-card-active {
    background: var(--xp-surface-3);
    border-color: var(--xp-border-strong);
  }

  .xp-surface-swatch {
    min-height: 16rem;
  }

  .xp-surface-step,
  .xp-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    border: 1px solid var(--xp-border-muted);
    border-radius: 999px;
    padding-inline: 0.65rem;
    color: var(--xp-text-secondary);
    font-size: var(--xp-type-caption);
    font-weight: 600;
  }

  .xp-foundation-grid article {
    border-top: 1px solid var(--xp-border-muted);
    padding-top: var(--xp-space-4);
  }

  .xp-type-list {
    display: grid;
    gap: var(--xp-space-5);
    margin-top: var(--xp-space-6);
  }

  .xp-type-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.22fr) minmax(0, 1fr);
    gap: var(--xp-space-5);
    align-items: start;
    border-top: 1px solid var(--xp-border-muted);
    padding-top: var(--xp-space-5);
  }

  .xp-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xp-space-3);
    align-items: center;
  }

  .xp-text-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: var(--xp-radius-md);
    padding-inline: var(--xp-space-2);
    font-weight: 700;
  }

  .xp-badge-secondary {
    border-color: rgb(79 179 255 / 0.34);
    color: var(--xp-accent-secondary);
  }

  .xp-badge-muted {
    color: var(--xp-text-muted);
  }

  .xp-icon-samples {
    display: grid;
    grid-template-columns: repeat(4, 3.5rem);
    gap: var(--xp-space-3);
    align-content: start;
  }

  .xp-icon-samples i,
  .xp-card-icon {
    color: var(--xp-accent-primary);
  }

  .xp-icon-samples span {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid var(--xp-border-muted);
    border-radius: var(--xp-radius-md);
    background: var(--xp-surface-2);
    box-shadow: var(--xp-shadow-sm);
  }

  .xp-icon-samples i {
    font-size: 1.5rem;
  }

  .xp-motion-card {
    position: relative;
    overflow: hidden;
  }

  .xp-motion-card span {
    display: block;
    width: 4rem;
    height: 0.25rem;
    margin-bottom: var(--xp-space-4);
    border-radius: 999px;
    background: var(--xp-accent-primary);
    transition: transform var(--xp-motion-base) var(--xp-ease-standard);
  }

  .xp-motion-card:hover span {
    transform: translateX(1.25rem);
  }

  .xp-page-composition {
    margin-top: var(--xp-space-6);
    border: 1px solid rgb(17 24 39 / 0.14);
    border-radius: var(--xp-radius-lg);
    background: var(--xp-surface-0);
    padding: var(--xp-space-4);
    box-shadow: 0 24px 64px rgb(17 24 39 / 0.16);
  }

  .xp-mini-section {
    border: 1px solid var(--xp-border-muted);
    border-radius: var(--xp-radius-md);
    background: var(--xp-surface-1);
    padding: var(--xp-space-5);
  }

  .xp-mini-card-grid {
    display: grid;
    gap: var(--xp-space-4);
    margin-top: var(--xp-space-5);
  }

  .xp-mini-light-callout {
    margin-top: var(--xp-space-4);
    border: 1px solid rgb(17 24 39 / 0.12);
    border-radius: var(--xp-radius-md);
    background: var(--xp-surface-light-raised);
    padding: var(--xp-space-5);
    color: var(--xp-text-on-light);
    box-shadow: 0 18px 42px rgb(17 24 39 / 0.12);
  }

  .xp-mini-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--xp-space-4);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--xp-space-4);
