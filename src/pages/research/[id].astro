---
import {getCollection, type CollectionEntry} from 'astro:content';
import Aside from '../../components/legacy/Aside.astro';
import ExternalLinkButton from '../../components/legacy/ExternalLinkButton.astro';
import LegacyLayout from '../../layouts/LegacyLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('research')).map((paper) => ({params: {id: paper.id}, props: {paper}}));
}

const {paper} = Astro.props as {paper: CollectionEntry<'research'>};
const {data} = paper;
const aside = [{type: 'resource' as const, items: [{name: 'Academic Research', link: '/research/', icon: 'fas fa-arrow-right'}]}];
---

<LegacyLayout title={data.title} summary={data.abstract ?? undefined} keywords={data.tags} hasAside>
  <Aside items={aside} />
  <div class="uno-section">
    <article class="uno-flex uno-flex-col uno-gap-6">
      <div>
        <h1 class="uno-text-4xl uno-font-bold uno-mb-4 uno-text-action-text uno-mt-0">{data.title}</h1>
        <div class="uno-text-lg uno-mb-6"><p><strong>Abstract:</strong> {data.abstract}</p></div>
      </div>
      <div class="uno-text-lg uno-leading-8"><strong>Authors:</strong> {data.authors.join(', ')}</div>
      <div class="uno-text-lg uno-leading-8"><strong>Year:</strong> {data.year}</div>
      <div class="uno-text-lg uno-flex uno-flex-wrap uno-gap-2 uno-items-center">
        <strong>Tags:</strong>
        {data.tags.map((tag) => <span class="uno-px-2 uno-py-1 uno-rounded-lg uno-bg-brand uno-text-secondary">{tag}</span>)}
      </div>
      {data.url && <ExternalLinkButton href={data.url}>Read the Full Paper</ExternalLinkButton>}
    </article>
  </div>
</LegacyLayout>
