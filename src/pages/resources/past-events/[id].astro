---
import {getCollection, render, type CollectionEntry} from 'astro:content';
import LegacyLayout from '../../../layouts/LegacyLayout.astro';

export async function getStaticPaths() {
  const events = await getCollection('pastEvents');
  return events.map((event) => ({params: {id: event.id}, props: {event}}));
}

type Props = {event: CollectionEntry<'pastEvents'>};
const {event} = Astro.props;
const {Content} = await render(event);
---

<LegacyLayout title={event.data.title} description={event.data.description} keywords={event.data.keywords}>
  <article class="article page-single">
    <div class="container page-top"><h1>{event.data.title}</h1><div class="description">{event.data.description}</div></div>
    <div class="single-content"><Content /></div>
  </article>
</LegacyLayout>

