---
import DownloadLists from '../../components/legacy/DownloadLists.astro';
import DownloadSearch from '../../components/legacy/DownloadSearch.astro';
import Section from '../../components/legacy/Section.astro';
import {latestDownloads} from '../../data/downloads';
import LegacyLayout from '../../layouts/LegacyLayout.astro';

const title = 'Downloads';
const description = 'Find all the relevant resources to download on this page.';
const keywords = ['Xen Project', 'downloads', 'virtualization software', 'installation files', 'software packages', 'hypervisor tools', 'open-source resources'];
---

<LegacyLayout title={title} description={description} keywords={keywords}>
  <article class="article page-single">
    <div class="container page-top"><h1>{title}</h1><div class="description">{description}</div></div>
    <div class="single-content">
      <Section>
        <DownloadSearch />
        <div class="mg-t-xl"><DownloadLists groups={latestDownloads} /></div>
      </Section>
    </div>
  </article>
</LegacyLayout>

