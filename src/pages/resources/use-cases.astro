const infrastructureContexts = [
  {
    icon: 'i-carbon-ibm-cloud-vpc',
    title: 'Multi-tenant infrastructure',
    description: 'Keep tenant, service, and operator responsibilities visible on shared estates.',
  },
  {
    icon: 'i-carbon-data-center',
    title: 'Private and public cloud',
    description: 'Choose a foundation teams can inspect, govern, and sustain in the open.',
  },
  {
    icon: 'i-carbon-server-dns',
