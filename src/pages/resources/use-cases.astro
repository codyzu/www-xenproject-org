---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-solution-cloud-infrastructure">
  <Hero
    id="hero"
    eyebrow="Solution Area"
    title="Open virtualization for cloud and infrastructure platforms."
    description="Open infrastructure starts with an open virtualization layer. Xen gives operators an inspectable hypervisor for guest isolation, hardware ownership, control domains, and long-term platform sustainability."
    actions={[
      {label: 'Explore the hypervisor', href: '/projects/hypervisor/'},
      {label: 'Explore XCP-ng', href: '/projects/xcp-ng/', variant: 'secondary'},
    ]}
    layout="balanced"
  >
    <PlatformLayersDiagram slot="media" {...cloudInfrastructurePlatformLayersDiagram} />
  </Hero>

  <Section id="infrastructure-virtualization">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Infrastructure ownership</Text>
          <Heading size="heading-xl">Modern infrastructure still depends on a well-defined virtualization layer.</Heading>
          <Text>
            Public clouds, private clouds, hosting providers, edge sites, enterprise estates, and research clusters all need a place where hardware, guests, tenants, and operators can be reasoned about separately.
          </Text>
        </Stack>
        <Grid columns="2" gap="5">
          {infrastructureContexts.map(context => (
            <Card>
              <Stack gap="4">
                <span class:list={[context.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{context.title}</Heading>
                  <Text size="caption">{context.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="dedicated-hypervisor" surface="1" spacing="technical">
    <Container>
      <Stack gap="6">
        <Split align="start">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Why a dedicated hypervisor?</Text>
            <Heading size="heading-xl">A focused layer for isolation, ownership, and platform control.</Heading>
          </Stack>
          <Text>
            Xen gives operators a hypervisor layer for guest isolation, hardware ownership, and platform control without treating one guest operating system as the whole platform.
          </Text>
        </Split>
        <Grid columns="3" gap="5">
          {hypervisorReasons.map(reason => (
            <Card>
              <Stack gap="3">
                <Heading as="h3" size="heading-m">{reason.title}</Heading>
                <Text size="caption">{reason.description}</Text>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="technical-capabilities"
    eyebrow="Technical capabilities"
    title="Capabilities for owning the platform boundary"
    description="Evaluate Xen and surrounding tooling for hardware ownership, guest lifecycle, and operational control."
    columns="3"
    features={capabilities}
  />

  <Section id="where-xen-fits" surface="1">
    <Container>
      <Split>
        <Stack gap="3">
          <Text size="eyebrow" tone="muted">Where Xen fits</Text>
          <Heading size="heading-xl">A virtualization foundation for operators and platform builders.</Heading>
          <Text>
            Xen fits where teams need to keep guests, infrastructure hardware, and management responsibilities under a visible platform model.
          </Text>
        </Stack>
        <Grid columns="2" gap="4">
          {deploymentModels.map(model => (
            <Surface tone="2" border="muted" radius="md" shadow="sm" padding="md">
              <Text size="caption" tone="primary" class="uno-font-semibold">{model}</Text>
            </Surface>
          ))}
        </Grid>
      </Split>
    </Container>
  </Section>

  <Section id="open-infrastructure-ecosystem" spacing="related">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Open Xen infrastructure ecosystem</Text>
          <Heading size="heading-xl">A Xen-centered ecosystem for infrastructure platforms.</Heading>
          <Text>
            Xen is the open foundation. XAPI is the Xen Project toolstack and management layer for Xen-based platforms. XCP-ng packages Xen and XAPI into a complete open platform, while commercial offerings and services can build on the same foundation.
          </Text>
        </Stack>
        <Split align="start" breakpoint="xl" class="xp-cloud-ecosystem-layout">
          <PlatformLayersDiagram
            id="open-infrastructure-ecosystem-diagram"
            {...cloudInfrastructureEcosystemLayersDiagram}
          />
          <Grid columns="2" gap="4">
            {ecosystemRoles.map(role => (
              <Card active={role.title === 'Xen Hypervisor'}>
                <Stack gap="3">
                  <span class:list={[role.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                  <Stack gap="3">
                    <span class="xp-role-group">{role.group}</span>
                    <Heading as="h3" size="heading-m">{role.title}</Heading>
                    <Text size="small">{role.description}</Text>
                  </Stack>
                  <Button href={role.href} variant="text" class="uno-self-start">
                    {role.linkLabel}
                  </Button>
                </Stack>
              </Card>
            ))}
          </Grid>
        </Split>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="why-architects-choose-xen"
    eyebrow="Why architects choose Xen"
    title="Evaluation starts with ownership, openness, and maintainability."
    description="Infrastructure teams need a project model they can inspect, sustain, and build around."
    surface="1"
    columns="3"
    features={architectReasons}
  />

  <FeatureGrid
    id="project-health"
    eyebrow="Open governance and project health"
    title="A project process infrastructure teams can inspect."
    description="Governance, security handling, CI resources, releases, and contribution paths are public evaluation inputs."
    columns="4"
    features={projectHealth}
  />

  <FeatureGrid
    id="resources"
    eyebrow="Related resources"
    title="Follow the evaluation path from architecture to participation."
    description="Use these project, technology, documentation, and membership entry points to continue evaluating Xen."
    surface="1"
    columns="3"
    spacing="related"
    features={resources}
  />

  <Section id="next-step-open-infrastructure">
    <Container>
      <Split align="center">
        <Stack gap="4">
          <Text size="eyebrow" tone="muted">Next step</Text>
          <Heading size="heading-xl">Evaluate the boundary, then choose the platform path.</Heading>
          <Text>
            Start with Xen architecture, review XCP-ng for a complete platform path, or join the public project work.
          </Text>
          <Cluster>
            <Button href="/projects/hypervisor/">Explore the hypervisor</Button>
            <Button href="/projects/xcp-ng/" variant="secondary">Explore XCP-ng</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Stack gap="4">
            <Callout
              title="Built in the open"
              description="Xen is open source, free to use, governed in public, and sustained by a member-funded ecosystem."
              action={{label: 'Read governance', href: '/about/governance/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-branch"></span>
            </Callout>
            <Callout
              title="Contribute to the infrastructure foundation"
              description="Engineers and organizations can evaluate, contribute to, and support the project through public paths."
              action={{label: 'Start contributing', href: '/contribute/get-started/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-code"></span>
            </Callout>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <CTA
    id="final-cta"
    eyebrow="Infrastructure ownership"
    title="Build infrastructure on a virtualization boundary you can inspect."
    description="Use architecture resources, XCP-ng, documentation, contribution paths, and membership to evaluate and support the open foundation."
    actions={[
      {label: 'Explore architecture', href: '/technology/architecture/'},
      {label: 'Explore XCP-ng', href: '/projects/xcp-ng/', variant: 'secondary'},
      {label: 'Start contributing', href: '/contribute/get-started/', variant: 'text'},
      {label: 'Become a member', href: '/about/become-a-member/', variant: 'text'},
    ]}
    align="center"
  />
</BaseLayout>

<style>
  :global(.xp-cloud-ecosystem-layout) {
    align-items: stretch;
  }

  @media (min-width: 80rem) {
    :global(.xp-solution-cloud-infrastructure .xp-cloud-ecosystem-layout) {
      grid-template-columns: minmax(0, 1fr) minmax(36rem, 0.9fr);
    }
  }

  .xp-role-group {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    color: var(--xp-text-muted);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

</style>
