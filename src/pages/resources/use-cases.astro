    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-api',
    title: 'XAPI',
    group: 'Xen Project toolstack',
    description: 'A management layer and toolstack for Xen-based platforms.',
    href: '/projects/xapi/',
    linkLabel: 'Explore XAPI',
  },
  {
    icon: 'i-carbon-cube',
    title: 'XCP-ng',
    group: 'Complete platform',
