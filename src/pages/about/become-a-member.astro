---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import LogoCloud from '../../components/blocks/LogoCloud.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import CookieBanner from '../../components/pages/membership/CookieBanner.astro';
import {memberLogos} from '../../data/member-logos';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Become a member';
const description = 'Explore Xen Project organizational membership, including Premier Plus participation in the Xen Safety Committee, and continue to Linux Foundation enrollment.';
const keywords = ['Xen Project membership', 'Premier Plus', 'Xen Safety Committee', 'Linux Foundation', 'Advisory Board', 'functional safety'];
const linuxFoundationEnrollmentUrl = 'https://enrollment.lfx.linuxfoundation.org/?project=xen';

const membershipBenefits = [
  {
    icon: 'i-carbon-infrastructure-classic',
    title: 'Sustain shared infrastructure',
    description: 'Support project operations, hosting, test environments, and shared resources.',
  },
  {
    icon: 'i-carbon-collaborate',
    title: 'Coordinate across organizations',
    description: 'Give organizational stakeholders a forum for funding, events, communications, and ecosystem coordination.',
  },
  {
    icon: 'i-carbon-license',
    title: 'Support project stewardship',
    description: 'Help steward budgets, trademarks, and project-wide programs.',
  },
  {
    icon: 'i-carbon-network-4',
    title: 'Strengthen an open ecosystem',
    description: 'Maintain a neutral home for infrastructure, embedded, automotive, and security-sensitive work.',
  },
];

const membershipOptions = [
  {
    name: 'Premier Member',
    description: 'Provides sustained support for Xen Project operations, shared infrastructure, events, communications, and community programs.',
  },
  {
    name: 'Advisory Board Governing Member',
    description: 'Provides a voting representative on the Xen Project Advisory Board and participation in the project’s non-technical governance and stewardship.',
  },
  {
    name: 'Startup Member',
    description: 'For organizations with fewer than 100 employees, subject to approval under the current membership requirements.',
  },
  {
    name: 'Associate Member',
    description: 'For eligible, pre-approved Linux Foundation associate organizations, including qualifying government or academic institutions.',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-membership-page">
  <Hero
    id="hero"
    eyebrow="Organizational membership"
    title="Support the shared foundation behind Xen."
    statement="Support the shared infrastructure, stewardship, and collaboration that keep Xen strong across industries."
    description="Membership sustains shared project needs. Technical authority remains earned through open contribution."
    actions={[
      {label: 'Continue to the LF membership form', href: linuxFoundationEnrollmentUrl, rel: 'external'},
      {label: 'View current members', href: '/about/project-members/', variant: 'secondary'},
    ]}
  >
    <Surface slot="media" tone="2" border="strong" padding="lg" radius="lg" shadow="md" class="uno-w-full">
      <Stack gap="5">
        <Text size="eyebrow" tone="accent-primary">How support flows</Text>
        <ol class="uno-m-0 uno-flex uno-list-none uno-flex-col uno-gap-3 uno-p-0">
          <li class="uno-grid uno-grid-cols-[2.25rem_minmax(0,1fr)] uno-items-start uno-gap-3">
            <span class="uno-flex uno-h-9 uno-w-9 uno-items-center uno-justify-center uno-rounded-full uno-bg-xp-accent-primary-soft uno-font-mono uno-text-sm uno-font-bold uno-text-xp-accent-primary-strong" aria-hidden="true">01</span>
            <div>
              <Text as="span" tone="primary" class="uno-font-semibold">Members sustain shared project needs</Text>
              <Text size="caption" class="uno-mt-1">Membership supports shared infrastructure and project operations.</Text>
            </div>
          </li>
          <li class="uno-grid uno-grid-cols-[2.25rem_minmax(0,1fr)] uno-items-start uno-gap-3">
            <span class="uno-flex uno-h-9 uno-w-9 uno-items-center uno-justify-center uno-rounded-full uno-bg-xp-accent-primary-soft uno-font-mono uno-text-sm uno-font-bold uno-text-xp-accent-primary-strong" aria-hidden="true">02</span>
            <div>
              <Text as="span" tone="primary" class="uno-font-semibold">The Advisory Board coordinates stewardship</Text>
              <Text size="caption" class="uno-mt-1">It coordinates non-technical project stewardship.</Text>
            </div>
          </li>
          <li class="uno-grid uno-grid-cols-[2.25rem_minmax(0,1fr)] uno-items-start uno-gap-3">
            <span class="uno-flex uno-h-9 uno-w-9 uno-items-center uno-justify-center uno-rounded-full uno-bg-xp-accent-primary-soft uno-font-mono uno-text-sm uno-font-bold uno-text-xp-accent-primary-strong" aria-hidden="true">03</span>
            <div>
              <Text as="span" tone="primary" class="uno-font-semibold">Maintainers govern technical decisions</Text>
              <Text size="caption" class="uno-mt-1">Responsibility is earned through open contribution.</Text>
            </div>
          </li>
        </ol>
      </Stack>
    </Surface>
  </Hero>

  <FeatureGrid
    id="why-join"
    eyebrow="Why organizations join"
    title="Support the work that keeps an open project healthy."
    description="Organizational membership supports the shared responsibilities around Xen."
    columns="4"
    features={membershipBenefits}
  />

  <Section id="membership-and-contribution" surface="1">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Clear responsibilities</Text>
            <Heading size="heading-xl">Membership and technical contribution are distinct.</Heading>
            <Text>
              The Advisory Board manages non-technical matters including shared infrastructure funding, events, communications, and the Xen Project trademark. Technical decisions remain with maintainers through the open project meritocracy.
            </Text>
          </Stack>
          <Cluster>
            <Button href="/about/governance/">Read project governance</Button>
            <Button href="/contribute/get-started/" variant="text">Start contributing</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" padding="lg" radius="lg" shadow="md">
          <Stack gap="4">
            <Text size="eyebrow" tone="accent-primary">Two participation paths</Text>
            <div class="uno-grid uno-gap-3">
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text as="span" tone="primary" class="uno-font-semibold">Organizational support</Text>
                <Text size="caption" class="uno-mt-2">Stewardship, funding, and coordination.</Text>
              </Surface>
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text as="span" tone="primary" class="uno-font-semibold">Technical contribution</Text>
                <Text size="caption" class="uno-mt-2">Open review and merit-based responsibility.</Text>
              </Surface>
            </div>
            <Callout
              title="Membership does not purchase technical authority"
              headingLevel="h3"
            >
              <span slot="icon" class="i-carbon-branch"></span>
            </Callout>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <Section id="membership-options">
    <Container size="wide">
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Membership options</Text>
          <Heading size="heading-xl">Find the appropriate organizational path.</Heading>
          <Text>
            Review the available membership paths below. Pricing and enrollment are managed by the Linux Foundation.
          </Text>
        </Stack>
        <Surface
          as="article"
          data-featured-membership
          tone="2"
          border="strong"
          padding="lg"
          radius="lg"
          shadow="md"
          class="uno-relative uno-overflow-hidden"
        >
          <Stack gap="4" class="uno-max-w-5xl">
            <Text size="eyebrow" tone="accent-primary">Premier Plus membership</Text>
            <Heading as="h3" size="heading-l">Support Xen’s safety-oriented work at the highest membership level.</Heading>
            <Text>
              Premier Plus is designed for organizations building safety-critical and mixed-criticality systems. It includes direct participation in the Xen Safety Committee, voting representation on both the Advisory Board and the Safety Committee, access to committee-managed safety artifacts, and a voice in priorities and roadmap.
            </Text>
            <Text>
              Members can use shared requirements, architecture material, tests, DFMEA work, tooling, and process documentation in their own assessment, certification, and audit activities, and may share them with qualified safety assessors.
            </Text>
          </Stack>
        </Surface>
        <div class="uno-grid uno-min-w-0 uno-grid-cols-1 uno-items-stretch uno-gap-5 md:uno-grid-cols-2 xl:uno-grid-cols-4">
          {membershipOptions.map(option => (
            <Card data-standard-membership-option class="uno-h-full">
              <Stack gap="3">
                <Heading as="h3" size="heading-m">{option.name}</Heading>
                <Text size="caption">{option.description}</Text>
              </Stack>
            </Card>
          ))}
        </div>
        <Cluster class="uno-pt-2">
          <Button href={linuxFoundationEnrollmentUrl} rel="external">Continue to the LF membership form</Button>
          <Button href="/about/project-members/" variant="text">View current members</Button>
        </Cluster>
      </Stack>
    </Container>
  </Section>

  <LogoCloud
    id="member-trust"
    eyebrow="Current members"
    title="Supported across infrastructure, silicon, automotive, aerospace, and software."
    description="Xen Project members provide stewardship, funding, and long-term support for the project."
    surface="1"
    logos={memberLogos}
    action={{label: 'View all Xen Project members', href: '/about/project-members/'}}
  />

  <Section id="safety-participation">
    <Container>
      <Stack gap="4" class="uno-max-w-xp-content">
        <Text size="eyebrow" tone="muted">Safety-oriented work</Text>
        <Heading size="heading-xl">Support collaboration where evidence matters.</Heading>
        <Text>
          Premier Plus supports shared safety-oriented engineering and committee-managed artifacts. System certification remains the responsibility of each organization.
        </Text>
        <Button href="/technology/safety/" variant="text" class="uno-self-start">Review safety-oriented work</Button>
      </Stack>
    </Container>
  </Section>

  <CTA
    id="final-cta"
    eyebrow="Next step"
    title="Ready to discuss Xen Project membership?"
    description="Continue to the Linux Foundation enrollment process, or contact the membership team to discuss Premier Plus and Xen Safety Committee participation."
    note="XenProject.org does not host or manage the form. The Linux Foundation handles validation, submission, membership workflow, and confirmation."
    actions={[
      {label: 'Continue to the LF membership form', href: linuxFoundationEnrollmentUrl, rel: 'external'},
      {label: 'Email the membership team', href: 'mailto:membership@linuxfoundation.org', variant: 'secondary'},
    ]}
  />

  <CookieBanner />
</BaseLayout>
