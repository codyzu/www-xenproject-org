---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import LogoCloud from '../../components/blocks/LogoCloud.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Grid from '../../components/primitives/Grid.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import CookieBanner from '../../components/pages/membership/CookieBanner.astro';
import {memberLogos} from '../../data/member-logos';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Become a member';
const description = 'Explore organizational membership in the Xen Project, understand what member support enables, and continue to the Linux Foundation-managed enrollment process.';
const keywords = ['Xen Project membership', 'Linux Foundation', 'Advisory Board', 'open source virtualization', 'project support'];
const linuxFoundationEnrollmentUrl = 'https://enrollment.lfx.linuxfoundation.org/?project=xen';

const membershipBenefits = [
  {
    icon: 'i-carbon-infrastructure-classic',
    title: 'Sustain shared infrastructure',
    description: 'Membership dues support project operations, hosting, test environments, and other shared resources.',
  },
  {
    icon: 'i-carbon-collaborate',
    title: 'Coordinate across organizations',
    description: 'The Advisory Board gives organizational stakeholders a forum for project funding, events, communications, and ecosystem coordination.',
  },
  {
    icon: 'i-carbon-license',
    title: 'Support project stewardship',
    description: 'Members help oversee non-technical responsibilities such as budgets, trademarks, and project-wide programs.',
  },
  {
    icon: 'i-carbon-network-4',
    title: 'Strengthen an open ecosystem',
    description: 'Member support helps maintain a neutral project environment for infrastructure, embedded, automotive, and security-sensitive work.',
  },
];

const membershipOptions = [
  {
    name: 'Premier Member',
    description: 'A current option listed by the Xen Project membership program. The Linux Foundation confirms current terms through the enrollment process.',
  },
  {
    name: 'Advisory Board Governing Member',
    description: 'For organizations participating in the Advisory Board’s non-technical governance and project stewardship responsibilities.',
  },
  {
    name: 'Startup Member',
    description: 'For organizations with fewer than 100 employees, subject to approval under the current membership requirements.',
  },
  {
    name: 'Associate Member',
    description: 'For eligible, pre-approved Linux Foundation associate organizations, including qualifying government or academic institutions.',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-membership-page">
  <Hero
    id="hero"
    eyebrow="Organizational membership"
    title="Support the shared foundation behind Xen."
    statement="Membership sustains project stewardship and coordination. Technical authority continues to be earned through open contribution."
    description="Understand how your organization can support the Xen Project, then continue to the Linux Foundation-managed membership process."
    actions={[
      {label: 'Continue to the LF membership form', href: linuxFoundationEnrollmentUrl, rel: 'external'},
      {label: 'View current members', href: '/about/project-members/', variant: 'secondary'},
    ]}
  >
    <Surface slot="media" tone="2" border="strong" padding="lg" radius="lg" shadow="md" class="uno-w-full">
      <Stack gap="5">
        <Text size="eyebrow" tone="accent-primary">How support flows</Text>
        <ol class="uno-m-0 uno-flex uno-list-none uno-flex-col uno-gap-3 uno-p-0">
          <li class="uno-grid uno-grid-cols-[2.25rem_minmax(0,1fr)] uno-items-start uno-gap-3">
            <span class="uno-flex uno-h-9 uno-w-9 uno-items-center uno-justify-center uno-rounded-full uno-bg-xp-accent-primary-soft uno-font-mono uno-text-sm uno-font-bold uno-text-xp-accent-primary-strong" aria-hidden="true">01</span>
            <div>
              <Text as="span" tone="primary" class="uno-font-semibold">Organizations provide sustained support</Text>
              <Text size="caption" class="uno-mt-1">Membership funds and coordinates shared project needs.</Text>
            </div>
          </li>
          <li class="uno-grid uno-grid-cols-[2.25rem_minmax(0,1fr)] uno-items-start uno-gap-3">
            <span class="uno-flex uno-h-9 uno-w-9 uno-items-center uno-justify-center uno-rounded-full uno-bg-xp-accent-primary-soft uno-font-mono uno-text-sm uno-font-bold uno-text-xp-accent-primary-strong" aria-hidden="true">02</span>
            <div>
              <Text as="span" tone="primary" class="uno-font-semibold">The Advisory Board stewards non-technical work</Text>
              <Text size="caption" class="uno-mt-1">Budgets, infrastructure, events, and trademarks remain visible responsibilities.</Text>
            </div>
          </li>
          <li class="uno-grid uno-grid-cols-[2.25rem_minmax(0,1fr)] uno-items-start uno-gap-3">
            <span class="uno-flex uno-h-9 uno-w-9 uno-items-center uno-justify-center uno-rounded-full uno-bg-xp-accent-primary-soft uno-font-mono uno-text-sm uno-font-bold uno-text-xp-accent-primary-strong" aria-hidden="true">03</span>
            <div>
              <Text as="span" tone="primary" class="uno-font-semibold">Technical decisions stay with the open project</Text>
              <Text size="caption" class="uno-mt-1">Maintainers and committers review code through the project’s meritocratic process.</Text>
            </div>
          </li>
        </ol>
      </Stack>
    </Surface>
  </Hero>

  <FeatureGrid
    id="why-join"
    eyebrow="Why organizations join"
    title="Support the work that keeps an open project healthy."
    description="Membership is an organizational participation path for the shared responsibilities around Xen. It complements—not replaces—technical contribution."
    columns="4"
    features={membershipBenefits}
  />

  <Section id="membership-and-contribution" surface="1">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Clear responsibilities</Text>
            <Heading size="heading-xl">Membership and technical contribution are distinct.</Heading>
            <Text>
              The Xen Project Advisory Board manages non-technical matters including funding for shared infrastructure, marketing and events, and the Xen Project trademark. Technical decisions remain with the open source meritocracy and the maintainers responsible for each project area.
            </Text>
          </Stack>
          <Cluster>
            <Button href="/about/governance/">Read project governance</Button>
            <Button href="/contribute/get-started/" variant="text">Start contributing</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" padding="lg" radius="lg" shadow="md">
          <Stack gap="4">
            <Text size="eyebrow" tone="accent-primary">Two participation paths</Text>
            <div class="uno-grid uno-gap-3">
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text as="span" tone="primary" class="uno-font-semibold">Organizational support</Text>
                <Text size="caption" class="uno-mt-2">Membership, project stewardship, funding, and coordination.</Text>
              </Surface>
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text as="span" tone="primary" class="uno-font-semibold">Technical contribution</Text>
                <Text size="caption" class="uno-mt-2">Open review, demonstrated contribution, and merit-based responsibility.</Text>
              </Surface>
            </div>
            <Callout
              title="Membership does not purchase technical authority"
              description="Organizations and engineers can contribute without becoming members, and membership does not bypass the project’s public technical process."
              headingLevel="h3"
            >
              <span slot="icon" class="i-carbon-branch"></span>
            </Callout>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <Section id="membership-options">
    <Container size="wide">
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Membership options</Text>
          <Heading size="heading-xl">Find the appropriate organizational path.</Heading>
          <Text>
            The current program lists the options below. Pricing and final eligibility are not maintained on this page; the Linux Foundation enrollment process provides the current details.
          </Text>
        </Stack>
        <Grid columns="4" gap="5">
          {membershipOptions.map(option => (
            <Card>
              <Stack gap="3">
                <Heading as="h3" size="heading-m">{option.name}</Heading>
                <Text size="caption">{option.description}</Text>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <LogoCloud
    id="member-trust"
    eyebrow="Current members"
    title="Supported across infrastructure, silicon, automotive, aerospace, and software."
    description="These organizations provide a current trust signal for sustained, cross-industry participation. The full member page keeps the canonical organization listing."
    surface="1"
    logos={memberLogos}
  />

  <Section id="safety-participation">
    <Container>
      <Split align="center">
        <Stack gap="4">
          <Text size="eyebrow" tone="muted">Safety-oriented work</Text>
          <Heading size="heading-xl">Support collaboration where evidence matters.</Heading>
          <Text>
            Xen Project participants collaborate on engineering practices, documentation, tooling, and supporting artifacts for safety-conscious and certification-oriented systems. Membership can help sustain that shared work, while technical participation follows the project’s open processes.
          </Text>
          <Button href="/technology/safety/" variant="text" class="uno-self-start">Review safety-oriented work</Button>
        </Stack>
        <Callout
          title="Certification depends on the complete system"
          description="Xen source code is not itself safety certified. Certification depends on integration context, process, evidence, tooling, validation, and the complete system safety case."
          variant="warning"
          headingLevel="h3"
        >
          <span slot="icon" class="i-carbon-warning-alt"></span>
        </Callout>
      </Split>
    </Container>
  </Section>

  <Section id="linux-foundation-handoff" surface="1">
    <Container>
      <Split align="center">
        <Stack gap="4">
          <Text size="eyebrow" tone="accent-primary">Linux Foundation handoff</Text>
          <Heading size="heading-xl">Continue with the organization that manages enrollment.</Heading>
          <Text>
            The next step leaves XenProject.org and opens the Linux Foundation’s LFX enrollment service. The Linux Foundation manages the form, validation, submission, membership workflow, and confirmation experience.
          </Text>
        </Stack>
        <Surface tone="2" border="strong" padding="lg" radius="lg" shadow="md">
          <Stack gap="4">
            <Text as="span" tone="primary" class="uno-font-semibold">What happens next</Text>
            <Text size="caption">Use the LFX form to begin the Xen Project membership process. The existing project parameter is preserved in the destination URL.</Text>
            <Button href={linuxFoundationEnrollmentUrl} rel="external">Continue to the LF membership form</Button>
            <Text size="caption">Need project context before continuing? Email <a href="mailto:community.manager@xenproject.org">community.manager@xenproject.org</a>.</Text>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <CTA
    id="final-cta"
    eyebrow="Next step"
    title="Ready to discuss organizational membership?"
    description="Continue to the Linux Foundation-managed form or contact the Xen Project team if you need help choosing the appropriate path."
    actions={[
      {label: 'Continue to the LF membership form', href: linuxFoundationEnrollmentUrl, rel: 'external'},
      {label: 'Email the project team', href: 'mailto:community.manager@xenproject.org', variant: 'secondary'},
    ]}
  />

  <CookieBanner />
</BaseLayout>
