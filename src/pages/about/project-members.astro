---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import LogoCloud from '../../components/blocks/LogoCloud.astro';
import Button from '../../components/primitives/Button.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import {memberLogos, memberOrganizations} from '../../data/member-logos';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Project members';
const description = 'Meet the current organizations supporting Xen Project infrastructure, stewardship, events, and ecosystem coordination through membership.';
const keywords = ['Xen Project members', 'Advisory Board', 'Linux Foundation', 'open source virtualization', 'member organizations'];

const supportAreas = [
  {
    icon: 'i-carbon-infrastructure-classic',
    title: 'Shared project infrastructure',
    description: 'Membership helps fund hosting, test environments, and operational resources used across the project.',
  },
  {
    icon: 'i-carbon-events',
    title: 'Events and coordination',
    description: 'Members support project events, communications, and collaboration across organizational boundaries.',
  },
  {
    icon: 'i-carbon-license',
    title: 'Trademark stewardship',
    description: 'The Advisory Board manages the Xen Project trademark and related non-technical responsibilities.',
  },
  {
    icon: 'i-carbon-chart-network',
    title: 'Long-term project health',
    description: 'Sustained organizational participation supports shared programs and a neutral, open ecosystem.',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-project-members-page">
  <Hero
    id="hero"
    eyebrow="Project members"
    title="Organizations sustaining the Xen Project."
    statement="Current members sustain the shared infrastructure, stewardship, and coordination around an open technical community."
    description="These organizations span infrastructure, silicon, automotive, aerospace, and software."
    actions={[
      {label: 'Explore membership', href: '/about/become-a-member/'},
      {label: 'Read project governance', href: '/about/governance/', variant: 'secondary'},
    ]}
  >
    <Surface slot="media" tone="2" border="strong" padding="lg" radius="lg" shadow="md" class="uno-w-full">
      <Stack gap="5">
        <Text size="eyebrow" tone="accent-primary">Shared project support</Text>
        <div class="uno-flex uno-items-end uno-gap-3">
          <span class="uno-font-mono uno-text-5xl uno-font-bold uno-leading-none uno-text-xp-text-primary">{memberOrganizations.length}</span>
          <Text as="span" size="caption" class="uno-pb-1">member organizations.</Text>
        </div>
        <div class="uno-border-0 uno-border-t uno-border-solid uno-border-xp-border-muted uno-pt-4">
          <Text tone="primary" class="uno-font-semibold">One open source virtualization project.</Text>
        </div>
      </Stack>
    </Surface>
  </Hero>

  <LogoCloud
    id="current-members"
    eyebrow="Current members"
    title="Current Xen Project members"
    description="Organizations providing sustained support for the project."
    logos={memberLogos}
  />

  <FeatureGrid
    id="what-support-enables"
    eyebrow="What support enables"
    title="Member support keeps shared responsibilities visible and funded."
    surface="1"
    columns="4"
    features={supportAreas}
  />

  <Section id="governance-boundary">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Open governance</Text>
            <Heading size="heading-xl">Member support and technical contribution are distinct.</Heading>
            <Text>
              The Advisory Board manages funding, events, communications, and trademark responsibilities. Technical decisions remain with the project’s open source meritocracy, where responsibility is earned through public contribution and peer review.
            </Text>
          </Stack>
          <Button href="/about/governance/" variant="text" class="uno-self-start">Read the governance model</Button>
        </Stack>
        <Callout
          title="Membership supports the project; it does not buy code authority"
          description="Organizations do not need to be members to contribute technically, and membership does not override maintainer review or public project processes."
          headingLevel="h3"
        >
          <span slot="icon" class="i-carbon-collaborate"></span>
        </Callout>
      </Split>
    </Container>
  </Section>

  <CTA
    id="final-cta"
    eyebrow="Organizational participation"
    title="Add your organization to the project’s support network."
    description="Review what membership enables and continue to the Linux Foundation-managed enrollment process when your organization is ready."
    actions={[
      {label: 'Explore Xen Project membership', href: '/about/become-a-member/'},
      {label: 'Read project governance', href: '/about/governance/', variant: 'secondary'},
    ]}
  />
</BaseLayout>
