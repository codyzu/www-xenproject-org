---
import Card from '../components/Card.astro';
import LatestNewsShell from '../components/LatestNewsShell.astro';
import MediaBlock from '../components/MediaBlock.astro';
import LogoWheel from '../components/react/LogoWheel';
import Story from '../components/react/Story';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Xen Project';
const description = 'The Xen Project develops enterprise-grade open source virtualization solutions trusted by millions of users. Secure, flexible, and powerful hypervisor technology.';
const keywords = ['Xen Project', 'open source virtualization', 'enterprise-grade hypervisor', 'secure virtualization', 'flexible hypervisor', 'virtualization solutions', 'Linux Foundation', 'community', 'innovation', 'technology'];
const features = [
  ['Open-source', 'fas fa-code', 'A wide variety of vendors and individuals opens new opportunities and provides many places to find support.'],
  ['Reliable', 'fas fa-thumbs-up', 'Over 10 million people use Xen within an ecosystem of more than 2,000 commercially certified partners.'],
  ['Flexible', 'fas fa-cogs', 'The architecture supports products and services for servers, cloud, desktop, embedded, and security-first environments.'],
  ['Support', 'fas fa-headset', 'The hypervisor supports multiple guest operating systems and cloud platforms.'],
  ['Secure', 'fas fa-shield-alt', 'A minimal attack surface with features such as KCONFIG and Virtual Machine Introspection.'],
  ['Modular', 'fas fa-puzzle-piece', 'Scalable, robust architecture suitable for large, critical, and highly secure environments.'],
];
const projects = [
  ['Hypervisor', '/projects/hypervisor/'], ['Embedded & Automotive', '/projects/embedded-and-automotive/'],
  ['HVMI', '/projects/hvmi/'], ['Mirage OS', '/projects/mirage-os/'], ['Unikraft', '/projects/unikraft/'],
  ['Windows PV Drivers', '/projects/windows-pv-drivers/'], ['XAPI', '/projects/xapi/'], ['XCP-ng', '/projects/xcp-ng/'],
];
---

<BaseLayout title={title} description={description} keywords={keywords} flushMain overlayHeader>
  <div id="xen-story" class="uno-w-full uno-bg-black"><Story client:load /></div>
  <article class="article">
    <Section class="home-section-hero home-hero-animated">
      <MediaBlock class="hero-block" mediaPosition="right">
        <div class="media-block__label">A Linux Foundation Project</div>
        <h1 class="media-block__title title-with-gradient-underline">Bring the power of <strong>open virtualization</strong> everywhere.</h1>
        <p>The Xen Project team is a global open source community that develops the Xen Project Hypervisor and its associated subprojects.</p>
        <p>Our mission is to advance virtualization technology across a wide range of commercial and open-source domains.</p>
        <div class="animated-home-screen-container" slot="media">
          <img src="/img/flatline/screen-with-xen-logo.webp" class="animated-home-screen" alt="Computer monitor displaying charts and the Xen Project logo" />
          <img class="animated-home-shadow-screen" src="/img/decorative/screen-with-wire.svg" alt="" />
        </div>
      </MediaBlock>
      <img class="animated-home-server" src="/img/decorative/home-servers.webp" alt="" />
    </Section>

    <Section class="section-square-rounded no-mt">
      <ul class="features-list">
        {features.map(([featureTitle, icon, featureDescription]) => (
          <li class="feature-item"><div class="feature-content"><h2 class="feature-item__title"><i class:list={['feature-item__icon', icon]}></i> {featureTitle}</h2><p>{featureDescription}</p></div></li>
        ))}
      </ul>
    </Section>

    <Section>
      <div class="section-row cols-3">
        <div class="col"><h2>A virtualization <strong>revolution</strong></h2><p>The Xen Project provides a versatile hypervisor for the evolving needs of diverse industries.</p></div>
        <div class="col presentation-list"><ul><li><strong>Empower Innovation:</strong> Tailored virtualization across domains.</li><li><strong>Enhance Cloud Ecosystems:</strong> Reliable, high-performing virtualization.</li><li><strong>Secure Critical Systems:</strong> Industry-leading isolation.</li><li><strong>Revolutionize Embedded Technologies:</strong> Mature automotive and embedded support.</li></ul></div>
      </div>
    </Section>

    <Section container="full">
      <div class="row row-from-list" style="--cols: 4">
        {projects.map(([projectTitle, link]) => <Card title={projectTitle} class="card--bg"><a href={link} class="btn btn-tertiary">Explore <i class="fas fa-arrow-right"></i></a></Card>)}
      </div>
      <p class="mob-mg-v-xl mg-v-xxl txt-c"><a class="btn btn-primary" href="/projects/">Discover all projects <i class="fas fa-arrow-right"></i></a></p>
    </Section>

    <Section container="full"><LatestNewsShell /></Section>

    <Section class="section-square-primary">
      <MediaBlock title="Governed by Xen project <strong>members</strong>" mobileMediaPosition="top" animate>
        <p>Board members can propose and vote upon changes to the Xen Project and gain valuable strategic insight into project plans.</p>
        <p class="mg-t-md"><a href="/about/become-a-member/" class="btn btn-secondary">Join the advisory board <i class="fas fa-arrow-right"></i></a></p>
        <div id="logo-wheel" class="uno-w-full" slot="media"><LogoWheel client:visible /></div>
      </MediaBlock>
      <MediaBlock title="Led by a <strong>dedicated community</strong>" media="/img/flatline/team-work.svg" alt="Illustration symbolizing teamwork." mediaPosition="right" mobileMediaPosition="bottom" class="block-space" animate>
        <p>The Xen community is a collaborative ecosystem of developers, researchers, and enthusiasts advancing open-source virtualization.</p>
        <p class="mg-t-md"><a href="/contribute/get-started/" class="btn btn-primary">Get started <i class="fas fa-arrow-right"></i></a></p>
      </MediaBlock>
    </Section>

    <Section>
      <MediaBlock title="About <strong>Xen Project</strong>" media="/img/flatline/data-process.svg" alt="Illustration representing data integration." mobileMediaPosition="bottom" animate>
        <p>The mission of the Xen Project is to advance virtualization technology across commercial and open-source domains.</p>
        <p><a href="/about/" class="btn btn-secondary">Learn about Xen Project <i class="fas fa-arrow-right"></i></a></p>
      </MediaBlock>
    </Section>
  </article>
  <style is:global>
    @media (prefers-reduced-motion: reduce) {
      #xen-story *, #xen-story *::before, #xen-story *::after {
        animation-duration: 1ms !important;
        transition-duration: 1ms !important;
      }
    }
  </style>
</BaseLayout>
