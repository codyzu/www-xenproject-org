---
import {Picture} from 'astro:assets';
import CTA from '../components/blocks/CTA.astro';
import Callout from '../components/blocks/Callout.astro';
import CommandExample from '../components/blocks/CommandExample.astro';
import FeatureGrid from '../components/blocks/FeatureGrid.astro';
import Hero from '../components/blocks/Hero.astro';
import LogoCloud from '../components/blocks/LogoCloud.astro';
import Stats from '../components/blocks/Stats.astro';
import VideoClip from '../components/blocks/VideoClip.astro';
import Badge from '../components/primitives/Badge.astro';
import Button from '../components/primitives/Button.astro';
import Card from '../components/primitives/Card.astro';
import Cluster from '../components/primitives/Cluster.astro';
import Container from '../components/primitives/Container.astro';
import Grid from '../components/primitives/Grid.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Split from '../components/primitives/Split.astro';
import Stack from '../components/primitives/Stack.astro';
import Surface from '../components/primitives/Surface.astro';
import Text from '../components/primitives/Text.astro';
import HeroLayeredPlatformArtwork from '../components/pages/home/HeroLayeredPlatformArtwork.astro';
import pandaSrc from '../assets/illustrations/xen-panda-driving-forward.png';
import {readGhostCache, type NormalizedGhostPost} from '../../scripts/search/ghost.ts';
import {
  compactGhostExcerpt,
  formatGhostPublicationDate,
  homepageNewsBadge,
  selectHomepageNews,
} from '../data/homepage-news';
import {memberLogos} from '../data/member-logos';
import {projects} from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Xen Project';
const description = 'The Xen Project develops an open source hypervisor for infrastructure, embedded, security-sensitive, and virtualization platforms that need clear separation and long-term control.';
const keywords = ['Xen Project', 'open source virtualization', 'enterprise-grade hypervisor', 'secure virtualization', 'flexible hypervisor', 'virtualization solutions', 'Linux Foundation', 'community', 'technology'];

const proofPoints = [
  {
    value: 'Governance',
    label: 'Open project model',
    description: 'Project roles, governance, and decision processes are available for review.',
    sourceHref: '/about/governance/',
    sourceLabel: 'Governance',
  },
  {
    value: 'Security',
    label: 'Published response process',
    description: 'Security reporting and response expectations are documented for users and vendors.',
    sourceHref: '/about/security-policy/',
    sourceLabel: 'Security policy',
  },
  {
    value: 'CI',
    label: 'Public testing resources',
    description: 'CI resources and status information are available for contributors and evaluators.',
    sourceHref: '/contribute/ci/',
    sourceLabel: 'CI resources',
  },
];

const relevanceFeatures = [
  {
    icon: 'i-carbon-layers',
    title: 'Isolation as a foundation',
    description: 'Xen is built around a hypervisor layer that separates guest systems from the underlying platform.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Open engineering model',
    description: 'Governance and contribution paths are visible to organizations and individual engineers.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-security',
    title: 'Security-sensitive platforms',
    description: 'Security policy, vulnerability reporting, and related project work are part of the evaluation path.',
    href: '/about/security-policy/',
    linkLabel: 'Review security policy',
  },
];

const excellenceFeatures = [
  {
    icon: 'i-carbon-ibm-cloud-vpc',
    title: 'Cloud and infrastructure',
    description: 'Xen projects include the hypervisor and toolstack work used to build virtualization platforms.',
    href: '/projects/all-projects/',
    linkLabel: 'View projects',
  },
  {
    icon: 'i-carbon-car',
    title: 'Embedded and automotive',
    description: 'The Embedded & Automotive project describes Xen for systems that need isolation, real-time support, and fault tolerance.',
    href: '/projects/embedded-and-automotive/',
    linkLabel: 'Explore embedded work',
  },
  {
    icon: 'i-carbon-view',
    title: 'Introspection and security tooling',
    description: 'HVMI focuses on real-time monitoring and protection for virtualized environments.',
    href: '/projects/hvmi/',
    linkLabel: 'Explore HVMI',
  },
  {
    icon: 'i-carbon-code',
    title: 'Specialized operating systems',
    description: 'MirageOS and Unikraft show how Xen ecosystem projects support focused, lightweight systems work.',
    href: '/projects/all-projects/',
    linkLabel: 'See ecosystem projects',
  },
];

const featuredProjects = projects.filter(project => ['Hypervisor', 'Embedded & Automotive', 'HVMI', 'XAPI', 'XCP-ng', 'Mirage OS'].includes(project.title));
const projectLinkLabels: Record<string, string> = {
  Hypervisor: 'Explore the hypervisor',
  'Embedded & Automotive': 'Explore Embedded & Automotive',
  HVMI: 'Explore HVMI',
  XAPI: 'Explore XAPI',
  'XCP-ng': 'Explore XCP-ng',
  'Mirage OS': 'Explore Mirage OS',
};
const projectFeatures = featuredProjects.map(project => ({
  icon: project.title === 'Embedded & Automotive' ? 'i-carbon-car' : 'i-carbon-cube',
  title: project.title,
  description: project.description,
  href: project.route,
  linkLabel: projectLinkLabels[project.title] ?? `Explore ${project.title}`,
}));

const tryXenWorkflow = `sudo apt install xen-system-amd64
# Reboot into Xen and prepare /etc/xen/guest.cfg
sudo xl create /etc/xen/guest.cfg
sudo xl list`;

let latestPosts: NormalizedGhostPost[] = [];
try {
  const ghostCache = await readGhostCache();
  latestPosts = selectHomepageNews(ghostCache?.posts ?? []);
  if (!ghostCache) console.warn('Ghost cache is unavailable; omitting the homepage latest-news section.');
} catch (error) {
  console.warn(
    `Unable to read cached Ghost posts; omitting the homepage latest-news section. ${error instanceof Error ? error.message : ''}`.trim(),
  );
}
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-home">
  <Hero
    id="hero"
    eyebrow="A Linux Foundation Project"
    title="Open source virtualization for systems that demand isolation and control."
    description="Xen is an open source hypervisor for infrastructure, embedded, security-sensitive, and virtualization platforms that need clear separation and long-term control."
    actions={[
      {label: 'Explore the hypervisor', href: '/projects/hypervisor/'},
      {label: 'Explore membership', href: '/about/become-a-member/', variant: 'secondary'},
    ]}
    layout="media-dominant"
  >
    <HeroLayeredPlatformArtwork slot="media" />
  </Hero>

  <Stats
    id="proof"
    eyebrow="Built in the Open"
    title="A project you can evaluate in the open."
    description="Governance, security handling, and testing resources are published so technical teams can inspect how the project works."
    stats={proofPoints}
  />

  <FeatureGrid
    id="why-now"
    eyebrow="Why Xen matters now"
    title="Modern platforms still need a strong virtualization layer."
    description="For technical evaluators, Xen is most relevant where isolation, openness, long-term platform work, and security-sensitive engineering matter."
    features={relevanceFeatures}
  />

  <FeatureGrid
    id="where-xen-excels"
    eyebrow="Where Xen fits"
    title="Built for engineers working close to the platform."
    description="Xen is strongest when teams need to reason carefully about virtual machines, hardware, operating systems, and trust boundaries."
    surface="1"
    columns="4"
    features={excellenceFeatures}
  />

  <Section id="architecture">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Architecture</Text>
            <Heading size="heading-xl">A clear boundary for platform control.</Heading>
            <Text>
              Xen sits between hardware and guest systems. That position gives platform teams a place to make virtualization, isolation, and control decisions without treating the operating system as the whole boundary.
            </Text>
          </Stack>
          <Cluster>
            <Button href="/projects/hypervisor/">Explore the hypervisor</Button>
            <Button href="/resources/use-cases/" variant="text">Explore cloud infrastructure</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Stack gap="4">
            <Callout
              title="A focused virtualization layer"
              description="The hypervisor project page is the best place to start for architecture details, related resources, and project scope."
              action={{label: 'Explore the hypervisor', href: '/projects/hypervisor/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-layers"></span>
            </Callout>
            <Grid columns="2">
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">Guests</Text>
                <Text size="caption" class="uno-mt-2">Virtualized systems stay above the hypervisor boundary.</Text>
              </Surface>
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">Hardware</Text>
                <Text size="caption" class="uno-mt-2">Platform integration stays visible to teams that need control.</Text>
              </Surface>
            </Grid>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <Section id="try-xen" surface="1">
    <Container>
      <CommandExample
        eyebrow="Try Xen"
        title="Start a Xen guest"
        description="Install Xen, start a guest, and verify it is running."
        code={tryXenWorkflow}
        caption="Debian AMD64 example."
        headingLevel="h2"
        showGradientBorder={false}
        class="xp-home-try-xen"
      >
        <Button
          slot="action"
          href="https://wiki.debian.org/Xen"
          variant="secondary"
          target="_blank"
          rel="noreferrer"
        >
          Review the Debian Xen guide
        </Button>
      </CommandExample>
    </Container>
  </Section>

  <FeatureGrid
    id="evidence-in-use"
    class="xp-home-project-grid"
    eyebrow="Project areas"
    title="Explore the Xen project ecosystem."
    description="Key project areas are available through direct links so teams can scan capabilities and go deeper where relevant."
    columns="3"
    features={projectFeatures}
  />

  <Section id="automotive-momentum" surface="1">
    <Container>
      <VideoClip
        eyebrow="Xen in automotive"
        title="A major year for Xen in automotive"
        summary="At Xen Summit 2025, Stefano Stabellini highlighted a period of major automotive momentum for Xen, including new members, safety progress, and deeper collaboration with Automotive Grade Linux."
        youtubeVideoId="J6q67jkG5DQ"
        startSeconds={17}
        endSeconds={74}
        speaker="Stefano Stabellini"
        company="AMD"
        event="Xen Summit 2025"
        talkTitle="Xen in Safety Systems: Hardware Domain and Control Domain separation"
        variant="featured"
      />
    </Container>
  </Section>

  <Section id="safety-initiative">
    <Container>
      <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
        <Split align="center" class="xp-home-safety-initiative">
          <Stack gap="5">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">New safety initiative</Text>
              <Heading size="heading-xl">Open source safety engineering, built together.</Heading>
              <Text>
                The Xen Safety Committee gives Premier Plus members a maintained foundation of requirements, tests, tooling, evidence, and process documentation, giving their own certification-oriented programs a substantial head start.
              </Text>
            </Stack>
            <Cluster>
              <Button href="/technology/safety/">Explore safety engineering</Button>
              <Button href="/about/become-a-member/" variant="secondary">Learn about Premier Plus</Button>
            </Cluster>
          </Stack>
          <Stack gap="3" aria-label="Safety initiative participation model">
            {[
              {
                icon: 'i-carbon-group',
                title: 'Safety Committee',
                description: 'Coordinate certification-oriented engineering.',
              },
              {
                icon: 'i-carbon-document-requirements',
                title: 'Shared foundation',
                description: 'Build on maintained requirements, tests, tooling, evidence, and process documentation.',
              },
              {
                icon: 'i-carbon-enterprise',
                title: 'Premier Plus participation',
                description: 'Help set priorities and give downstream safety programs a head start.',
              },
            ].map(item => (
              <Surface tone="3" border="muted" radius="md" shadow="sm" padding="md">
                <div class="uno-grid uno-grid-cols-[auto_minmax(0,1fr)] uno-items-start uno-gap-3">
                  <span class:list={[item.icon, 'uno-mt-1 uno-text-xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                  <Stack gap="2">
                    <Heading as="h3" size="card">{item.title}</Heading>
                    <Text size="caption">{item.description}</Text>
                  </Stack>
                </div>
              </Surface>
            ))}
          </Stack>
        </Split>
      </Surface>
    </Container>
  </Section>

  <LogoCloud
    id="members"
    eyebrow="Members"
    title="Sustained by organizations with a stake in open virtualization."
    description="Members help sustain shared project infrastructure, events, trademark stewardship, and ecosystem coordination."
    surface="1"
    logos={memberLogos}
  />

  {latestPosts.length > 0 && (
    <Section id="latest">
      <Container>
        <div data-pagefind-ignore>
          <Stack gap="6">
            <div class="xp-home-latest-heading uno-grid uno-items-center uno-gap-5 md:uno-grid-cols-[minmax(0,1fr)_auto]">
              <Stack gap="3" class="uno-max-w-xp-content">
                <Text size="eyebrow" tone="accent-primary">Driving virtualization forward</Text>
                <Heading size="heading-xl">Latest from the Xen Project</Heading>
                <Text>Recent releases, initiatives, events, and technical work from across the project.</Text>
              </Stack>
              <Picture
                class="xp-home-latest-panda uno-w-28 uno-justify-self-start md:uno-w-36 md:uno-justify-self-end lg:uno-w-44"
                src={pandaSrc}
                alt=""
                widths={[208, 288, 352]}
                sizes="(max-width: 767px) 104px, (max-width: 1023px) 144px, 176px"
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
              />
            </div>

            <Grid columns="3" gap="4" class="xp-home-latest-grid">
              {latestPosts.map((post) => {
                const badge = homepageNewsBadge(post);
                return (
                  <Card class="xp-home-latest-card">
                    <Stack gap="4" class="uno-h-full">
                      <div class="uno-h-7" data-news-badge-lane>
                        {badge && (
                          <Badge variant="accent" class="uno-w-fit uno-gap-1.5 uno-bg-[rgb(133_194_65_/_0.07)]">
                            <span class:list={[badge.icon, 'uno-text-sm']} aria-hidden="true"></span>
                            {badge.label}
                          </Badge>
                        )}
                      </div>
                      <Stack gap="3" class="uno-flex-1">
                        <Heading as="h3" size="card">
                          <a class="xen-focus uno-rounded-sm uno-text-inherit uno-no-underline hover:uno-text-xp-accent-primary" href={post.url}>
                            {post.title}
                          </a>
                        </Heading>
                        {post.excerpt && <Text size="small" class="xp-home-latest-excerpt">{compactGhostExcerpt(post.excerpt)}</Text>}
                      </Stack>
                      <div class="uno-flex uno-flex-wrap uno-items-center uno-justify-between uno-gap-3 uno-border-0 uno-border-t uno-border-solid uno-border-xp-border-muted uno-pt-3">
                        <time class="uno-text-[length:var(--xp-type-caption)] uno-text-xp-text-muted" datetime={post.publishedAt}>
                          {formatGhostPublicationDate(post.publishedAt)}
                        </time>
                        <a class="xen-action-text xen-focus uno-inline-flex uno-items-center uno-gap-1 uno-rounded-sm" href={post.url} aria-label={`Read ${post.title}`}>
                          Read article
                          <span class="i-carbon-arrow-right" aria-hidden="true"></span>
                        </a>
                      </div>
                    </Stack>
                  </Card>
                );
              })}
            </Grid>

            <div>
              <Button href="/blog/" variant="text">
                View all news
                <span class="i-carbon-arrow-right uno-ml-1" aria-hidden="true"></span>
              </Button>
            </div>
          </Stack>
        </div>
      </Container>
    </Section>
  )}

  <Section id="community" surface="1">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Open governance and community</Text>
          <Heading size="heading-xl">Technical work happens in the open.</Heading>
          <Text>
            Xen contribution follows documented project processes. Engineers can find a practical starting point, and organizations can support the ecosystem through membership.
          </Text>
        </Stack>
        <Grid columns="2" gap="5">
          <Callout
            title="For engineers"
            description="Start with contribution guidance, development resources, and project-specific entry points."
            action={{label: 'Start contributing', href: '/contribute/get-started/'}}
          >
            <span slot="icon" class="i-carbon-code"></span>
          </Callout>
          <Callout
            title="For organizations"
            description="Membership is a way to support the project infrastructure and coordination that keep Xen healthy."
            action={{label: 'Explore membership', href: '/about/become-a-member/'}}
          >
            <span slot="icon" class="i-carbon-enterprise"></span>
          </Callout>
        </Grid>
      </Stack>
    </Container>
  </Section>

  <CTA
    id="next-step"
    eyebrow="Next step"
    title="Support Xen's future, or help build it."
    description="Organizations can support the project through membership. Engineers can start with the contributor resources."
    actions={[
      {label: 'Explore membership', href: '/about/become-a-member/'},
      {label: 'Start contributing', href: '/contribute/get-started/', variant: 'secondary'},
    ]}
    align="center"
  />
</BaseLayout>

<style>
  :global(.xp-home-project-grid article) {
    padding: var(--xp-space-4);
  }

  :global(.xp-home-project-grid article > div) {
    gap: var(--xp-space-3);
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    :global(.xp-home-project-grid .uno-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  :global(.xp-home-safety-initiative > :first-child) {
    max-width: var(--xp-container-content);
  }

  .xp-home-latest-panda {
    height: auto;
  }

  :global(.xp-home-latest-card) {
    min-width: 0;
  }

  .xp-home-latest-excerpt {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    :global(.xp-home-latest-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.999rem) {
    .xp-home-latest-heading {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .xp-home-latest-panda {
      width: 6.5rem;
      align-self: end;
    }

    .xp-home-latest-excerpt {
      -webkit-line-clamp: 4;
    }
  }

  @media (min-width: 64rem) and (max-width: 79.999rem) {
    :global(.xp-home #hero [data-hero-layout="media-dominant"]) {
      grid-template-columns: minmax(25rem, 26.5rem) minmax(0, 1fr);
      align-items: center;
      gap: var(--xp-space-6);
    }
  }
</style>
