---
import CTA from '../components/blocks/CTA.astro';
import Callout from '../components/blocks/Callout.astro';
import FeatureGrid from '../components/blocks/FeatureGrid.astro';
import Hero from '../components/blocks/Hero.astro';
import LogoCloud from '../components/blocks/LogoCloud.astro';
import Stats from '../components/blocks/Stats.astro';
import Button from '../components/primitives/Button.astro';
import Cluster from '../components/primitives/Cluster.astro';
import Container from '../components/primitives/Container.astro';
import Grid from '../components/primitives/Grid.astro';
import Heading from '../components/primitives/Heading.astro';
import Section from '../components/primitives/Section.astro';
import Split from '../components/primitives/Split.astro';
import Stack from '../components/primitives/Stack.astro';
import Surface from '../components/primitives/Surface.astro';
import Text from '../components/primitives/Text.astro';
import HeroLayeredPlatformArtwork from '../components/pages/home/HeroLayeredPlatformArtwork.astro';
import {memberLogos} from '../data/member-logos';
import {projects} from '../data/projects';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Xen Project';
const description = 'The Xen Project develops enterprise-grade open source virtualization solutions trusted by millions of users. Secure, flexible, and powerful hypervisor technology.';
const keywords = ['Xen Project', 'open source virtualization', 'enterprise-grade hypervisor', 'secure virtualization', 'flexible hypervisor', 'virtualization solutions', 'Linux Foundation', 'community', 'technology'];

const proofPoints = [
  {
    value: 'Governance',
    label: 'Open project model',
    description: 'Project roles, governance, and decision processes are available for review.',
    sourceHref: '/about/governance/',
    sourceLabel: 'Governance',
  },
  {
    value: 'Security',
    label: 'Published response process',
    description: 'Security reporting and response expectations are documented for users and vendors.',
    sourceHref: '/about/security-policy/',
    sourceLabel: 'Security policy',
  },
  {
    value: 'CI',
    label: 'Public testing resources',
    description: 'CI resources and status information are available for contributors and evaluators.',
    sourceHref: '/contribute/ci/',
    sourceLabel: 'CI resources',
  },
];

const relevanceFeatures = [
  {
    icon: 'i-carbon-layers',
    title: 'Isolation as a foundation',
    description: 'Xen is built around a hypervisor layer that separates guest systems from the underlying platform.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Open engineering model',
    description: 'Governance and contribution paths are visible to organizations and individual engineers.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-security',
    title: 'Security-sensitive platforms',
    description: 'Security policy, vulnerability reporting, and related project work are part of the evaluation path.',
    href: '/about/security-policy/',
    linkLabel: 'Review security policy',
  },
];

const excellenceFeatures = [
  {
    icon: 'i-carbon-ibm-cloud-vpc',
    title: 'Cloud and infrastructure',
    description: 'Xen projects include the hypervisor and toolstack work used to build virtualization platforms.',
    href: '/projects/all-projects/',
    linkLabel: 'View projects',
  },
  {
    icon: 'i-carbon-car',
    title: 'Embedded and automotive',
    description: 'The Embedded & Automotive project describes Xen for systems that need isolation, real-time support, and fault tolerance.',
    href: '/projects/embedded-and-automotive/',
    linkLabel: 'Explore embedded work',
  },
  {
    icon: 'i-carbon-view',
    title: 'Introspection and security tooling',
    description: 'HVMI focuses on real-time monitoring and protection for virtualized environments.',
    href: '/projects/hvmi/',
    linkLabel: 'Explore HVMI',
  },
  {
    icon: 'i-carbon-code',
    title: 'Specialized operating systems',
    description: 'MirageOS and Unikraft show how Xen ecosystem projects support focused, lightweight systems work.',
    href: '/projects/all-projects/',
    linkLabel: 'See ecosystem projects',
  },
];

const featuredProjects = projects.filter(project => ['Hypervisor', 'Embedded & Automotive', 'HVMI', 'XAPI', 'XCP-ng', 'Mirage OS'].includes(project.title));
const projectFeatures = featuredProjects.map(project => ({
  icon: project.title === 'Embedded & Automotive' ? 'i-carbon-car' : 'i-carbon-cube',
  title: project.title,
  description: project.description,
  href: project.route,
  linkLabel: 'Open project',
}));
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-home">
  <Hero
    eyebrow="A Linux Foundation Project"
    title="Open source virtualization for systems that demand isolation and control."
    description="Xen is a hypervisor and open source project for teams building infrastructure, embedded platforms, security-sensitive systems, and virtualization products that need a clear layer of separation."
    actions={[
      {label: 'Explore Xen', href: '/projects/hypervisor/'},
      {label: 'Explore membership', href: '/about/become-a-member/', variant: 'secondary'},
    ]}
    layout="media-dominant"
  >
    <HeroLayeredPlatformArtwork slot="media" />
  </Hero>

  <Stats
    id="proof"
    eyebrow="Built in the Open"
    title="A project you can evaluate in the open."
    description="Governance, security handling, and testing resources are published so technical teams can inspect how the project works."
    stats={proofPoints}
  />

  <FeatureGrid
    id="why-now"
    eyebrow="Why Xen matters now"
    title="Modern platforms still need a strong virtualization layer."
    description="For technical evaluators, Xen is most relevant where isolation, openness, long-term platform work, and security-sensitive engineering matter."
    features={relevanceFeatures}
  />

  <FeatureGrid
    id="where-xen-excels"
    eyebrow="Where Xen excels"
    title="Built for engineers working close to the platform."
    description="Xen is strongest when teams need to reason carefully about virtual machines, hardware, operating systems, and trust boundaries."
    surface="1"
    columns="4"
    features={excellenceFeatures}
  />

  <Section id="architecture">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Architecture</Text>
            <Heading size="heading-xl">A clear boundary for platform control.</Heading>
            <Text>
              Xen sits between hardware and guest systems. That position gives platform teams a place to make virtualization, isolation, and control decisions without treating the operating system as the whole boundary.
            </Text>
          </Stack>
          <Cluster>
            <Button href="/projects/hypervisor/">Explore the hypervisor</Button>
            <Button href="/resources/use-cases/" variant="text">Read use cases</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Stack gap="4">
            <Callout
              title="A focused virtualization layer"
              description="The hypervisor project page is the best place to start for architecture details, related resources, and project scope."
              action={{label: 'Hypervisor details', href: '/projects/hypervisor/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-layers"></span>
            </Callout>
            <Grid columns="2">
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">Guests</Text>
                <Text size="caption" class="uno-mt-2">Virtualized systems stay above the hypervisor boundary.</Text>
              </Surface>
              <Surface tone="3" border="muted" padding="md" radius="md" shadow="sm">
                <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">Hardware</Text>
                <Text size="caption" class="uno-mt-2">Platform integration stays visible to teams that need control.</Text>
              </Surface>
            </Grid>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <FeatureGrid
    id="evidence-in-use"
    eyebrow="Project areas"
    title="Explore the Xen project ecosystem."
    description="Key project areas are available through direct links so teams can scan capabilities and go deeper where relevant."
    columns="3"
    features={projectFeatures}
  />

  <LogoCloud
    id="members"
    eyebrow="Members"
    title="Sustained by organizations with a stake in open virtualization."
    description="Members help sustain shared project infrastructure, events, trademark stewardship, and ecosystem coordination."
    surface="light"
    logos={memberLogos}
  />

  <Section id="community" surface="1">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Open governance and community</Text>
          <Heading size="heading-xl">Technical work happens in the open.</Heading>
          <Text>
            Xen contribution follows documented project processes. Engineers can find a practical starting point, and organizations can support the ecosystem through membership.
          </Text>
        </Stack>
        <Grid columns="2" gap="5">
          <Callout
            title="For engineers"
            description="Start with contribution guidance, development resources, and project-specific entry points."
            action={{label: 'Start contributing', href: '/contribute/get-started/'}}
          >
            <span slot="icon" class="i-carbon-code"></span>
          </Callout>
          <Callout
            title="For organizations"
            description="Membership is a way to support the project infrastructure and coordination that keep Xen healthy."
            action={{label: 'Explore membership', href: '/about/become-a-member/'}}
          >
            <span slot="icon" class="i-carbon-enterprise"></span>
          </Callout>
        </Grid>
      </Stack>
    </Container>
  </Section>

  <CTA
    id="next-step"
    eyebrow="Next step"
    title="Support Xen's future, or help build it."
    description="Organizations can support the project through membership. Engineers can start with the contributor resources."
    actions={[
      {label: 'Explore membership', href: '/about/become-a-member/'},
      {label: 'Start contributing', href: '/contribute/get-started/', variant: 'secondary'},
    ]}
    align="center"
  />
</BaseLayout>
