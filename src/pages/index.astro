---
import LatestNewsShell from '../components/legacy/LatestNewsShell.astro';
import MediaBlock from '../components/legacy/MediaBlock.astro';
import ProjectCarousel from '../components/legacy/ProjectCarousel.astro';
import LogoWheel from '../components/react/LogoWheel';
import Story from '../components/react/Story';
import Section from '../components/legacy/Section.astro';
import LegacyLayout from '../layouts/LegacyLayout.astro';
import {projects} from '../data/projects';

const title = 'Xen Project';
const description = 'The Xen Project develops enterprise-grade open source virtualization solutions trusted by millions of users. Secure, flexible, and powerful hypervisor technology.';
const keywords = ['Xen Project', 'open source virtualization', 'enterprise-grade hypervisor', 'secure virtualization', 'flexible hypervisor', 'virtualization solutions', 'Linux Foundation', 'community', 'innovation', 'technology'];
const features = [
  ['Open-source', 'fas fa-code', 'Wide variety of vendors and individuals opens new opportunities for the hypervisor and provides end-users with numerous places to find support.'],
  ['Reliable', 'fas fa-thumbs-up', 'Over 10 million people use Xen with an ecosystem of more than 2000 commercially certified partners.'],
  ['Flexible', 'fas fa-cogs', 'Architecture enables vendors to create Xen-based products and services for servers, cloud, desktop, embedded, and security-first environments.'],
  ['Support', 'fas fa-headset', 'Hypervisor supports multiple guest operating systems and cloud platforms.'],
  ['Secure', 'fas fa-shield-alt', 'Minimal attack surface with key security features like KCONFIG and Virtual Machine Introspection.'],
  ['Modular', 'fas fa-puzzle-piece', 'Architecture enables a degree of scalability, robustness, and security suitable for large, critical, and extremely secure environments.'],
];
const homepageProjects = projects.filter((project) => project.route !== '/projects/hypervisor/openpgp-keys/');
---

<LegacyLayout title={title} description={description} keywords={keywords} flushMain overlayHeader>
  <div id="xen-story" class="uno-w-full uno-bg-black"><Story client:load /></div>
  <article
    data-story-followup
    class="article"
    style="position: relative; z-index: 1; background: var(--color-surface-secondary); box-shadow: 0 -2px 0 var(--color-surface-secondary);"
  >
    <Section class="home-section-hero home-hero-animated">
      <MediaBlock class="hero-block" mediaPosition="right">
        <div class="media-block__label">A Linux Foundation Project</div>
        <h1 class="media-block__title title-with-gradient-underline">Bring the power of <strong>open virtualization</strong> everywhere.</h1>
        <p>The Xen Project team is a global open source community that develops the Xen Project Hypervisor and its associated subprojects.</p>
        <p>Our mission is to advance virtualization technology across a wide range of commercial and open-source domains.</p>
        <div class="animated-home-screen-container" slot="media">
          <img src="/img/flatline/screen-with-xen-logo.webp" class="animated-home-screen" alt="Illustration of a computer monitor displaying bar charts with Xen Project Logo" />
          <img class="animated-home-shadow-screen" src="/img/decorative/screen-with-wire.svg" alt="" />
        </div>
      </MediaBlock>
      <img class="animated-home-server" src="/img/decorative/home-servers.webp" alt="" />
    </Section>

    <Section class="section-square-rounded no-mt">
      <ul class="features-list">
        {features.map(([featureTitle, icon, featureDescription]) => (
          <li class="feature-item"><div class="feature-content"><h2 class="feature-item__title"><i class:list={['feature-item__icon', icon]}></i> {featureTitle}</h2><p>{featureDescription}</p></div></li>
        ))}
      </ul>
    </Section>

    <Section>
      <div class="section-row cols-3">
        <div class="col"><h2>A virtualization <strong>revolution</strong></h2><p>The Xen Project focuses on revolutionizing virtualization by providing a versatile and powerful hypervisor that addresses the evolving needs of diverse industries :</p></div>
        <div class="col presentation-list"><ul><li><strong>Empower Innovation:</strong> Tailored virtualization to drive progress across various domains.</li><li><strong>Enhance Cloud Ecosystems:</strong> Elevate cloud capabilities with high-performing, reliable virtualization.</li><li><strong>Secure Critical Systems:</strong> Safeguard data and applications through industry-leading security.</li><li><strong>Revolutionize Embedded Technologies:</strong> Transform embedded and automotive sectors with mature, safe, secure solutions.</li></ul></div>
      </div>
    </Section>

    <Section container="full">
      <ProjectCarousel projects={homepageProjects} />
      <p class="mob-mg-v-xl mg-v-xxl txt-c"><a class="btn btn-primary" href="/projects/all-projects/">Discover all projects <i class="fas fa-arrow-right"></i></a></p>
    </Section>

    <Section container="full"><LatestNewsShell /></Section>

    <Section class="section-square-primary">
      <MediaBlock title="Governed by Xen project <strong>members</strong>" mobileMediaPosition="top" animate>
        <p>Board members can propose and vote upon changes to the Xen Project. Members also gain valuable strategic insight into project plans and future scope.</p>
        <p class="mg-t-md"><a href="/about/become-a-member/" class="btn btn-secondary">Join the advisory board <i class="fas fa-arrow-right"></i></a></p>
        <div id="logo-wheel" class="uno-w-full" slot="media"><LogoWheel client:visible /></div>
      </MediaBlock>
      <MediaBlock title="Led by a <strong>dedicated community</strong>" media="/img/flatline/team-work.svg" alt="Illustration symbolizing teamwork." mediaPosition="right" mobileMediaPosition="bottom" class="block-space" animate>
        <p>The Xen community is a dynamic and collaborative ecosystem comprised of developers, researchers, and enthusiasts dedicated to advancing open-source virtualization technology. With diverse backgrounds and expertise, members actively contribute to Xen's evolution, fostering innovation, sharing knowledge, and supporting one another through continuous development efforts.</p>
        <p class="mg-t-md"><a href="/contribute/get-started/" class="btn btn-primary">Get started <i class="fas fa-arrow-right"></i></a></p>
      </MediaBlock>
    </Section>

    <Section>
      <MediaBlock title="About <strong>Xen Project</strong>" media="/img/flatline/data-process.svg" alt="Illustration representing data integration." mobileMediaPosition="bottom" animate>
        <p>The mission of the Xen Project is to advance virtualisation technology across a wide range of commercial and open-source domains.</p>
        <p><a href="/about/" class="btn btn-secondary">Learn about Xen Project <i class="fas fa-arrow-right"></i></a></p>
      </MediaBlock>
    </Section>
  </article>
  <style is:global>
    @media (prefers-reduced-motion: reduce) {
      #xen-story *, #xen-story *::before, #xen-story *::after {
        animation-duration: 1ms !important;
        transition-duration: 1ms !important;
      }
    }
  </style>
</LegacyLayout>
