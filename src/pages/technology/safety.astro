---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import VideoClip from '../../components/blocks/VideoClip.astro';
import PlatformLayersDiagram from '../../components/diagrams/PlatformLayersDiagram.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Grid from '../../components/primitives/Grid.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import {memberOrganizations} from '../../data/member-logos';
import {safetyCriticalPlatformLayersDiagram} from '../../data/safety-critical-platform-layers';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Safety-Critical Systems';
const description = 'Explore how the Xen Safety Committee and Premier Plus membership support certification-oriented engineering with shared requirements, tests, tooling, evidence, and process documentation.';
const keywords = [
  'Xen Project',
  'safety-critical systems',
  'safety-conscious virtualization',
  'Xen Safety Committee',
  'Premier Plus',
  'certification-oriented engineering',
  'mixed-criticality systems',
  'Dom0less',
  'static partitioning',
  'MISRA C',
  'ECLAIR static analysis',
  'BUGSENG',
];

const architectureFactors = [
  {
    icon: 'i-carbon-layers',
    title: 'Architecture boundaries',
    description: 'A hypervisor can give teams an explicit place to reason about isolation, ownership, and platform responsibilities.',
  },
  {
    icon: 'i-carbon-document-requirements',
    title: 'Evidence and traceability',
    description: 'Certification-oriented work depends on reviewable evidence, documented assumptions, and traceable engineering decisions.',
  },
  {
    icon: 'i-carbon-data-structured',
    title: 'Integration context',
    description: 'The safety case belongs to the complete system, including hardware, guests, tooling, validation, and deployment context.',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-term maintenance',
    description: 'Regulated systems need engineering practices that can be sustained across long product and platform lifecycles.',
  },
];

const mixedCriticalityExamples = [
  {
    title: 'Different criticality levels',
    description: 'Control, monitoring, diagnostics, HMI, telemetry, and update services may have different safety, timing, and validation expectations.',
  },
  {
    title: 'Independent validation cadence',
    description: 'Linux services and non-critical workloads may need a different validation and maintenance cadence than safety-conscious functions.',
  },
  {
    title: 'Different assurance needs',
    description: 'The hard problem is keeping ownership, assumptions, dependencies, assurance scope, and validation evidence clear as workloads share compute.',
  },
];

const safetyCapabilities = [
  {
    icon: 'i-carbon-security',
    title: 'Strong isolation boundary',
    description: 'Use Xen as an explicit hypervisor boundary between guest systems and shared hardware responsibilities.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-data-structured',
    title: 'Static partitioning',
    description: 'Make CPU, memory, interrupt, and device ownership deliberate platform design choices.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-chip',
    title: 'CPU assignment',
    description: 'Use CPU pinning and dedicated CPU assignment where the system architecture calls for explicit execution ownership.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-time',
    title: 'Deterministic interrupt latencies',
    description: 'Evaluate interrupt routing, CPU assignment, and device ownership when designing for deterministic interrupt latencies.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-connect',
    title: 'Device ownership',
    description: 'Use device passthrough and platform device assignment when a design needs clear hardware ownership by a guest or service domain.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-boot',
    title: 'Dom0less boot',
    description: 'Start selected guest domains without waiting for a traditional control-domain boot path when that fits the system design.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-settings-adjust',
    title: 'Control-domain choices',
    description: 'Choose how platform control, device setup, and management responsibilities are represented instead of assuming one model.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-minimize',
    title: 'Focused hypervisor boundary',
    description: 'Keep the virtualization and isolation layer focused so teams can reason about the trusted computing base they evaluate.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-roadmap',
    title: 'Long-lived integration',
    description: 'Support platform designs where guests, hardware assumptions, testing, and maintenance evidence evolve over time.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
];

const committeeWork = [
  {
    icon: 'i-carbon-code-reference',
    title: 'Auditable code-base processes',
    description: 'Define safety-oriented processes that support an auditable code base as Xen evolves.',
  },
  {
    icon: 'i-carbon-document',
    title: 'Managed safety artifacts',
    description: 'Create and maintain associated requirements, architecture material, tests, evidence, and process documentation.',
  },
  {
    icon: 'i-carbon-tools',
    title: 'Tooling and validation',
    description: 'Coordinate static analysis, testing, coverage, fault injection, and other certification-oriented engineering inputs.',
  },
  {
    icon: 'i-carbon-roadmap',
    title: 'Sustained alignment',
    description: 'Keep committee processes and artifacts aligned with Xen across long product and platform lifecycles.',
  },
];

const foundingContributorNames = ['AMD', 'EPAM', 'Renesas'] as const;
const foundingContributors = foundingContributorNames.map((name) => {
  const organization = memberOrganizations.find(member => member.name === name);
  if (!organization) throw new Error(`Missing canonical organization data for ${name}`);
  return organization;
});

const toolingCollaborators = [
  {
    name: 'BUGSENG',
    role: 'Engineering collaborator',
    logo: '/img/logos/bugseng-logo.svg',
  },
  {
    name: 'ECLAIR',
    role: 'Static-analysis platform',
    logo: '/img/logos/eclair-logo.svg',
  },
];

const logoBadgeClasses = 'uno-flex uno-min-w-0 uno-items-center uno-justify-center uno-rounded-xp-md uno-border uno-border-solid uno-border-[rgb(17_24_39_/_0.12)] uno-bg-[var(--xp-surface-light-raised)]';
const foundingLogoClasses = `xp-recognition-logo xen-focus ${logoBadgeClasses} uno-px-[1.2rem] uno-py-[0.9rem] uno-transition-[border-color,transform] uno-duration-[var(--xp-motion-base)] uno-ease-[var(--xp-ease-standard)] hover:uno--translate-y-0.5 hover:uno-border-[rgb(133_194_65_/_0.42)]`;
const toolingLogoBadgeClasses = `xp-tooling-logo__mark ${logoBadgeClasses} uno-h-18 uno-px-4 uno-py-[0.8rem]`;

const evidenceTooling = [
  {
    title: 'Process',
    description: 'Safety-conscious work starts with visible engineering practices and reviewable development decisions.',
  },
  {
    title: 'Analysis',
    description: 'Static analysis and coding-rule efforts help turn code quality work into inspectable engineering inputs.',
  },
  {
    title: 'CI',
    description: 'Public testing and continuous integration resources make more of the project process visible to evaluators.',
  },
  {
    title: 'Documentation',
    description: 'Documented assumptions, limitations, and integration responsibilities help teams build their own safety case.',
  },
  {
    title: 'Safety case input',
    description: 'Xen project artifacts can support evaluation, but the product safety case remains system-specific.',
  },
];

const evaluationChecklist = [
  {
    icon: 'i-carbon-diagram',
    title: 'Architecture fit',
    description: 'Where are the guest, control, device, interrupt, and hardware boundaries, and who owns each one?',
  },
  {
    icon: 'i-carbon-checkmark-outline',
    title: 'Process fit',
    description: 'Which project practices, reviews, and maintenance expectations can your organization evaluate and adopt?',
  },
  {
    icon: 'i-carbon-test-tool',
    title: 'Tooling and analysis',
    description: 'Which static analysis, testing, and code-quality signals are relevant to your system and process?',
  },
  {
    icon: 'i-carbon-document-requirements',
    title: 'Evidence needs',
    description: 'What evidence does your safety case require, and which parts must be created by your product team?',
  },
  {
    icon: 'i-carbon-data-reference',
    title: 'Integration responsibilities',
    description: 'How will hardware setup, boot flow, guest configuration, devices, and updates be validated in context?',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-term maintenance',
    description: 'How will security response, releases, CI, and platform updates be handled over the product lifecycle?',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Governance and participation',
    description: 'How will your team inspect, influence, and contribute to the open project process?',
  },
  {
    icon: 'i-carbon-enterprise',
    title: 'Supplier and member collaboration',
    description: 'Which members, suppliers, and internal teams need to coordinate on certification-oriented engineering work?',
  },
];

const projectHealth = [
  {
    icon: 'i-carbon-wikis',
    title: 'Linux Foundation stewardship',
    description: 'Xen is organized as a Linux Foundation project with public governance resources.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-security',
    title: 'Security policy',
    description: 'Security reporting and response expectations are documented for users, vendors, and contributors.',
    href: '/about/security-policy/',
    linkLabel: 'Review security policy',
  },
  {
    icon: 'i-carbon-test-tool',
    title: 'Public CI resources',
    description: 'Continuous integration resources and test infrastructure give evaluators more project process to inspect.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
  {
    icon: 'i-carbon-download',
    title: 'Releases and downloads',
    description: 'Release artifacts and downloads support evaluation, development, and lifecycle planning.',
    href: '/resources/downloads/',
    linkLabel: 'View downloads',
  },
];

const resources = [
  {
    icon: 'i-carbon-layers',
    title: 'Hypervisor',
    description: 'Start with the core Xen hypervisor project.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Architecture',
    description: 'See how Xen fits between hardware, guest domains, and platform control.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-security',
    title: 'Isolation & Security',
    description: 'Review isolation and security resources for Xen-based platforms.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-car',
    title: 'Embedded & Automotive',
    description: 'Review the sibling solution page for mixed-criticality embedded and automotive systems.',
    href: '/projects/embedded-and-automotive/',
    linkLabel: 'Explore Embedded & Automotive',
  },
  {
    icon: 'i-carbon-test-tool',
    title: 'Continuous Integration',
    description: 'Explore public CI resources, hardware testing, and project testing infrastructure.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
  {
    icon: 'i-carbon-download',
    title: 'Downloads',
    description: 'Find Xen releases for evaluation and development.',
    href: '/resources/downloads/',
    linkLabel: 'View downloads',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Governance',
    description: 'Understand the project model, roles, and governance process.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-document-security',
    title: 'Security policy',
    description: 'Review the public security reporting and response policy.',
    href: '/about/security-policy/',
    linkLabel: 'Review security policy',
  },
  {
    icon: 'i-carbon-code-reference',
    title: 'Start contributing',
    description: 'Find public contribution paths for engineers who want to participate in Xen development.',
    href: '/contribute/get-started/',
    linkLabel: 'Start contributing',
  },
  {
    icon: 'i-carbon-enterprise',
    title: 'Become a member',
    description: 'Support shared project infrastructure, coordination, events, and long-term sustainability.',
    href: '/about/become-a-member/',
    linkLabel: 'Explore membership',
  },
  {
    icon: 'i-carbon-document',
    title: 'Documentation and wiki',
    description: 'Use the project wiki for deeper technical documentation.',
    href: 'https://wiki.xenproject.org/',
    linkLabel: 'Open wiki',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-solution-safety-critical">
  <Hero
    id="hero"
    eyebrow="Solution Area"
    title="Open virtualization for safety-conscious systems."
    statement="Certification-oriented systems need inspectable engineering."
    description="Xen keeps isolation boundaries, resource ownership, guest roles, and hardware responsibilities visible while evidence, tooling, and engineering discipline remain explicit evaluation inputs."
    actions={[
      {label: 'Explore safety resources', href: '#resources'},
      {label: 'Become a member', href: '/about/become-a-member/', variant: 'secondary'},
    ]}
    layout="balanced"
  >
    <PlatformLayersDiagram slot="media" {...safetyCriticalPlatformLayersDiagram} />
  </Hero>

  <Section id="architecture-and-evidence">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Architecture and evidence</Text>
          <Heading size="heading-xl">Safety starts with architecture, but it does not end there.</Heading>
          <Text>
            A hypervisor can help create explicit technical boundaries. Certification-oriented engineering also depends on the system safety case, integration evidence, documented process, tooling, validation, and product-specific review.
          </Text>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="sm" padding="lg" class="xp-safety-principle">
          <Text size="lead" tone="primary" class="uno-font-semibold">
            The architecture creates the boundary. The engineering process creates the evidence.
          </Text>
        </Surface>
        <Surface tone="2" border="muted" radius="md" shadow="sm" padding="md" class="xp-safety-certification-note">
          <Text size="caption" tone="primary" class="uno-font-semibold">
            Xen source code is not itself safety certified. Certification depends on the complete system, integration context, process, evidence, tooling, validation, and safety case.
          </Text>
        </Surface>
        <Grid columns="4" gap="5">
          {architectureFactors.map(factor => (
            <Card>
              <Stack gap="4">
                <span class:list={[factor.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{factor.title}</Heading>
                  <Text size="caption">{factor.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="mixed-criticality" surface="1" spacing="technical">
    <Container>
      <Stack gap="6">
        <Split align="start">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Mixed-criticality systems</Text>
            <Heading size="heading-xl">Mixed-criticality is a safety engineering problem, not just a consolidation pattern.</Heading>
          </Stack>
          <Text>
            Safety-conscious platforms often combine workloads with different criticality, timing, update, and validation needs. The design challenge is keeping boundaries, ownership, dependencies, and evidence clear while functions share hardware.
          </Text>
        </Split>
        <Grid columns="3" gap="5">
          {mixedCriticalityExamples.map(example => (
            <Card>
              <Stack gap="3">
                <Heading as="h3" size="heading-m">{example.title}</Heading>
                <Text size="caption">{example.description}</Text>
              </Stack>
            </Card>
          ))}
        </Grid>
        <Surface tone="2" border="muted" radius="lg" shadow="sm" padding="lg">
          <Split align="center" breakpoint="xl" class="xp-safety-workload-mix">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">Example workload mix</Text>
              <Heading as="h3" size="heading-m">Separation needs to remain visible after consolidation.</Heading>
            </Stack>
            <Grid columns="3" gap="4">
              {['Control workload', 'Monitoring', 'Diagnostics', 'HMI', 'OTA/update service', 'Service domains'].map(example => (
                <Surface tone="3" border="muted" radius="md" shadow="sm" padding="md">
                  <Text size="caption" tone="primary" class="uno-font-semibold">{example}</Text>
                </Surface>
              ))}
            </Grid>
          </Split>
        </Surface>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="architecture-capabilities"
    eyebrow="Architecture capabilities"
    title="Capabilities engineers evaluate when building safety-conscious platforms."
    description="Xen capabilities are evaluated in the context of a complete system design, not as standalone certification claims. The mechanisms matter most when paired with shared engineering practice, review, and evidence work."
    columns="3"
    features={safetyCapabilities}
  />

  <Section id="safety-committee" surface="1" spacing="technical">
    <Container>
      <Stack gap="7" class="xp-safety-committee-chapter">
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Split align="start" class="xp-safety-committee-intro">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">Project coordination</Text>
              <Heading size="heading-xl">The Xen Safety Committee coordinates certification-oriented work.</Heading>
            </Stack>
            <Stack gap="3">
              <Text>
                The Xen Safety Committee is a formal project committee that defines processes for an auditable code base, creates and maintains associated safety artifacts, and coordinates certification-oriented engineering work.
              </Text>
              <Text>
                Xen source code, licensing, and established development flows remain open and unchanged. Upstream technical decisions continue through Xen's open contribution, review, and maintainer processes.
              </Text>
            </Stack>
          </Split>
        </Surface>
        <Grid columns="4" gap="5">
          {committeeWork.map(work => (
            <Card>
              <Stack gap="4">
                <span class:list={[work.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{work.title}</Heading>
                  <Text size="caption">{work.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
        <Callout
          title="Premier Plus connects organizations directly to the committee."
          description="Premier Plus members appoint voting representatives to the Xen Project Advisory Board and the Safety Committee, participate directly in committee work, help set priorities and roadmap, and gain access to committee-managed safety artifacts. Members may disclose those artifacts to qualified safety assessors for their own assessment, certification, or audit activities."
          variant="accent"
          class="xp-safety-committee-callout"
          action={{label: 'Explore Premier Plus membership', href: '/about/become-a-member/', variant: 'text'}}
        >
          <span slot="icon" class="i-carbon-group"></span>
        </Callout>
      </Stack>
    </Container>
  </Section>

  <Section id="why-certification-matters" spacing="technical">
    <Container>
      <VideoClip
        eyebrow="Why safety certification matters"
        title="For critical systems, certification is a requirement."
        summary="In automotive, industrial, avionics, and other safety-critical systems, certification is often a prerequisite for adoption. At Xen Summit 2025, Ayan Kumar Halder of AMD explained why this work matters for Xen and the systems built on it."
        youtubeVideoId="dkTOcDkHlqU"
        startSeconds={106}
        endSeconds={159}
        speaker="Ayan Kumar Halder"
        company="AMD"
        event="Xen Summit 2025"
        talkTitle="Xen Functional Safety Certification (an update)"
      />
    </Container>
  </Section>

  <Section id="founding-contributors" spacing="technical">
    <Container>
      <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg" class="xp-recognition-spotlight uno-overflow-hidden">
        <Stack gap="6">
          <Split align="start">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">Founding Contributors</Text>
              <Heading size="heading-xl">Built on years of safety-focused engineering.</Heading>
            </Stack>
            <Text>
              AMD, EPAM, and Renesas contributed the initiative's initial body of safety-focused work across requirements, architecture, DFMEA, testing, tooling, coverage, and process documentation. This shared starting point gives the initiative momentum while leaving room for future contributors to extend the work.
            </Text>
          </Split>
          <div class="xp-founding-logos uno-grid uno-grid-cols-1 uno-gap-[0.85rem] sm:uno-grid-cols-3" aria-label="Founding Contributors">
            {foundingContributors.map(contributor => (
              <a href={contributor.href} aria-label={`Visit ${contributor.name}`} class={foundingLogoClasses}>
                <img src={contributor.logo} alt={contributor.name} class="uno-h-auto uno-w-auto uno-max-h-[2.6rem] uno-max-w-32 uno-object-contain sm:uno-max-w-36" />
              </a>
            ))}
          </div>
        </Stack>
      </Surface>
    </Container>
  </Section>

  <Section id="evidence-tooling">
    <Container>
      <Stack gap="6">
        <Split align="start">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Evidence, tooling, and code quality</Text>
            <Heading size="heading-xl">Safety work is evidence work.</Heading>
          </Stack>
          <Stack gap="4">
            <Text>
              Committee coordination becomes useful when it produces engineering signals teams can inspect. Certification-oriented systems need practices and project artifacts that can be reviewed and connected to a product-specific safety case.
            </Text>
            <Text>
              The initiative complements Xen's role in Automotive Grade Linux, Linux and Zephyr platform composition, and ongoing MISRA C and ECLAIR work with BUGSENG. It is relevant to automotive, industrial, avionics, robotics, embedded, and other long-lived regulated systems.
            </Text>
          </Stack>
        </Split>
        <Surface as="aside" tone="2" border="strong" radius="lg" shadow="sm" padding="md" class="xp-tooling-collaboration" aria-labelledby="tooling-collaboration-title">
          <Split align="center" class="uno-gap-6 md:uno-gap-[4vw] lg:uno-gap-12">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">Safety tooling collaboration</Text>
              <div id="tooling-collaboration-title">
                <Heading as="h3" size="heading-m">Static analysis support from BUGSENG and ECLAIR.</Heading>
              </div>
              <Text size="caption">
                BUGSENG supports the Xen Project's MISRA C and code-quality efforts through access to the ECLAIR static-analysis platform and related engineering expertise. This collaboration helps the project identify, track, and improve code-quality issues as part of a broader certification-oriented engineering process.
              </Text>
            </Stack>
            <div class="xp-tooling-logos uno-grid uno-w-full uno-grid-cols-1 uno-gap-3 sm:uno-max-w-[25rem] sm:uno-grid-cols-2" aria-label="Safety tooling collaborator and platform">
              {toolingCollaborators.map(collaborator => (
                <div class="xp-tooling-logo uno-grid uno-min-w-0 uno-gap-[0.55rem]">
                  <div class={toolingLogoBadgeClasses}>
                    <img src={collaborator.logo} alt={collaborator.name} class="uno-h-auto uno-w-auto uno-max-h-[2.35rem] uno-max-w-[8.5rem] uno-object-contain" />
                  </div>
                  <Text size="caption" tone="muted" class="uno-text-center">{collaborator.role}</Text>
                </div>
              ))}
            </div>
          </Split>
        </Surface>
        <div class="xp-evidence-trail" aria-label="Evidence work flow">
          {evidenceTooling.map((item, index) => (
            <Surface tone="2" border="muted" radius="md" shadow="sm" padding="md" class="xp-evidence-step">
              <div class="xp-evidence-step__index" aria-hidden="true">
                <Text size="caption" tone="accent-primary" class="uno-font-mono uno-font-bold">{String(index + 1).padStart(2, '0')}</Text>
              </div>
              <Stack gap="2" class="xp-evidence-step__content">
                <Heading as="h3" size="card" class="xp-evidence-step__title">{item.title}</Heading>
                <Text size="caption">{item.description}</Text>
              </Stack>
            </Surface>
          ))}
        </div>
        <Callout
          title="Static analysis is one engineering signal."
          description="ECLAIR, MISRA C compliance efforts, CI, testing resources, documentation, and review all support engineering maturity. They should be evaluated as part of the complete system process, not as a standalone safety claim."
          action={{label: 'View CI resources', href: '/contribute/ci/', variant: 'text'}}
        >
          <span slot="icon" class="i-carbon-test-tool"></span>
        </Callout>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="what-teams-evaluate"
    eyebrow="Evaluation checklist"
    title="What teams should evaluate before building on Xen."
    description="After the architecture and evidence signals are clear, teams still need to evaluate process, tooling, integration, maintenance, governance, and collaboration responsibilities."
    surface="1"
    columns="4"
    spacing="related"
    features={evaluationChecklist}
  />

  <FeatureGrid
    id="project-health"
    eyebrow="Open governance and project health"
    title="A project model teams can inspect."
    description="Governance, security handling, CI resources, releases, contribution paths, and member-funded sustainability are part of the evaluation story."
    columns="4"
    features={projectHealth}
  />

