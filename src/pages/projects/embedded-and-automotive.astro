---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Grid from '../../components/primitives/Grid.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import PlatformLayersDiagram from '../../components/diagrams/PlatformLayersDiagram.astro';
import {
  embeddedAutomotiveEcosystemLayersDiagram,
  embeddedAutomotivePlatformLayersDiagram,
} from '../../data/embedded-and-automotive-platform-layers';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Embedded & Automotive';
const description = 'Open source virtualization for embedded and automotive systems that need isolation, mixed workloads, hardware-aware boundaries, and long-term platform control.';
const keywords = [
  'Xen Project',
  'embedded systems',
  'automotive virtualization',
  'software-defined vehicles',
  'mixed-criticality workloads',
  'Dom0less',
  'device passthrough',
  'Arm virtualization',
  'open source hypervisor',
];

const virtualizationChallenges = [
  {
    icon: 'i-carbon-chip',
    title: 'Shared hardware',
    description: 'Run more platform software on fewer boards while keeping ownership and failure domains visible.',
  },
  {
    icon: 'i-carbon-container-services',
    title: 'Mixed workloads',
    description: 'Give Linux, RTOS workloads, service domains, and specialized systems a clearer place to coexist.',
  },
  {
    icon: 'i-carbon-data-base-alt',
    title: 'Explicit boundaries',
    description: 'Keep devices, boot flow, interrupts, and integration responsibilities visible to platform teams.',
  },
  {
    icon: 'i-carbon-time',
    title: 'Maintainable platforms',
    description: 'Support architectures that can evolve across long hardware, software, and product lifecycles.',
  },
];

const mixedCriticalityExamples: {title: string; description: string}[] = [
  {
    title: 'Different operating profiles',
    description: 'Safety-conscious control workloads, RTOS workloads, Linux services, infotainment, telemetry, diagnostics, and OTA services can have different timing, reliability, update, and validation needs.',
  },
  {
    title: 'Shared compute pressure',
    description: 'As platforms consolidate onto fewer processors and boards, workloads that once lived on separate controllers increasingly share memory, devices, interrupts, and boot dependencies.',
  },
  {
    title: 'Separation as an engineering concern',
    description: 'The hard problem is sharing hardware without blurring ownership, validation scope, fault-containment expectations, or lifecycle boundaries between platform responsibilities.',
  },
];

const platformSeparation: {icon: string; title: string; description: string}[] = [
  {
    icon: 'i-carbon-security',
    title: 'Isolation boundaries',
    description: 'Reason about where guest systems are separated and where platform integration must be reviewed explicitly.',
  },
  {
    icon: 'i-carbon-user-multiple',
    title: 'Guest ownership',
    description: 'Keep the responsibilities of Linux guests, RTOS guests, service domains, and hardware-facing components visible.',
  },
  {
    icon: 'i-carbon-chip',
    title: 'Resource assignment',
    description: 'Make CPU, memory, interrupt, and device assignment part of the platform design instead of implicit operating-system behavior.',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Boot and integration',
    description: 'Track startup order, control-domain choices, device setup, and integration responsibilities as first-class architecture decisions.',
  },
  {
    icon: 'i-carbon-settings-adjust',
    title: 'Platform control',
    description: 'Separate hardware-facing platform control from guest application environments where the system design calls for that boundary.',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-term maintainability',
    description: 'Support product lifecycles where guest systems, platform software, and hardware assumptions may need to evolve at different rates.',
  },
];

const technicalCapabilities: {icon: string; title: string; description: string; href?: string; linkLabel?: string}[] = [
  {
    icon: 'i-carbon-chip',
    title: 'CPU pinning',
    description: 'Assign CPU resources deliberately so latency-sensitive guests and platform services have explicit execution ownership.',
    href: '/technology/architecture/',
    linkLabel: 'Read architecture overview',
  },
  {
    icon: 'i-carbon-time',
    title: 'Deterministic interrupt latencies',
    description: 'Design systems where interrupt routing, CPU assignment, and device ownership support deterministic interrupt latencies.',
    href: '/technology/safety/',
    linkLabel: 'Review safety resources',
  },
  {
    icon: 'i-carbon-connect',
    title: 'Device passthrough',
    description: 'Assign selected hardware devices directly to guests when the system design calls for direct device ownership.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation overview',
  },
  {
    icon: 'i-carbon-boot',
    title: 'Dom0less boot',
    description: 'Start selected guest domains without waiting for a traditional control domain boot path where the platform design calls for it.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-data-structured',
    title: 'Static resource partitioning',
    description: 'Make CPU, memory, device, and interrupt ownership part of the platform design instead of implicit runtime behavior.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation overview',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Flexible control domains',
    description: 'Choose a control-domain model that fits the product architecture instead of assuming a single management pattern.',
    href: '/technology/architecture/',
    linkLabel: 'Read architecture overview',
  },
];

const xenFit = [
  {
    icon: 'i-carbon-layers',
    title: 'Thin hypervisor boundary',
    description: 'Xen gives platform teams a focused layer for separation decisions close to the hardware boundary.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-security',
    title: 'Hardware-aware isolation',
    description: 'Guest isolation and hardware-facing platform work stay visible instead of disappearing inside one operating system.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Read isolation overview',
  },
  {
    icon: 'i-carbon-virtual-machine',
    title: 'Flexible guest model',
    description: 'Different operating environments can share a platform while retaining separate roles and responsibilities.',
    href: '/technology/architecture/',
    linkLabel: 'Read architecture overview',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Open engineering model',
    description: 'Governance, contribution paths, security handling, and public testing resources are available for evaluation.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-lived maintainability',
    description: 'An open platform boundary helps teams plan for products that must be inspected, updated, and supported over time.',
    href: '/contribute/ci/',
    linkLabel: 'Review CI resources',
  },
];

const ecosystemRoles = [
  {
    icon: 'i-carbon-layers',
    title: 'Xen',
    description: 'Provides the virtualization and isolation boundary between guest systems and shared hardware.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore Xen hypervisor',
  },
  {
    icon: 'i-carbon-logo-linux',
    title: 'Linux',
    description: 'Runs rich operating-system services, middleware, application environments, and integration tooling.',
    href: '/technology/architecture/',
    linkLabel: 'Read architecture overview',
  },
  {
    icon: 'i-carbon-package',
    title: 'Yocto Project',
    description: 'Helps teams construct embedded Linux distributions and repeatable images for Linux guests.',
  },
  {
    icon: 'i-carbon-memory',
    title: 'Zephyr',
    description: 'Supports RTOS-style embedded workloads that may need a smaller runtime than Linux.',
  },
  {
    icon: 'i-carbon-car',
    title: 'Automotive Grade Linux',
    description: 'Provides an open automotive Linux platform for IVI and software-defined vehicle software stacks.',
  },
  {
    icon: 'i-carbon-chip',
    title: 'Hardware and SoC platform',
    description: 'Supplies the compute, memory, interrupts, devices, and peripherals the platform composes around.',
  },
];

const resources = [
  {
    icon: 'i-carbon-layers',
    title: 'Hypervisor',
    description: 'Start with the core Xen hypervisor project and its architecture-oriented project resources.',
    href: '/projects/hypervisor/',
    linkLabel: 'Open project',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Architecture',
    description: 'A technology entry point for how Xen fits between hardware, guests, and platform control.',
    href: '/technology/architecture/',
    linkLabel: 'Read overview',
  },
  {
    icon: 'i-carbon-security',
    title: 'Isolation & Security',
    description: 'Review the site entry point for isolation and security resources in the redesigned technology area.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review resources',
  },
  {
    icon: 'i-carbon-checkmark-outline',
    title: 'Safety-Critical Systems',
    description: 'A starting point for safety-oriented evaluation resources as they are organized for the redesigned site.',
    href: '/technology/safety/',
    linkLabel: 'Review safety entry point',
  },
  {
    icon: 'i-carbon-test-tool',
    title: 'Continuous Integration',
    description: 'Explore Xen hardware CI, test coverage, and bring-your-own-hardware validation resources.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
  {
    icon: 'i-carbon-download',
    title: 'Downloads',
    description: 'Find Xen releases and download resources for evaluation and development work.',
    href: '/resources/downloads/',
    linkLabel: 'Get downloads',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-solution-embedded-automotive">
  <Hero
    eyebrow="Solution Area"
    title="Open source virtualization for embedded and automotive systems."
    description="Build mixed-criticality platforms that consolidate Linux, RTOS, and specialized workloads onto shared hardware while keeping system boundaries explicit, inspectable, and maintainable throughout long product lifecycles."
    actions={[
      {label: 'Explore Xen architecture', href: '/technology/architecture/'},
      {label: 'Start contributing', href: '/contribute/get-started/', variant: 'secondary'},
    ]}
    layout="balanced"
  >
    <PlatformLayersDiagram slot="media" {...embeddedAutomotivePlatformLayersDiagram} />
  </Hero>

  <Section id="why-virtualization">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Why virtualization matters here</Text>
          <Heading size="heading-xl">Consolidate the platform without blurring the boundaries.</Heading>
          <Text>
            Embedded and automotive teams are asked to combine more software on shared compute while preserving the boundaries that make engineering, validation, and maintenance practical.
          </Text>
        </Stack>
        <Grid columns="2" gap="5" class="uno-max-w-xp-page">
          {virtualizationChallenges.map(challenge => (
            <Card>
              <Stack gap="4">
                <span class:list={[challenge.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{challenge.title}</Heading>
                  <Text size="caption">{challenge.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="mixed-criticality" surface="1">
    <Container>
      <Stack gap="6">
        <Split align="start">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Mixed-criticality systems</Text>
            <Heading size="heading-xl">Why mixed-criticality matters</Heading>
          </Stack>
          <Text>
            Modern embedded and automotive platforms increasingly combine workloads with different safety, timing, reliability, and maintenance requirements on shared compute. The term mixed-criticality is useful because it keeps attention on the engineering boundaries between those workloads, not just the fact that they run on the same hardware.
          </Text>
        </Split>
        <Grid columns="3" gap="5">
          {mixedCriticalityExamples.map(example => (
            <Card>
              <Stack gap="3">
                <Heading as="h3" size="heading-m">{example.title}</Heading>
                <Text size="caption">{example.description}</Text>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="platform-separation">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Design principles</Text>
          <Heading size="heading-xl">Designed for platform separation</Heading>
          <Text>
            Xen gives platform teams a clear boundary between shared hardware and guest systems, making separation decisions visible instead of burying them inside one operating system.
          </Text>
        </Stack>
        <Grid columns="3" gap="5">
          {platformSeparation.map(item => (
            <Card>
              <Stack gap="4">
                <span class:list={[item.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{item.title}</Heading>
                  <Text size="caption">{item.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="technical-capabilities" surface="1">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Technical capabilities</Text>
          <Heading size="heading-xl">Capabilities for mixed-criticality platform design</Heading>
          <Text>
            Once the separation model is clear, platform teams can evaluate the Xen capabilities that make ownership, timing, device access, and boot architecture explicit.
          </Text>
        </Stack>
        <Grid columns="3" gap="5">
          {technicalCapabilities.map(capability => (
            <Card>
              <Stack gap="4">
                <span class:list={[capability.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{capability.title}</Heading>
                  <Text size="caption">{capability.description}</Text>
                </Stack>
                {capability.href && (
                  <Button href={capability.href} variant="text" class="uno-self-start">
                    {capability.linkLabel ?? 'Learn more'}
                  </Button>
                )}
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="embedded-systems">
    <Container>
      <Split>
        <Stack gap="3">
          <Text size="eyebrow" tone="muted">Embedded platform breadth</Text>
          <Heading size="heading-xl">The same separation model applies across embedded domains.</Heading>
          <Text>
            Xen can be evaluated wherever teams need to combine hardware-facing software, guest operating systems, and long-lived platform requirements while keeping ownership, timing, and integration boundaries visible.
          </Text>
        </Stack>
        <Grid columns="2" gap="4">
          {['Industrial systems', 'Robotics', 'Medical and regulated devices', 'Edge appliances', 'Networking equipment', 'Specialized hardware platforms'].map(example => (
            <Surface tone="2" border="muted" radius="md" shadow="sm" padding="md">
              <Text size="caption" tone="primary" class="uno-font-semibold">{example}</Text>
            </Surface>
          ))}
        </Grid>
      </Split>
    </Container>
  </Section>

  <Section id="automotive" surface="1">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Flagship embedded example</Text>
            <Heading size="heading-xl">Software-defined vehicles make the separation challenge concrete.</Heading>
            <Text>
              Automotive platforms are a prominent example of the broader embedded challenge: Linux systems, RTOS workloads, service domains, and hardware-specific functions increasingly share compute. Xen gives platform teams a thin virtualization layer for reasoning about isolation, ownership, and system boundaries without treating one operating system as the whole platform.
            </Text>
          </Stack>
          <Grid columns="2" gap="4">
            <Card>
              <Stack gap="3">
                <span class="i-carbon-car uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
                <Heading as="h3" size="heading-m">ECU consolidation</Heading>
                <Text size="caption">Keep platform boundaries explicit as vehicle functions move from many controllers toward shared compute.</Text>
              </Stack>
            </Card>
            <Card>
              <Stack gap="3">
                <span class="i-carbon-ibm-watsonx-code-assistant-for-z-refactor uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
                <Heading as="h3" size="heading-m">Mixed workloads</Heading>
                <Text size="caption">Evaluate how IVI, service domains, Linux, RTOS workloads, and hardware-facing functions can coexist.</Text>
              </Stack>
            </Card>
          </Grid>
        </Stack>
        <Stack gap="4">
          <Surface as="aside" tone="2" border="strong" radius="lg" shadow="sm" padding="lg">
            <div class="uno-flex uno-min-w-0 uno-flex-col uno-gap-3 sm:uno-flex-row sm:uno-items-start sm:uno-gap-4">
              <span class="i-carbon-document-requirements uno-mt-1 uno-inline-flex uno-shrink-0 uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
              <Stack gap="3" class="uno-min-w-0">
                <Text as="span" size="eyebrow" tone="accent-primary">Evaluation note</Text>
                <Heading as="h3" size="heading-m">Certification work depends on product evidence.</Heading>
                <Text size="caption">
                  Xen is relevant to safety-conscious platform evaluation, but this page does not claim product safety certification. Teams with certification requirements should evaluate code, process, evidence, and integration context for their product.
                </Text>
              </Stack>
            </div>
          </Surface>
          <Surface tone="2" border="muted" radius="lg" shadow="sm" padding="lg">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">Evaluation concerns</Text>
              <div class="uno-flex uno-flex-wrap uno-gap-2">
                {['mixed-criticality workloads', 'supplier coordination', 'long-term maintenance', 'hardware validation', 'certification-aware work'].map(item => (
                  <span class="xp-tag">{item}</span>
                ))}
              </div>
            </Stack>
          </Surface>
        </Stack>
      </Split>
    </Container>
  </Section>

  <FeatureGrid
    id="why-xen-fits"
    eyebrow="Why architects choose Xen"
    title="Evaluation starts with architecture, evidence, and integration context."
    description="After the separation model is clear, teams can evaluate Xen through its hypervisor architecture, isolation resources, guest model, governance, and public engineering process."
    surface="1"
    columns="3"
    features={xenFit}
  />

  <Section id="open-platform-ecosystem">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Open platform ecosystem</Text>
          <Heading size="heading-xl">Building complete embedded platforms</Heading>
          <Text>
            Embedded and automotive platforms are usually composed from several open technologies, not one runtime. Xen sits at the virtualization boundary, complementing Linux, Yocto Project, Zephyr, Automotive Grade Linux, and the underlying hardware platform without replacing them.
          </Text>
        </Stack>
        <Split align="start" class="xp-ecosystem-layout">
          <Stack gap="4">
            <PlatformLayersDiagram
              id="open-platform-ecosystem-diagram"
              class="xp-ecosystem-diagram"
              {...embeddedAutomotiveEcosystemLayersDiagram}
            />
            <Callout
              title="AGL Software Defined Vehicle reference architecture"
              description="AGL's Software Defined Vehicle reference architecture is useful because it shows how Xen, Zephyr, Linux, and automotive application layers can fit into a broader open platform model."
              action={{label: 'Read the AGL SDV announcement', href: 'https://www.automotivelinux.org/announcements/sodev/', variant: 'secondary'}}
            >
              <span slot="icon" class="i-carbon-document"></span>
            </Callout>
          </Stack>
          <Grid columns="2" gap="4">
            {ecosystemRoles.map(role => (
              <Card>
                <Stack gap="4">
                  <span class:list={[role.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                  <Stack gap="3">
                    <Heading as="h3" size="heading-m">{role.title}</Heading>
                    <Text size="small">{role.description}</Text>
                  </Stack>
                  {role.href && (
                    <Button href={role.href} variant="text" class="uno-self-start">
                      {role.linkLabel ?? 'Learn more'}
                    </Button>
                  )}
                </Stack>
              </Card>
            ))}
          </Grid>
        </Split>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="resources"
    eyebrow="Related resources"
    title="Follow the evaluation path from architecture to participation."
    description="These resources connect the solution page to existing Xen project, technology, testing, download, and documentation entry points."
    surface="1"
    columns="3"
    features={resources}
  />

  <Section id="ecosystem">
    <Container>
      <Split align="center">
        <Stack gap="4">
          <Text size="eyebrow" tone="muted">Ecosystem</Text>
          <Heading size="heading-xl">Sustained by organizations working across open virtualization.</Heading>
          <Text>
            Xen is sustained by organizations working across infrastructure, hardware, embedded, automotive, and security-sensitive systems. Membership supports shared project infrastructure, events, trademark stewardship, and ecosystem coordination.
          </Text>
          <Cluster>
            <Button href="/about/project-members/" variant="secondary">View project members</Button>
            <Button href="/about/become-a-member/" variant="text">Become a member</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Stack gap="4">
            <Callout
              title="Open engineering model"
              description="Xen is developed in the open, with public governance, security process, CI resources, and contribution paths that organizations can inspect before depending on the platform."
              action={{label: 'Read governance', href: '/about/governance/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-branch"></span>
            </Callout>
            <Callout
              title="Security response process"
              description="Security reporting and response expectations are documented for users, vendors, and contributors."
              action={{label: 'Review security policy', href: '/about/security-policy/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-security"></span>
            </Callout>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <CTA
    id="next-step"
    eyebrow="Next step"
    title="Evaluate Xen for your platform, or help shape the work."
    description="Engineers can start with architecture, CI, and contribution resources. Organizations can support the project through membership and deeper ecosystem participation."
    actions={[
      {label: 'Start contributing', href: '/contribute/get-started/'},
      {label: 'Become a member', href: '/about/become-a-member/', variant: 'secondary'},
    ]}
    align="center"
  />
</BaseLayout>

<style>
  .xp-tag {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    border: 1px solid var(--xp-border-muted);
    border-radius: var(--xp-radius-md);
    background: rgb(133 194 65 / 0.1);
    color: var(--xp-text-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .xp-tag {
    padding: 0.5rem 0.65rem;
  }

  :global(.xp-ecosystem-layout) {
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    :global(.xp-ecosystem-layout) {
      grid-template-columns: minmax(0, 1.08fr) minmax(36rem, 0.92fr);
    }
  }
</style>
