---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Grid from '../../components/primitives/Grid.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Embedded & Automotive';
const description = 'Open source virtualization for embedded and automotive systems that need isolation, mixed workloads, hardware-aware boundaries, and long-term platform control.';
const keywords = [
  'Xen Project',
  'embedded systems',
  'automotive virtualization',
  'software-defined vehicles',
  'mixed-criticality workloads',
  'Dom0less',
  'device passthrough',
  'Arm virtualization',
  'open source hypervisor',
];

const virtualizationChallenges = [
  {
    icon: 'i-carbon-chip',
    title: 'Shared hardware',
    description: 'Run more platform software on fewer boards while keeping ownership and failure domains visible.',
  },
  {
    icon: 'i-carbon-container-services',
    title: 'Mixed workloads',
    description: 'Give Linux, RTOS workloads, service domains, and specialized systems a clearer place to coexist.',
  },
  {
    icon: 'i-carbon-data-base-alt',
    title: 'Explicit boundaries',
    description: 'Keep devices, boot flow, interrupts, and integration responsibilities visible to platform teams.',
  },
  {
    icon: 'i-carbon-time',
    title: 'Maintainable platforms',
    description: 'Support architectures that can evolve across long hardware, software, and product lifecycles.',
  },
];

const xenFit = [
  {
    icon: 'i-carbon-layers',
    title: 'Thin hypervisor boundary',
    description: 'Xen gives platform teams a focused layer for separation decisions close to the hardware boundary.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-security',
    title: 'Hardware-aware isolation',
    description: 'Guest isolation and hardware-facing platform work stay visible instead of disappearing inside one operating system.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Read isolation overview',
  },
  {
    icon: 'i-carbon-virtual-machine',
    title: 'Flexible guest model',
    description: 'Different operating environments can share a platform while retaining separate roles and responsibilities.',
    href: '/technology/architecture/',
    linkLabel: 'Read architecture overview',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Open engineering model',
    description: 'Governance, contribution paths, security handling, and public testing resources are available for evaluation.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-lived maintainability',
    description: 'An open platform boundary helps teams plan for products that must be inspected, updated, and supported over time.',
    href: '/contribute/ci/',
    linkLabel: 'Review CI resources',
  },
];

const concepts = [
  {
    label: 'Dom0less',
    description: 'A Xen configuration path for systems that benefit from starting guest domains without waiting for a traditional control domain boot path.',
  },
  {
    label: 'Device passthrough',
    description: 'A platform integration tool for assigning selected hardware resources to guests when the system design calls for direct device access.',
  },
  {
    label: 'Hardware CI',
    description: 'Xen CI includes real hardware validation, including Dom0, DomU, Dom0less, PCI passthrough, and suspend/resume scenarios.',
  },
  {
    label: 'Arm and platform support',
    description: 'Existing Xen site content references Arm, ARM64, x86, RISC-V, and PowerPC work across project and CI material.',
  },
  {
    label: 'Safety-conscious process',
    description: 'Existing project content references MISRA C work and safety-standard alignment efforts; product certification still requires separate evaluation.',
  },
  {
    label: 'Open source integration',
    description: 'The embedded project has referenced work across Xen, Linux, OP-TEE, and RTOS environments such as Zephyr.',
  },
];

const resources = [
  {
    icon: 'i-carbon-layers',
    title: 'Hypervisor',
    description: 'Start with the core Xen hypervisor project and its architecture-oriented project resources.',
    href: '/projects/hypervisor/',
    linkLabel: 'Open project',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Architecture',
    description: 'A technology entry point for how Xen fits between hardware, guests, and platform control.',
    href: '/technology/architecture/',
    linkLabel: 'Read overview',
  },
  {
    icon: 'i-carbon-security',
    title: 'Isolation & Security',
    description: 'Review the site entry point for isolation and security resources in the redesigned technology area.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review resources',
  },
  {
    icon: 'i-carbon-checkmark-outline',
    title: 'Safety-Critical Systems',
    description: 'A starting point for safety-oriented evaluation resources as they are organized for the redesigned site.',
    href: '/technology/safety/',
    linkLabel: 'Review safety entry point',
  },
  {
    icon: 'i-carbon-test-tool',
    title: 'Continuous Integration',
    description: 'Explore Xen hardware CI, test coverage, and bring-your-own-hardware validation resources.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
  {
    icon: 'i-carbon-download',
    title: 'Downloads',
    description: 'Find Xen releases and download resources for evaluation and development work.',
    href: '/resources/downloads/',
    linkLabel: 'Get downloads',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-solution-embedded-automotive">
  <Hero
    eyebrow="Solution Area"
    title="Open source virtualization for embedded and automotive systems."
    description="Build mixed-workload platforms on shared hardware while keeping system boundaries explicit, inspectable, and maintainable across long product lifecycles."
    actions={[
      {label: 'Explore Xen architecture', href: '/technology/architecture/'},
      {label: 'Start contributing', href: '/contribute/get-started/', variant: 'secondary'},
    ]}
    layout="balanced"
  >
    <Surface
      slot="media"
      tone="2"
      border="strong"
      radius="lg"
      shadow="md"
      padding="lg"
      class="xp-platform-diagram lg:uno-ml-auto lg:uno-max-w-[38rem]"
    >
      <Stack gap="5" class="xp-platform-diagram__content">
        <div class="xp-platform-diagram__header uno-flex uno-items-center uno-justify-between uno-gap-4">
          <Text size="eyebrow" tone="accent-primary">Platform layers</Text>
          <span class="i-carbon-car uno-text-3xl uno-text-xp-accent-primary" aria-hidden="true"></span>
        </div>
        <div class="xp-platform-stack">
          <div class="xp-platform-plate xp-platform-plate--guests">
            <span class="xp-platform-plate__front" aria-hidden="true"></span>
            <span class="xp-platform-plate__side" aria-hidden="true"></span>
            <Text size="mono-small" tone="accent-primary" class="xp-platform-plate__title">Guest domains</Text>
            <div class="xp-domain-list">
              <span class="xp-layer-chip">Linux</span>
              <span class="xp-layer-chip">RTOS</span>
              <span class="xp-layer-chip">Services</span>
            </div>
          </div>
          <div class="xp-platform-connector" aria-hidden="true">
            <span class="xp-platform-connector__rail"></span>
            <span class="xp-platform-connector__marker"></span>
          </div>
          <div class="xp-platform-plate xp-platform-plate--hypervisor">
            <span class="xp-platform-plate__front" aria-hidden="true"></span>
            <span class="xp-platform-plate__side" aria-hidden="true"></span>
            <Text size="mono-small" tone="accent-primary" class="xp-platform-plate__title">Xen hypervisor boundary</Text>
            <Text size="caption" class="xp-platform-plate__copy">Isolation, scheduling, device assignment, and platform control decisions stay visible.</Text>
          </div>
          <div class="xp-platform-connector" aria-hidden="true">
            <span class="xp-platform-connector__rail"></span>
            <span class="xp-platform-connector__marker"></span>
          </div>
          <div class="xp-platform-plate xp-platform-plate--hardware">
            <span class="xp-platform-plate__front" aria-hidden="true"></span>
            <span class="xp-platform-plate__side" aria-hidden="true"></span>
            <Text size="mono-small" tone="accent-primary" class="xp-platform-plate__title">Hardware platform</Text>
            <Text size="caption" class="xp-platform-plate__copy">Compute, memory, interrupts, devices, and long-lived product integration.</Text>
            <span class="xp-hardware-leds" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </span>
          </div>
        </div>
      </Stack>
    </Surface>
  </Hero>

  <Section id="why-virtualization">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Why virtualization matters here</Text>
          <Heading size="heading-xl">Consolidate the platform without blurring the boundaries.</Heading>
          <Text>
            Embedded and automotive teams are asked to combine more software on shared compute while preserving the boundaries that make engineering, validation, and maintenance practical.
          </Text>
        </Stack>
        <Grid columns="2" gap="5" class="uno-max-w-xp-page">
          {virtualizationChallenges.map(challenge => (
            <Card>
              <Stack gap="4">
                <span class:list={[challenge.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{challenge.title}</Heading>
                  <Text size="caption">{challenge.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="automotive" surface="1">
    <Container>
      <Split align="center">
        <Stack gap="5">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Automotive focus</Text>
            <Heading size="heading-xl">A virtualization layer for software-defined vehicle platforms.</Heading>
            <Text>
              Automotive platforms increasingly combine Linux systems, RTOS workloads, service domains, and hardware-specific functions on shared compute. Xen gives platform teams a thin virtualization layer for reasoning about isolation, ownership, and system boundaries without treating one operating system as the whole platform.
            </Text>
          </Stack>
          <Grid columns="2" gap="4">
            <Card>
              <Stack gap="3">
                <span class="i-carbon-car uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
                <Heading as="h3" size="heading-m">ECU consolidation</Heading>
                <Text size="caption">Keep platform boundaries explicit as vehicle functions move from many controllers toward shared compute.</Text>
              </Stack>
            </Card>
            <Card>
              <Stack gap="3">
                <span class="i-carbon-ibm-watsonx-code-assistant-for-z-refactor uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
                <Heading as="h3" size="heading-m">Mixed workloads</Heading>
                <Text size="caption">Evaluate how IVI, service domains, Linux, RTOS workloads, and hardware-facing functions can coexist.</Text>
              </Stack>
            </Card>
          </Grid>
        </Stack>
        <Stack gap="4">
          <Surface as="aside" tone="2" border="strong" radius="lg" shadow="sm" padding="lg">
            <div class="uno-flex uno-min-w-0 uno-flex-col uno-gap-3 sm:uno-flex-row sm:uno-items-start sm:uno-gap-4">
              <span class="i-carbon-document-requirements uno-mt-1 uno-inline-flex uno-shrink-0 uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
              <Stack gap="3" class="uno-min-w-0">
                <Text as="span" size="eyebrow" tone="accent-primary">Evaluation note</Text>
                <Heading as="h3" size="heading-m">Certification work depends on product evidence.</Heading>
                <Text size="caption">
                  Xen is relevant to safety-conscious platform evaluation, but this page does not claim product safety certification. Teams with certification requirements should evaluate code, process, evidence, and integration context for their product.
                </Text>
              </Stack>
            </div>
          </Surface>
          <Surface tone="2" border="muted" radius="lg" shadow="sm" padding="lg">
            <Stack gap="3">
              <Text size="eyebrow" tone="accent-primary">Evaluation concerns</Text>
              <div class="uno-flex uno-flex-wrap uno-gap-2">
                {['mixed-criticality workloads', 'supplier coordination', 'long-term maintenance', 'hardware validation', 'certification-aware work'].map(item => (
                  <span class="xp-tag">{item}</span>
                ))}
              </div>
            </Stack>
          </Surface>
        </Stack>
      </Split>
    </Container>
  </Section>

  <Section id="embedded-systems">
    <Container>
      <Split>
        <Stack gap="3">
          <Text size="eyebrow" tone="muted">Embedded systems</Text>
          <Heading size="heading-xl">The automotive story builds on broader embedded virtualization foundations.</Heading>
          <Text>
            Xen can be evaluated anywhere teams need to combine hardware-facing software, guest operating systems, and long-lived platform requirements while keeping separation visible.
          </Text>
        </Stack>
        <Grid columns="2" gap="4">
          {['Industrial systems', 'Robotics', 'Medical and regulated devices', 'Edge appliances', 'Networking equipment', 'Specialized hardware platforms'].map(example => (
            <Surface tone="2" border="muted" radius="md" shadow="sm" padding="md">
              <Text size="caption" tone="primary" class="uno-font-semibold">{example}</Text>
            </Surface>
          ))}
        </Grid>
      </Split>
    </Container>
  </Section>

  <FeatureGrid
    id="why-xen-fits"
    eyebrow="Why Xen fits"
    title="A practical boundary for mixed-workload platform engineering."
    description="Xen is relevant when teams need a thin virtualization layer, hardware-aware isolation, flexible guest placement, and an open engineering model they can inspect over the life of a product."
    surface="1"
    columns="3"
    features={xenFit}
  />

  <Section id="concepts">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Relevant technologies and concepts</Text>
          <Heading size="heading-xl">Start with the concepts before choosing an integration path.</Heading>
          <Text>
            These concepts are useful starting points for an embedded or automotive evaluation. Detailed product claims should be checked against current upstream documentation and project evidence.
          </Text>
        </Stack>
        <Grid columns="3" gap="5">
          {concepts.map(concept => (
            <Card>
              <Stack gap="3">
                <Text size="mono-small" tone="accent-primary" class="uno-font-semibold">{concept.label}</Text>
                <Text size="caption">{concept.description}</Text>
              </Stack>
            </Card>
          ))}
        </Grid>
        <Callout
          title="Treat detailed safety and real-time claims as verification work."
          description="RTDS scheduling, IOMMU behavior, static partitioning, memory and interrupt separation, AGL ties, exact performance numbers, and formal certification status should be linked only after they are verified from current authoritative project material."
          action={{label: 'Review safety entry point', href: '/technology/safety/', variant: 'secondary'}}
        >
          <span slot="icon" class="i-carbon-document-requirements"></span>
        </Callout>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="resources"
    eyebrow="Related resources"
    title="Follow the evaluation path from architecture to participation."
    description="These resources connect the solution page to existing Xen project, technology, testing, download, and documentation entry points."
    surface="1"
    columns="3"
    features={resources}
  />

  <Section id="ecosystem">
    <Container>
      <Split align="center">
        <Stack gap="4">
          <Text size="eyebrow" tone="muted">Ecosystem and trust signals</Text>
          <Heading size="heading-xl">Sustained by organizations working across open virtualization.</Heading>
          <Text>
            Xen is sustained by organizations working across infrastructure, hardware, embedded, automotive, and security-sensitive systems. Membership supports shared project infrastructure, events, trademark stewardship, and ecosystem coordination.
          </Text>
          <Cluster>
            <Button href="/about/project-members/" variant="secondary">View project members</Button>
            <Button href="/about/become-a-member/" variant="text">Become a member</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Stack gap="4">
            <Callout
              title="Open engineering model"
              description="Xen is developed in the open, with public governance, security process, CI resources, and contribution paths that organizations can inspect before depending on the platform."
              action={{label: 'Read governance', href: '/about/governance/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-branch"></span>
            </Callout>
            <Callout
              title="Security response process"
              description="Security reporting and response expectations are documented for users, vendors, and contributors."
              action={{label: 'Review security policy', href: '/about/security-policy/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-security"></span>
            </Callout>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <CTA
    id="next-step"
    eyebrow="Next step"
    title="Evaluate Xen for your platform, or help shape the work."
    description="Engineers can start with architecture, CI, and contribution resources. Organizations can support the project through membership and deeper ecosystem participation."
    actions={[
      {label: 'Start contributing', href: '/contribute/get-started/'},
      {label: 'Become a member', href: '/about/become-a-member/', variant: 'secondary'},
    ]}
    align="center"
  />
</BaseLayout>

<style>
  .xp-platform-diagram {
    --plate-blue: rgb(42 153 255);
    --plate-cyan: rgb(65 218 255);
    --plate-green: rgb(133 194 65);
    position: relative;
    isolation: isolate;
    min-height: 26rem;
    overflow: visible;
    border-color: rgb(92 145 209 / 0.28);
    background:
      radial-gradient(circle at 78% 18%, rgb(42 153 255 / 0.1), transparent 32%),
      radial-gradient(circle at 12% 82%, rgb(133 194 65 / 0.08), transparent 36%),
      linear-gradient(145deg, rgb(255 255 255 / 0.035), transparent 42%),
      rgb(13 25 42 / 0.72);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.035) inset,
      0 1.2rem 2.2rem -1.45rem rgb(0 0 0 / 0.5);
  }

  .xp-platform-diagram::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.016) 1px, transparent 1px);
    background-size: 2.7rem 2.7rem;
    mask-image: linear-gradient(135deg, transparent 4%, black 32%, transparent 86%);
  }

  .xp-platform-diagram::after {
    content: '';
    position: absolute;
    inset: auto 4% 2.25rem;
    z-index: -1;
    height: 6rem;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 50% 50%, rgb(42 153 255 / 0.12), transparent 65%),
      radial-gradient(ellipse at 50% 60%, rgb(133 194 65 / 0.08), transparent 68%);
    opacity: 0.55;
  }

  .xp-platform-diagram__content {
    position: relative;
    z-index: 1;
  }

  .xp-platform-diagram__header {
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.055);
  }

  .xp-platform-stack {
    display: grid;
    gap: 1.9rem;
    padding: 1.1rem 0.35rem 1rem;
    perspective: 44rem;
    transform-style: preserve-3d;
  }

  .xp-platform-plate {
    --plate-edge: rgb(8 18 36);
    --plate-edge-light: rgb(37 121 201 / 0.86);
    --plate-highlight: rgb(122 221 255 / 0.58);
    --plate-shadow: rgb(0 0 0 / 0.42);
    --plate-depth: 0.72rem;
    --plate-side-width: 0.62rem;
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: 1.05rem 1.1rem;
    border: 1px solid rgb(102 190 255 / 0.2);
    border-radius: 1rem;
    background:
      radial-gradient(circle at 18% 9%, rgb(95 165 255 / 0.18), transparent 35%),
      linear-gradient(145deg, rgb(255 255 255 / 0.1), transparent 38%),
      linear-gradient(180deg, rgb(27 48 82 / 0.98), rgb(10 25 52 / 0.99));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.18) inset,
      0 -1px 0 rgb(0 0 0 / 0.28) inset,
      0 0 0 1px rgb(42 153 255 / 0.07) inset,
      0 1.8rem 2.2rem -1.2rem var(--plate-shadow);
    transform: rotateX(10deg) rotateZ(-2deg);
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }

  .xp-platform-plate::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .xp-platform-plate::after {
    inset: 0.52rem 1rem auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--plate-highlight), transparent);
    box-shadow: 0 0 0.38rem rgb(42 153 255 / 0.2);
    opacity: 0.68;
  }

  .xp-platform-plate__front,
  .xp-platform-plate__side {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .xp-platform-plate__front {
    right: 0;
    bottom: calc((var(--plate-depth) - 0.03rem) * -1);
    left: 0;
    height: var(--plate-depth);
    border: 1px solid rgb(83 172 255 / 0.15);
    border-top: 0;
    border-radius: 0 0 1rem 1rem;
    background:
      linear-gradient(90deg, rgb(12 71 135 / 0.44), rgb(99 210 255 / 0.42) 50%, rgb(10 41 91 / 0.5)),
      linear-gradient(180deg, var(--plate-edge-light), var(--plate-edge));
    box-shadow:
      0 1px 0 rgb(123 224 255 / 0.32) inset,
      0 0.45rem 0.75rem rgb(15 106 255 / 0.12);
    opacity: 0.92;
  }

  .xp-platform-plate__side {
    top: 0.42rem;
    right: calc((var(--plate-side-width) - 0.03rem) * -1);
    bottom: calc(var(--plate-depth) * -0.42);
    width: var(--plate-side-width);
    border-radius: 0 1rem 1rem 0;
    background:
      linear-gradient(180deg, rgb(108 211 255 / 0.24), transparent 42%),
      linear-gradient(90deg, var(--plate-edge-light), var(--plate-edge));
    clip-path: polygon(0 0, 100% 0.55rem, 100% calc(100% - 0.45rem), 0 100%);
    box-shadow:
      -1px 0 0 rgb(111 218 255 / 0.26) inset,
      0.28rem 0.55rem 0.7rem rgb(0 0 0 / 0.22);
    opacity: 0.86;
  }

  .xp-platform-plate--guests {
    z-index: 3;
    transform: translateY(-0.2rem) translateZ(2.1rem) scale(0.96) rotateX(11deg) rotateZ(-2.2deg);
    background:
      radial-gradient(circle at 18% 11%, rgb(73 172 255 / 0.2), transparent 34%),
      linear-gradient(145deg, rgb(255 255 255 / 0.105), transparent 36%),
      linear-gradient(180deg, rgb(32 55 94 / 0.98), rgb(13 31 65 / 0.99));
  }

  .xp-platform-plate--hypervisor {
    z-index: 2;
    transform: translateX(0.28rem) translateZ(1rem) scale(0.985) rotateX(9.5deg) rotateZ(-1.55deg);
    border-color: rgb(80 178 255 / 0.26);
    background:
      radial-gradient(circle at 22% 8%, rgb(42 153 255 / 0.13), transparent 38%),
      linear-gradient(145deg, rgb(255 255 255 / 0.07), transparent 34%),
      linear-gradient(180deg, rgb(19 42 68 / 0.98), rgb(10 27 48 / 0.99));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.15) inset,
      0 0 0 1px rgb(42 153 255 / 0.1) inset,
      0 1.15rem 1.7rem -0.95rem rgb(0 0 0 / 0.4);
  }

  .xp-platform-plate--hardware {
    --plate-edge: rgb(17 25 19);
    --plate-edge-light: rgb(103 148 58 / 0.74);
    --plate-highlight: rgb(179 255 93 / 0.44);
    --plate-depth: 0.82rem;
    --plate-side-width: 0.7rem;
    z-index: 1;
    padding-bottom: 1.55rem;
    transform: translateX(-0.18rem) translateY(0.12rem) scale(1.015) rotateX(8deg) rotateZ(-1deg);
    border-color: rgb(133 194 65 / 0.26);
    background:
      radial-gradient(circle at 84% 72%, rgb(133 194 65 / 0.13), transparent 28%),
      linear-gradient(90deg, rgb(133 194 65 / 0.08) 1px, transparent 1px),
      linear-gradient(rgb(133 194 65 / 0.055) 1px, transparent 1px),
      linear-gradient(135deg, transparent 18%, rgb(133 194 65 / 0.065) 18% 19%, transparent 19% 39%, rgb(42 153 255 / 0.045) 39% 40%, transparent 40%),
      linear-gradient(180deg, rgb(24 42 33 / 0.98), rgb(10 25 30 / 0.99));
