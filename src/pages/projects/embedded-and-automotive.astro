---
import CTA from '../../components/blocks/CTA.astro';
import Callout from '../../components/blocks/Callout.astro';
import FeatureGrid from '../../components/blocks/FeatureGrid.astro';
import Hero from '../../components/blocks/Hero.astro';
import Button from '../../components/primitives/Button.astro';
import Card from '../../components/primitives/Card.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Container from '../../components/primitives/Container.astro';
import Grid from '../../components/primitives/Grid.astro';
import Heading from '../../components/primitives/Heading.astro';
import Section from '../../components/primitives/Section.astro';
import Split from '../../components/primitives/Split.astro';
import Stack from '../../components/primitives/Stack.astro';
import Surface from '../../components/primitives/Surface.astro';
import Text from '../../components/primitives/Text.astro';
import PlatformLayersDiagram from '../../components/diagrams/PlatformLayersDiagram.astro';
import {
  embeddedAutomotiveEcosystemLayersDiagram,
  embeddedAutomotivePlatformLayersDiagram,
} from '../../data/embedded-and-automotive-platform-layers';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Embedded & Automotive';
const description = 'Open source virtualization for embedded and automotive systems that need isolation, mixed workloads, hardware-aware boundaries, and long-term platform control.';
const keywords = [
  'Xen Project',
  'embedded systems',
  'automotive virtualization',
  'software-defined vehicles',
  'mixed-criticality workloads',
  'Dom0less',
  'device passthrough',
  'Arm virtualization',
  'open source hypervisor',
];

const virtualizationChallenges = [
  {
    icon: 'i-carbon-chip',
    title: 'Shared hardware',
    description: 'Run more platform software on fewer boards while keeping ownership and failure domains visible.',
  },
  {
    icon: 'i-carbon-container-services',
    title: 'Mixed workloads',
    description: 'Give Linux, RTOS workloads, service domains, and specialized systems clear places to coexist.',
  },
  {
    icon: 'i-carbon-data-base-alt',
    title: 'Explicit boundaries',
    description: 'Keep devices, boot flow, interrupts, and integration responsibilities visible.',
  },
  {
    icon: 'i-carbon-time',
    title: 'Maintainable platforms',
    description: 'Support architectures that can evolve across long hardware, software, and product lifecycles.',
  },
];

const mixedCriticalityExamples: {title: string; description: string}[] = [
  {
    title: 'Different operating profiles',
    description: 'Control workloads, RTOS workloads, Linux services, infotainment, diagnostics, and OTA services can have different timing, reliability, update, and validation needs.',
  },
  {
    title: 'Shared compute pressure',
    description: 'As platforms consolidate onto fewer processors, workloads that once lived on separate controllers increasingly share memory, devices, interrupts, and boot paths.',
  },
  {
    title: 'Separation as an engineering concern',
    description: 'The hard problem is sharing hardware without blurring ownership, validation scope, fault containment, or lifecycle boundaries.',
  },
];

const platformSeparation: {icon: string; title: string; description: string}[] = [
  {
    icon: 'i-carbon-security',
    title: 'Isolation boundaries',
    description: 'Reason about where guests are separated and where integration must be reviewed explicitly.',
  },
  {
    icon: 'i-carbon-user-multiple',
    title: 'Guest ownership',
    description: 'Keep Linux guests, RTOS guests, service domains, and hardware-facing components accountable.',
  },
  {
    icon: 'i-carbon-chip',
    title: 'Resource assignment',
    description: 'Make CPU, memory, interrupt, and device assignment explicit platform design choices.',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Boot and integration',
    description: 'Track startup order, control-domain choices, device setup, and integration responsibilities.',
  },
  {
    icon: 'i-carbon-settings-adjust',
    title: 'Platform control',
    description: 'Separate hardware-facing control from guest application environments where needed.',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-term maintainability',
    description: 'Support lifecycles where guests, platform software, and hardware assumptions evolve at different rates.',
  },
];

const technicalCapabilities: {icon: string; title: string; description: string; href?: string; linkLabel?: string}[] = [
  {
    icon: 'i-carbon-chip',
    title: 'CPU pinning',
    description: 'Assign CPU resources deliberately so latency-sensitive guests have explicit execution ownership.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-time',
    title: 'Deterministic interrupt latencies',
    description: 'Design systems where interrupt routing, CPU assignment, and device ownership support deterministic interrupt latencies.',
    href: '/technology/safety/',
    linkLabel: 'Review safety resources',
  },
  {
    icon: 'i-carbon-connect',
    title: 'Device passthrough',
    description: 'Assign selected hardware devices directly to guests when the design calls for direct ownership.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-boot',
    title: 'Dom0less boot',
    description: 'Start selected guest domains without waiting for a traditional control-domain boot path.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-data-structured',
    title: 'Static resource partitioning',
    description: 'Make CPU, memory, device, and interrupt ownership part of the platform design.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Flexible control domains',
    description: 'Choose a control-domain model that fits the architecture instead of assuming one pattern.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
];

const xenFit = [
  {
    icon: 'i-carbon-layers',
    title: 'Thin hypervisor boundary',
    description: 'Xen gives platform teams a focused layer for separation decisions near hardware.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-security',
    title: 'Hardware-aware isolation',
    description: 'Guest isolation and hardware-facing work stay visible instead of disappearing inside one OS.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-virtual-machine',
    title: 'Flexible guest model',
    description: 'Different operating environments can share a platform while retaining separate roles.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-branch',
    title: 'Open engineering model',
    description: 'Governance, contribution paths, security handling, and public testing resources are available for evaluation.',
    href: '/about/governance/',
    linkLabel: 'Read governance',
  },
  {
    icon: 'i-carbon-time',
    title: 'Long-lived maintainability',
    description: 'An open boundary helps teams plan products that must be inspected and updated over time.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
];

const ecosystemRoles = [
  {
    icon: 'i-carbon-layers',
    title: 'Xen',
    group: 'Core platform',
    description: 'Provides the virtualization and isolation boundary between guest systems and shared hardware.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-linux',
    title: 'Linux',
    group: 'Core platform',
    description: 'Runs rich operating-system services, middleware, application environments, and integration tooling.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-mdi-kite-outline',
    title: 'Zephyr',
    group: 'Core platform',
    description: 'Supports RTOS-style embedded workloads that may need a smaller runtime than Linux.',
    href: 'https://www.zephyrproject.org/',
    linkLabel: 'Visit Zephyr Project',
  },
  {
    icon: 'i-carbon-package',
    title: 'Yocto Project',
    group: 'Build and domain ecosystem',
    description: 'Helps teams construct embedded Linux distributions and repeatable images for Linux guests.',
    href: 'https://www.yoctoproject.org/',
    linkLabel: 'Visit Yocto Project',
  },
  {
    icon: 'i-carbon-car',
    title: 'Automotive Grade Linux',
    group: 'Build and domain ecosystem',
    description: 'Provides an open automotive Linux platform for IVI and software-defined vehicle software stacks.',
    href: 'https://www.automotivelinux.org/',
    linkLabel: 'Visit AGL',
  },
  {
    icon: 'i-carbon-chip',
    title: 'Hardware and SoC platform',
    group: 'Build and domain ecosystem',
    description: 'Supplies the compute, memory, interrupts, devices, and peripherals the platform composes around.',
  },
];

const resources = [
  {
    icon: 'i-carbon-layers',
    title: 'Hypervisor',
    description: 'Start with the core Xen hypervisor project and architecture resources.',
    href: '/projects/hypervisor/',
    linkLabel: 'Explore the hypervisor',
  },
  {
    icon: 'i-carbon-diagram',
    title: 'Architecture',
    description: 'See how Xen fits between hardware, guests, and platform control.',
    href: '/technology/architecture/',
    linkLabel: 'Explore architecture',
  },
  {
    icon: 'i-carbon-security',
    title: 'Isolation & Security',
    description: 'Review isolation and security resources for Xen-based platforms.',
    href: '/technology/isolation-and-security/',
    linkLabel: 'Review isolation resources',
  },
  {
    icon: 'i-carbon-checkmark-outline',
    title: 'Safety-Critical Systems',
    description: 'Start with safety-oriented evaluation resources for Xen.',
    href: '/technology/safety/',
    linkLabel: 'Review safety resources',
  },
  {
    icon: 'i-carbon-test-tool',
    title: 'Continuous Integration',
    description: 'Explore hardware CI, test coverage, and bring-your-own-hardware resources.',
    href: '/contribute/ci/',
    linkLabel: 'View CI resources',
  },
  {
    icon: 'i-carbon-download',
    title: 'Downloads',
    description: 'Find Xen releases for evaluation and development.',
    href: '/resources/downloads/',
    linkLabel: 'View downloads',
  },
];
---

<BaseLayout title={title} description={description} keywords={keywords} publicShell bodyClass="xp-solution-embedded-automotive">
  <Hero
    id="hero"
    eyebrow="Solution Area"
    title="Open source virtualization for embedded and automotive systems."
    description="Build mixed-criticality platforms that consolidate Linux, RTOS, and specialized workloads onto shared hardware while keeping system boundaries explicit, inspectable, and maintainable throughout long product lifecycles."
    actions={[
      {label: 'Explore architecture', href: '/technology/architecture/'},
      {label: 'Start contributing', href: '/contribute/get-started/', variant: 'secondary'},
    ]}
    layout="balanced"
  >
    <PlatformLayersDiagram slot="media" {...embeddedAutomotivePlatformLayersDiagram} />
  </Hero>

  <Section id="why-virtualization">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Why virtualization matters here</Text>
          <Heading size="heading-xl">Consolidate the platform without blurring the boundaries.</Heading>
          <Text>
            Embedded and automotive teams need to combine more software on shared compute while preserving engineering, validation, and maintenance boundaries.
          </Text>
        </Stack>
        <Grid columns="2" gap="5" class="uno-max-w-xp-page">
          {virtualizationChallenges.map(challenge => (
            <Card>
              <Stack gap="4">
                <span class:list={[challenge.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{challenge.title}</Heading>
                  <Text size="caption">{challenge.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="mixed-criticality" surface="1" spacing="technical">
    <Container>
      <Stack gap="6">
        <Split align="start">
          <Stack gap="3">
            <Text size="eyebrow" tone="muted">Mixed-criticality systems</Text>
            <Heading size="heading-xl">Why mixed-criticality matters</Heading>
          </Stack>
          <Text>
            Modern platforms combine workloads with different safety, timing, reliability, and maintenance needs. Mixed-criticality keeps attention on the boundaries between them, not just the shared hardware.
          </Text>
        </Split>
        <Grid columns="3" gap="5">
          {mixedCriticalityExamples.map(example => (
            <Card>
              <Stack gap="3">
                <Heading as="h3" size="heading-m">{example.title}</Heading>
                <Text size="caption">{example.description}</Text>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="platform-separation" spacing="technical">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Design principles</Text>
          <Heading size="heading-xl">Designed for platform separation</Heading>
          <Text>
            Xen gives platform teams a clear boundary between shared hardware and guest systems, keeping separation decisions visible.
          </Text>
        </Stack>
        <Grid columns="3" gap="5">
          {platformSeparation.map(item => (
            <Card>
              <Stack gap="4">
                <span class:list={[item.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{item.title}</Heading>
                  <Text size="caption">{item.description}</Text>
                </Stack>
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="technical-capabilities" surface="1" spacing="technical">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Technical capabilities</Text>
          <Heading size="heading-xl">Capabilities for mixed-criticality platform design</Heading>
          <Text>
            Once the separation model is clear, teams can evaluate Xen capabilities for ownership, timing, device access, and boot architecture.
          </Text>
        </Stack>
        <Grid columns="3" gap="5">
          {technicalCapabilities.map(capability => (
            <Card>
              <Stack gap="4">
                <span class:list={[capability.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                <Stack gap="3">
                  <Heading as="h3" size="heading-m">{capability.title}</Heading>
                  <Text size="caption">{capability.description}</Text>
                </Stack>
                {capability.href && (
                  <Button href={capability.href} variant="text" class="uno-self-start">
                    {capability.linkLabel ?? 'Learn more'}
                  </Button>
                )}
              </Stack>
            </Card>
          ))}
        </Grid>
      </Stack>
    </Container>
  </Section>

  <Section id="embedded-systems">
    <Container>
      <Split>
        <Stack gap="3">
          <Text size="eyebrow" tone="muted">Embedded platform breadth</Text>
          <Heading size="heading-xl">The same separation model applies across embedded domains.</Heading>
          <Text>
            Xen can be evaluated wherever hardware-facing software, guest operating systems, and long-lived platform requirements share compute.
          </Text>
        </Stack>
        <Grid columns="2" gap="4">
          {['Industrial systems', 'Robotics', 'Medical and regulated devices', 'Edge appliances', 'Networking equipment', 'Specialized hardware platforms'].map(example => (
            <Surface tone="2" border="muted" radius="md" shadow="sm" padding="md">
              <Text size="caption" tone="primary" class="uno-font-semibold">{example}</Text>
            </Surface>
          ))}
        </Grid>
      </Split>
    </Container>
  </Section>

  <Section id="automotive" surface="1">
    <Container>
      <div class="xp-automotive-layout">
        <Stack gap="3" class="xp-automotive-intro">
          <Text size="eyebrow" tone="muted">Flagship embedded example</Text>
          <Heading size="heading-xl">Software-defined vehicles make the separation challenge concrete.</Heading>
          <Text>
            Automotive platforms make the embedded challenge concrete: Linux systems, RTOS workloads, service domains, and hardware-specific functions increasingly share compute. Xen gives teams a thin layer for reasoning about isolation and ownership without treating one operating system as the whole platform.
          </Text>
        </Stack>
        <Grid columns="2" gap="4" class="xp-automotive-cards">
          <Card>
            <Stack gap="3">
              <span class="i-carbon-car uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
              <Heading as="h3" size="heading-m">ECU consolidation</Heading>
              <Text size="caption">Keep boundaries explicit as vehicle functions move toward shared compute.</Text>
            </Stack>
          </Card>
          <Card>
            <Stack gap="3">
              <span class="i-carbon-ibm-watsonx-code-assistant-for-z-refactor uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
              <Heading as="h3" size="heading-m">Mixed workloads</Heading>
              <Text size="caption">Evaluate how IVI, service domains, Linux, RTOS workloads, and hardware-facing functions coexist.</Text>
            </Stack>
          </Card>
        </Grid>
        <Surface as="aside" tone="2" border="strong" radius="lg" shadow="sm" padding="lg" class="xp-automotive-safety">
          <div class="uno-flex uno-min-w-0 uno-flex-col uno-gap-3 sm:uno-flex-row sm:uno-items-start sm:uno-gap-4">
            <span class="i-carbon-document-requirements uno-mt-1 uno-inline-flex uno-shrink-0 uno-text-2xl uno-text-xp-accent-primary" aria-hidden="true"></span>
            <Stack gap="3" class="uno-min-w-0">
              <Text as="span" size="eyebrow" tone="accent-primary">Safety engineering</Text>
              <Heading as="h3" size="heading-m">Safety work depends on system evidence.</Heading>
              <Text size="caption">
                Xen source code is not itself safety certified. Through the Xen Safety Committee, project participants collaborate on engineering practices, documentation, tooling, evidence, and supporting artifacts for safety-conscious and certification-oriented development. Product certification still depends on the complete system, process, integration context, and safety case.
              </Text>
            </Stack>
          </div>
        </Surface>
        <Surface tone="2" border="muted" radius="lg" shadow="sm" padding="lg" class="xp-automotive-tooling">
          <Stack gap="3">
            <Text size="eyebrow" tone="accent-primary">Process tooling</Text>
            <Text size="caption">
              The project also collaborates with BUGSENG on static analysis with ECLAIR, supporting MISRA C compliance efforts and ongoing code quality improvement.
            </Text>
          </Stack>
        </Surface>
      </div>
      <Surface
        as="aside"
        tone="2"
        border="strong"
        radius="lg"
        shadow="sm"
        padding="lg"
        class="xp-agl-spotlight"
      >
        <div class="xp-agl-spotlight__layout">
          <Stack gap="3" class="uno-min-w-0">
            <div class="uno-flex uno-items-center uno-gap-2">
              <span class="i-carbon-document uno-shrink-0 uno-text-xl uno-text-xp-accent-primary" aria-hidden="true"></span>
              <Text as="span" size="eyebrow" tone="accent-primary">Reference architecture spotlight</Text>
            </div>
            <Heading as="h2" size="heading-m">Automotive Grade Linux shows the stack in practice.</Heading>
            <Text size="caption">
              Automotive Grade Linux's Software Defined Vehicle reference architecture shows how Xen, Linux, Zephyr, platform services, and vehicle applications can fit together in a broader open automotive stack. It offers a concrete industry example of these separation and platform-composition concepts without prescribing a single Xen architecture.
            </Text>
          </Stack>
          <Button href="https://www.automotivelinux.org/announcements/sodev/" variant="secondary" class="uno-w-full sm:uno-w-auto sm:uno-shrink-0 sm:uno-justify-self-start">
            Explore the AGL SDV architecture
          </Button>
        </div>
      </Surface>
    </Container>
  </Section>

  <FeatureGrid
    id="why-xen-fits"
    eyebrow="Why architects choose Xen"
    title="Evaluation starts with architecture, evidence, and integration context."
    description="After the separation model is clear, teams can evaluate Xen through architecture, isolation resources, guest model, governance, and public engineering process."
    surface="1"
    columns="3"
    features={xenFit}
  />

  <Section id="open-platform-ecosystem" spacing="related">
    <Container>
      <Stack gap="6">
        <Stack gap="3" class="uno-max-w-xp-content">
          <Text size="eyebrow" tone="muted">Open platform ecosystem</Text>
          <Heading size="heading-xl">Building complete embedded platforms</Heading>
          <Text>
            Most embedded products are built from multiple open source projects, not one operating system. Xen provides the virtualization and isolation boundary that lets Linux, Yocto Project, Zephyr, AGL, and platform software play complementary roles without hiding ownership or integration decisions.
          </Text>
        </Stack>
        <Split align="start" class="xp-ecosystem-layout">
          <PlatformLayersDiagram
            id="open-platform-ecosystem-diagram"
            {...embeddedAutomotiveEcosystemLayersDiagram}
          />
          <Grid columns="2" gap="4" class="xp-ecosystem-role-groups">
            {['Core platform', 'Build and domain ecosystem'].map(group => (
              <Stack gap="2" class="xp-ecosystem-role-group">
                <Heading as="h3" size="heading-m" tone="muted">{group}</Heading>
                {ecosystemRoles.filter(role => role.group === group).map(role => (
                  <Card>
                    <Stack gap="3">
                      <span class:list={[role.icon, 'uno-text-2xl uno-text-xp-accent-primary']} aria-hidden="true"></span>
                      <Stack gap="3">
                        <Heading as="h4" size="heading-m">{role.title}</Heading>
                        <Text size="small">{role.description}</Text>
                      </Stack>
                      {role.href && (
                        <Button href={role.href} variant="text" class="uno-self-start">
                          {role.linkLabel ?? 'Learn more'}
                        </Button>
                      )}
                    </Stack>
                  </Card>
                ))}
              </Stack>
            ))}
          </Grid>
        </Split>
      </Stack>
    </Container>
  </Section>

  <FeatureGrid
    id="resources"
    eyebrow="Related resources"
    title="Follow the evaluation path from architecture to participation."
    description="Use these project, technology, testing, and download entry points to continue evaluation."
    surface="1"
    columns="3"
    spacing="related"
    features={resources}
  />

  <Section id="ecosystem">
    <Container>
      <Split align="center">
        <Stack gap="4">
          <Text size="eyebrow" tone="muted">Ecosystem</Text>
          <Heading size="heading-xl">Sustained by organizations working across open virtualization.</Heading>
          <Text>
            Xen is sustained by organizations working across infrastructure, hardware, embedded, automotive, and security-sensitive systems. Membership supports infrastructure, events, trademark stewardship, and ecosystem coordination.
          </Text>
          <Cluster>
            <Button href="/about/project-members/" variant="secondary">View project members</Button>
            <Button href="/about/become-a-member/" variant="text">Become a member</Button>
          </Cluster>
        </Stack>
        <Surface tone="2" border="strong" radius="lg" shadow="md" padding="lg">
          <Stack gap="4">
            <Callout
              title="Open engineering model"
              description="Xen is developed in the open, with public governance, security process, CI resources, and contribution paths that organizations can inspect before depending on the platform."
              action={{label: 'Read governance', href: '/about/governance/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-branch"></span>
            </Callout>
            <Callout
              title="Security response process"
              description="Security reporting and response expectations are documented for users, vendors, and contributors."
              action={{label: 'Review security policy', href: '/about/security-policy/', variant: 'text'}}
            >
              <span slot="icon" class="i-carbon-security"></span>
            </Callout>
          </Stack>
        </Surface>
      </Split>
    </Container>
  </Section>

  <CTA
    id="next-step"
    eyebrow="Next step"
    title="Evaluate Xen for your platform, or help shape the work."
    description="Start with architecture resources, documentation, CI, and community contribution paths, or support the project through membership."
    actions={[
      {label: 'Start contributing', href: '/contribute/get-started/'},
      {label: 'Become a member', href: '/about/become-a-member/', variant: 'secondary'},
    ]}
    align="center"
  />
</BaseLayout>

<style>
  :global(.xp-ecosystem-layout) {
    grid-template-columns: minmax(0, 1fr) !important;
    align-items: start;
  }

  :global(.xp-ecosystem-role-groups),
  :global(.xp-ecosystem-role-group) {
    align-items: start;
  }

  :global(.xp-ecosystem-role-group > *) {
    width: 100%;
  }

  :global(.xp-ecosystem-role-group > :first-child) {
    margin-bottom: 0.25rem;
  }

  :global(.xp-automotive-layout) {
    display: grid;
    gap: 1.25rem;
  }

  :global(.xp-automotive-safety) {
    display: flex;
    align-items: flex-start;
  }

  :global(.xp-agl-spotlight) {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .xp-agl-spotlight__layout {
    display: grid;
    width: 100%;
    max-width: 66rem;
    min-width: 0;
    margin-inline: auto;
    gap: 1.25rem;
  }

  @media (min-width: 1024px) {
    :global(.xp-automotive-layout) {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
      grid-template-areas:
        'intro safety'
        'cards tooling';
      align-items: stretch;
    }

    :global(.xp-automotive-intro) {
      grid-area: intro;
    }

    :global(.xp-automotive-cards) {
      grid-area: cards;
    }

    :global(.xp-automotive-safety) {
      grid-area: safety;
    }

    :global(.xp-automotive-tooling) {
      grid-area: tooling;
