---
import Aside from '../components/Aside.astro';
import BaseLayout from './BaseLayout.astro';

type AsideLink = {
  name: string;
  link?: string;
  icon?: string;
};

type AsideResourceGroup = {
  title?: string;
  items: AsideLink[];
};

type AsideResource = {
  type: 'resource';
  name?: string;
  items: Array<AsideLink | AsideResourceGroup>;
};

type Frontmatter = {
  title: string;
  description?: string;
  keywords?: string[];
  aside?: AsideResource[];
  hidePageHeader?: boolean;
  asidePosition?: 'before' | 'after';
  contentMode?: 'wrapped' | 'raw';
};

const {
  title,
  description = '',
  keywords = [],
  aside = [],
  hidePageHeader = false,
  asidePosition = 'before',
  contentMode = 'wrapped',
} = Astro.props.frontmatter as Frontmatter;

const hasAside = aside.length > 0;
---

<BaseLayout title={title} description={description} keywords={keywords} hasAside={hasAside}>
  {hasAside && asidePosition === 'before' && <Aside items={aside} />}
  <article class="article page-single">
    {
      !hidePageHeader && (
        <div class="container page-top">
          <h1>{title}</h1>
          {description && <div class="description">{description}</div>}
        </div>
      )
    }

    <div class="single-content">
      {
        contentMode === 'raw' ? (
          <slot />
        ) : (
          <section class="section-space content-markdown">
            <div class="container">
              <slot />
            </div>
          </section>
        )
      }
    </div>
  </article>
  {hasAside && asidePosition === 'after' && <Aside items={aside} />}
</BaseLayout>
