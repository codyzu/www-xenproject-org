---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/primitives/Container.astro';
import Heading from '../components/primitives/Heading.astro';
import Stack from '../components/primitives/Stack.astro';
import Surface from '../components/primitives/Surface.astro';
import Text from '../components/primitives/Text.astro';

type AsideLink = {
  name: string;
  link?: string;
  icon?: string;
};

type AsideResourceGroup = {
  title?: string;
  items: AsideLink[];
};

type AsideResource = {
  type: 'resource';
  name?: string;
  items: Array<AsideLink | AsideResourceGroup>;
};

type Frontmatter = {
  title: string;
  description?: string;
  summary?: string;
  keywords?: string[];
  canonicalUrl?: string;
  socialImage?: string;
  image?: string;
  aside?: AsideResource[];
  hidePageHeader?: boolean;
};

const {
  title,
  description,
  summary,
  keywords = [],
  canonicalUrl,
  socialImage,
  image,
  aside = [],
  hidePageHeader = false,
} = Astro.props.frontmatter as Frontmatter;

const asideLinks = aside.flatMap(resource => resource.items.flatMap(item => (
  'items' in item ? item.items : [item]
)));
---

<BaseLayout
  title={title}
  description={description}
  summary={summary}
  keywords={keywords}
  canonicalUrl={canonicalUrl}
  socialImage={socialImage}
  image={image}
  bodyClass="xp-longform-page"
  publicShell
>
  {
    !hidePageHeader && (
      <section class="xp-longform-hero uno-border-0 uno-border-b uno-border-solid uno-border-xp-border-muted uno-bg-[linear-gradient(180deg,rgb(133_194_65_/_0.10),transparent_28rem)] uno-px-4 uno-py-[clamp(3.5rem,8vw,6.5rem)] md:uno-px-6">
        <Container size="page">
          <Stack gap="4" class="uno-max-w-xp-content">
            <Heading as="h1" size="display-l">{title}</Heading>
            {description && <Text size="lead">{description}</Text>}
          </Stack>
        </Container>
      </section>
    )
  }

  <section class="uno-bg-xp-surface-1 uno-px-4 uno-py-[clamp(3rem,7vw,6rem)] md:uno-px-6">
    <Container size="page">
      <div class:list={[
        'xp-longform-layout uno-grid uno-min-w-0 uno-items-start uno-gap-6',
        asideLinks.length > 0 && 'lg:uno-grid-cols-[14rem_minmax(0,1fr)]',
      ]}>
        {
          asideLinks.length > 0 && (
            <Surface as="aside" tone="2" border="strong" radius="lg" shadow="md" padding="md" class="xp-longform-resources lg:uno-sticky lg:uno-top-24" aria-label="Resources">
              <Stack gap="3">
                <Heading as="h2" size="card">Resources</Heading>
                <ul class="uno-m-0 uno-list-none uno-p-0">
                  {asideLinks.map(item => (
                    <li>
                      {item.link ? (
                        <a href={item.link} class="xen-focus uno-flex uno-min-h-11 uno-items-center uno-justify-between uno-gap-3 uno-rounded-xp-md uno-px-3 uno-py-2 uno-text-sm uno-font-semibold uno-text-xp-text-secondary uno-no-underline hover:uno-bg-xp-surface-3 hover:uno-text-xp-text-primary">
                          <span>{item.name}</span>
                          <span class="i-carbon-launch uno-h-4 uno-w-4 uno-shrink-0" aria-hidden="true"></span>
                        </a>
                      ) : (
                        <Text size="small">{item.name}</Text>
                      )}
                    </li>
                  ))}
                </ul>
              </Stack>
            </Surface>
          )
        }

        <Surface as="article" tone="light-raised" border="light" radius="lg" shadow="md" padding="none" class="xp-longform-prose uno-min-w-0 uno-p-5 md:uno-p-8 lg:uno-p-10">
          <slot />
        </Surface>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>('.xp-longform-prose table')) {
    table.tabIndex = 0;
  }
</script>

<style is:global>
  .xp-longform-prose {
    background: var(--xp-surface-light-raised);
    color: var(--xp-text-on-light-muted);
    color-scheme: light;
    font-size: var(--xp-type-body);
    line-height: 1.75;
  }

  .xp-longform-prose :where(h2, h3, h4, h5, h6) {
    color: var(--xp-text-on-light);
    scroll-margin-top: 6rem;
  }

  .xp-longform-prose h2 {
    margin: 3.5rem 0 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(17 24 39 / 0.12);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .xp-longform-prose h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .xp-longform-prose h3 {
    margin: 2.25rem 0 0.9rem;
    font-size: clamp(1.3rem, 3vw, 1.5rem);
  }

  .xp-longform-prose h4 {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.125rem;
  }

  .xp-longform-prose :where(p, ul, ol, table, pre, blockquote) {
    margin: 0 0 1.25rem;
  }

  .xp-longform-prose :where(ul, ol) {
    padding-left: 1.5rem;
  }

  .xp-longform-prose :where(ul, ol) :where(ul, ol) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .xp-longform-prose li + li {
    margin-top: 0.35rem;
  }

  .xp-longform-prose strong {
    color: var(--xp-text-on-light);
  }

  .xp-longform-prose a {
    color: #365f18;
    font-weight: 600;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .xp-longform-prose a:hover {
    color: #284b10;
  }

  .xp-longform-prose table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-spacing: 0;
    border-collapse: collapse;
    font-size: 0.875rem;
    -webkit-overflow-scrolling: touch;
  }

  .xp-longform-prose :where(th, td) {
    min-width: 8rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgb(17 24 39 / 0.14);
    text-align: left;
    vertical-align: top;
  }

  .xp-longform-prose th {
    background: var(--xp-surface-2);
    color: var(--xp-text-primary);
  }

  .xp-longform-prose th strong {
    color: inherit;
  }

  .xp-longform-prose tbody tr:nth-child(even) {
    background: rgb(81 96 112 / 0.06);
  }

  .xp-longform-prose :where(code, kbd) {
    border-radius: var(--xp-radius-sm);
    background: rgb(20 34 56 / 0.10);
    color: var(--xp-text-on-light);
    font-family: var(--xp-font-mono);
    font-size: 0.9em;
  }

  .xp-longform-prose code {
    padding: 0.12em 0.3em;
  }

  .xp-longform-prose pre {
    max-width: 100%;
    overflow-x: auto;
    border-radius: var(--xp-radius-md);
    background: var(--xp-surface-1);
    color: var(--xp-text-secondary);
    padding: 1rem;
  }

  .xp-longform-prose pre code {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  .xp-longform-prose blockquote {
    margin-left: 0;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 4px solid var(--xp-accent-primary-active);
  }

  .xp-longform-prose #safety-governance {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid rgb(111 168 50 / 0.45);
    border-radius: var(--xp-radius-md);
    background: #f1f7e9;
  }

  .xp-longform-prose #safety-governance h3 {
    margin-top: 0;
  }

  .xp-longform-prose #safety-governance > :last-child {
    margin-bottom: 0;
  }

  @media (max-width: 63.999rem) {
    .xp-longform-resources {
      position: static;
    }
  }
</style>
