---
import Footer from '../components/legacy/Footer.astro';
import Header from '../components/legacy/Header.astro';
import SearchDialog from '../components/search/SearchDialog.astro';
import {siteMetadata} from '../data/site';
import {searchAliasesForText, sectionForPath} from '../data/search';
import 'uno.css';
import '../styles/legacy.scss';
import '../styles/expressive-code.css';

type Props = {
  title: string;
  description?: string;
  summary?: string;
  keywords?: string[];
  canonicalUrl?: string;
  socialImage?: string;
  image?: string;
  hasAside?: boolean;
  robots?: string;
  bodyClass?: string;
  flushMain?: boolean;
  overlayHeader?: boolean;
};

const {
  title,
  description,
  summary,
  keywords = [],
  canonicalUrl,
  socialImage,
  image,
  hasAside = false,
  robots = 'index, follow',
  bodyClass = '',
  flushMain = false,
  overlayHeader = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL('https://beta.xenproject.org');
const pageTitle = currentPath === '/'
  ? `${siteMetadata.title} - Open Source Virtualization`
  : `${title} | ${siteMetadata.title}`;
const resolvedDescription = description || summary || siteMetadata.description;
const resolvedCanonicalUrl = new URL(canonicalUrl || currentPath, siteUrl).toString();
const resolvedSocialImage = new URL(socialImage || image || siteMetadata.socialImage, siteUrl).toString();
const searchSection = sectionForPath(currentPath);
const searchAliases = searchAliasesForText(`${title}\n${resolvedDescription}\n${keywords.join(' ')}`);
const shouldIndex = !robots.toLowerCase().includes('noindex') && currentPath !== '/search/';
---

<!doctype html>
<html lang="en-us" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} data-pagefind-meta="description[content]" />
    <meta content={title} data-pagefind-meta="title[content]" />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',  ')} data-pagefind-meta="keywords[content]" />}
    {searchAliases.length > 0 && <meta content={searchAliases.join(', ')} data-pagefind-meta="aliases[content]" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolvedCanonicalUrl} data-pagefind-meta="canonical[href]" />
    <link rel="stylesheet" href="/font-awesomepro/fontawesome.css" />
    <link rel="stylesheet" href="/font-awesomepro/regular.css" />
    <link rel="stylesheet" href="/font-awesomepro/solid.css" />
    <link rel="stylesheet" href="/font-awesomepro/brands.css" />
  </head>
  <body class:list={[bodyClass, flushMain && 'layout-main-flush', overlayHeader && 'layout-header-overlay']}>
    <Header currentPath={currentPath} />
    <main
      class:list={['main', hasAside && 'has-aside']}
      data-pagefind-body={shouldIndex ? true : undefined}
      data-pagefind-ignore={!shouldIndex ? true : undefined}
      data-search-section={searchSection}
      data-search-content-type="Website"
      data-pagefind-meta="section[data-search-section], contentType[data-search-content-type]"
      data-pagefind-filter="section[data-search-section], contentType[data-search-content-type]"
    >
      <slot />
    </main>
    <Footer currentPath={currentPath} />
    <SearchDialog />
    <script>
      import '../scripts/menu.js';
      import '../scripts/animate.js';
    </script>
    <style is:global>
      body.layout-main-flush > main.main { padding-top: 0; }
      body.layout-header-overlay > header.header { position: absolute; inset: 0 0 auto; z-index: 20; }
    </style>
  </body>
</html>
