---
import {siteMetadata} from '../data/site';
import SiteFooter from '../components/blocks/SiteFooter.astro';
import SiteHeader from '../components/blocks/SiteHeader.astro';
import 'uno.css';
import '../styles/foundation/base.css';
import '../styles/expressive-code.css';

type Props = {
  title: string;
  description?: string;
  summary?: string;
  keywords?: string[];
  canonicalUrl?: string;
  socialImage?: string;
  image?: string;
  robots?: string;
  bodyClass?: string;
  publicShell?: boolean;
};

const {
  title,
  description,
  summary,
  keywords = [],
  canonicalUrl,
  socialImage,
  image,
  robots = 'index, follow',
  bodyClass = '',
  publicShell = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL('https://beta.xenproject.org');
const pageTitle = currentPath === '/'
  ? `${siteMetadata.title} - Open Source Virtualization`
  : `${title} | ${siteMetadata.title}`;
const resolvedDescription = description || summary || siteMetadata.description;
const resolvedCanonicalUrl = new URL(canonicalUrl || currentPath, siteUrl).toString();
const resolvedSocialImage = new URL(socialImage || image || siteMetadata.socialImage, siteUrl).toString();
---

<!doctype html>
<html lang="en-us" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',  ')} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
  </head>
  <body class:list={['xp-site', bodyClass]}>
    {publicShell ? (
      <>
        <SiteHeader currentPath={currentPath} />
        <main id="main-content">
          <slot />
        </main>
        <SiteFooter currentPath={currentPath} />
      </>
    ) : (
      <slot />
    )}
  </body>
</html>
