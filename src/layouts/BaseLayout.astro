---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {siteMetadata} from '../data/site';
import 'uno.css';
import '../../themes/xen-project/assets/css/main.scss';

type Props = {
  title: string;
  description?: string;
  summary?: string;
  keywords?: string[];
  canonicalUrl?: string;
  socialImage?: string;
  image?: string;
  hasAside?: boolean;
  robots?: string;
  bodyClass?: string;
  flushMain?: boolean;
  overlayHeader?: boolean;
};

const {
  title,
  description,
  summary,
  keywords = [],
  canonicalUrl,
  socialImage,
  image,
  hasAside = false,
  robots = 'index, follow',
  bodyClass = '',
  flushMain = false,
  overlayHeader = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL('https://beta.xenproject.org');
const pageTitle = currentPath === '/'
  ? `${siteMetadata.title} - Open Source Virtualization`
  : `${title} | ${siteMetadata.title}`;
const resolvedDescription = description || summary || siteMetadata.description;
const resolvedCanonicalUrl = new URL(canonicalUrl || currentPath, siteUrl).toString();
const resolvedSocialImage = new URL(socialImage || image || siteMetadata.socialImage, siteUrl).toString();
---

<!doctype html>
<html lang="en-us" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',  ')} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={resolvedSocialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedSocialImage} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <link rel="stylesheet" href="/font-awesomepro/fontawesome.css" />
    <link rel="stylesheet" href="/font-awesomepro/regular.css" />
    <link rel="stylesheet" href="/font-awesomepro/solid.css" />
    <link rel="stylesheet" href="/font-awesomepro/brands.css" />
  </head>
  <body class:list={[bodyClass, flushMain && 'layout-main-flush', overlayHeader && 'layout-header-overlay']}>
    <Header currentPath={currentPath} />
    <main class:list={['main', hasAside && 'has-aside']}>
      <slot />
    </main>
    <Footer currentPath={currentPath} />
    <script>
      import '../../themes/xen-project/assets/js/menu.js';
      import '../../themes/xen-project/assets/js/animate.js';
    </script>
    <style is:global>
      body.layout-main-flush > main.main { padding-top: 0; }
      body.layout-header-overlay > header.header { position: absolute; inset: 0 0 auto; z-index: 20; }
    </style>
  </body>
</html>
