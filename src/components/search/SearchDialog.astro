---
import '../../styles/foundation/tokens.css';
---

<dialog class="xp-search-dialog uno-overflow-hidden uno-border uno-border-solid uno-border-[var(--xp-border-layered-popover)] uno-bg-[rgb(11_19_32_/_0.98)] uno-p-0 uno-text-xp-text-primary uno-shadow-xp-lg" data-search-dialog aria-labelledby="xp-search-title">
  <div class="xp-search-shell uno-grid uno-grid-rows-[auto_auto_auto_auto_minmax(0,1fr)_auto]">
    <header class="xp-search-header uno-flex uno-items-center uno-justify-between uno-gap-4 uno-border-0 uno-border-b uno-border-solid uno-border-xp-border-muted uno-px-4 uno-py-[1.15rem] sm:uno-px-5">
      <div class="uno-flex uno-items-center uno-gap-[.8rem]">
        <span class="i-carbon-search uno-h-5 uno-w-5 uno-text-xp-accent-primary" aria-hidden="true"></span>
        <div>
          <p class="uno-m-0 uno-font-mono uno-text-[.68rem] uno-font-semibold uno-leading-none uno-tracking-[.12em] uno-text-xp-text-muted uno-uppercase">Xen Project</p>
          <h2 id="xp-search-title" class="uno-m-0 uno-mt-[.1rem] uno-font-sans uno-text-[1.1rem] uno-font-bold uno-leading-[1.2] uno-text-xp-text-primary">Search the site</h2>
        </div>
      </div>
      <button type="button" class="xen-focus uno-inline-grid uno-h-11 uno-w-11 uno-shrink-0 uno-cursor-pointer uno-place-items-center uno-rounded-xp-md uno-border uno-border-solid uno-border-xp-border-muted uno-bg-xp-surface-2 uno-p-0 uno-text-xp-text-primary" data-search-close aria-label="Close search">
        <span class="i-carbon-close uno-h-[1.1rem] uno-w-[1.1rem]" aria-hidden="true"></span>
      </button>
    </header>

    <div class="xp-search-input-wrap uno-mx-4 uno-mb-[.6rem] uno-mt-4 uno-grid uno-grid-cols-[auto_minmax(0,1fr)_auto] uno-items-center uno-gap-3 uno-rounded-xp-md uno-border uno-border-solid uno-border-xp-border-strong uno-bg-xp-surface-0 uno-px-[.9rem] uno-shadow-[0_0_0_0_transparent] uno-transition-[border-color,box-shadow] uno-duration-[var(--xp-motion-fast)] focus-within:uno-border-xp-accent-primary focus-within:uno-shadow-[0_0_0_3px_var(--xp-accent-primary-soft)] sm:uno-mx-5">
      <span class="i-carbon-search uno-h-5 uno-w-5 uno-text-xp-text-muted" aria-hidden="true"></span>
      <!-- The important modifier beats `.xp-site :focus-visible`, leaving the rounded wrapper as the single focus ring. Remove it if the global selector's specificity is lowered. -->
      <input
        type="search"
        class="xp-search-input uno-h-14 uno-min-w-0 uno-border-0 uno-bg-transparent uno-font-sans uno-text-base uno-font-medium uno-leading-[1.3] uno-text-xp-text-primary uno-outline-none! placeholder:uno-text-xp-text-muted"
        data-search-input
        autofocus
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        enterkeyhint="search"
        placeholder="Search documentation, releases, community, and blog…"
        aria-label="Search Xen Project"
        aria-controls="xp-search-results"
        aria-autocomplete="list"
      />
      <kbd class="xen-search-key uno-hidden sm:uno-inline">Esc</kbd>
    </div>

    <p class="xp-search-status uno-m-0 uno-px-4 uno-pb-3 uno-pt-2 uno-font-sans uno-text-[.8rem] uno-font-normal uno-leading-[1.4] uno-text-xp-text-muted sm:uno-px-5" data-search-status role="status" aria-live="polite">
      Enter at least two characters to search the Xen Project website and blog.
    </p>
    <div class="xp-search-filters uno-mx-4 uno-mb-3 uno-hidden uno-items-center uno-gap-2 uno-overflow-x-auto sm:uno-mx-5" data-search-filters role="group" aria-label="Filter search results by source">
      <button type="button" class="xen-focus uno-cursor-pointer uno-rounded-full uno-border uno-border-solid uno-border-xp-border-muted uno-bg-transparent uno-px-3 uno-py-1.5 uno-font-sans uno-text-xs uno-font-semibold uno-text-xp-text-secondary uno-transition-[color,border-color,background-color] uno-duration-[var(--xp-motion-fast)] hover:uno-border-xp-border-strong hover:uno-text-xp-text-primary" data-search-filter="All" aria-pressed="true">All</button>
      <button type="button" class="xen-focus uno-cursor-pointer uno-rounded-full uno-border uno-border-solid uno-border-xp-border-muted uno-bg-transparent uno-px-3 uno-py-1.5 uno-font-sans uno-text-xs uno-font-semibold uno-text-xp-text-secondary uno-transition-[color,border-color,background-color] uno-duration-[var(--xp-motion-fast)] hover:uno-border-xp-border-strong hover:uno-text-xp-text-primary" data-search-filter="Website" aria-pressed="false"><span class="i-carbon-document uno-mr-1 uno-align-[-.12em]" aria-hidden="true"></span>Website</button>
      <button type="button" class="xen-focus uno-cursor-pointer uno-rounded-full uno-border uno-border-solid uno-border-xp-border-muted uno-bg-transparent uno-px-3 uno-py-1.5 uno-font-sans uno-text-xs uno-font-semibold uno-text-xp-text-secondary uno-transition-[color,border-color,background-color] uno-duration-[var(--xp-motion-fast)] hover:uno-border-xp-border-strong hover:uno-text-xp-text-primary" data-search-filter="Blog" aria-pressed="false"><span class="i-carbon-notebook uno-mr-1 uno-align-[-.12em]" aria-hidden="true"></span>Blog</button>
    </div>
    <ol id="xp-search-results" class="xp-search-results uno-m-0 uno-min-h-0 uno-list-none uno-overflow-y-auto uno-overscroll-contain uno-px-2 uno-pb-3 sm:uno-min-h-20 sm:uno-px-3" data-search-results role="listbox" aria-label="Search results"></ol>

    <footer class="xp-search-footer uno-hidden uno-gap-[1.1rem] uno-border-0 uno-border-t uno-border-solid uno-border-xp-border-muted uno-px-5 uno-pt-3 uno-font-sans uno-text-[.7rem] uno-font-medium uno-leading-[1.3] uno-text-xp-text-muted sm:uno-flex" aria-hidden="true">
      <span class="uno-inline-flex uno-items-center uno-gap-[.3rem]"><kbd class="xen-search-key">↑</kbd><kbd class="xen-search-key">↓</kbd> Navigate</span>
      <span class="uno-inline-flex uno-items-center uno-gap-[.3rem]"><kbd class="xen-search-key">↵</kbd> Open</span>
      <span class="uno-inline-flex uno-items-center uno-gap-[.3rem]"><kbd class="xen-search-key">Esc</kbd> Close</span>
    </footer>
  </div>
</dialog>

<script>
  import {promotedUrlsForQuery} from '../../data/search';

  type PagefindResultData = {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    score?: number;
  };
  type PagefindResult = {id: string; score: number; data: () => Promise<PagefindResultData>};
  type PagefindFilterCounts = Record<string, Record<string, number>>;
  type PagefindResponse = {
    results: PagefindResult[];
    unfilteredResultCount?: number;
    filters?: PagefindFilterCounts;
    totalFilters?: PagefindFilterCounts;
  };
  type PagefindApi = {
    init: () => Promise<void>;
    options: (options: Record<string, unknown>) => Promise<void>;
    filters: () => Promise<PagefindFilterCounts>;
    search: (query: string, options?: {filters?: Record<string, string>}) => Promise<PagefindResponse>;
  };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
  const results = dialog?.querySelector<HTMLOListElement>('[data-search-results]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const filterBar = dialog?.querySelector<HTMLElement>('[data-search-filters]');
  const filterButtons = [...(filterBar?.querySelectorAll<HTMLButtonElement>('[data-search-filter]') ?? [])];
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-search-open]')];
  let pagefind: PagefindApi | undefined;
  let pagefindPromise: Promise<PagefindApi> | undefined;
  let opener: HTMLElement | undefined;
  let activeIndex = -1;
  let requestNumber = 0;
  let lockedScrollY = 0;
  let selectedContentType = 'All';
  const visualViewport = globalThis.visualViewport;
  const mobileDialogQuery = globalThis.matchMedia('(max-width: 40rem)');

  const isTypingTarget = (target: EventTarget | null) => {
    if (!(target instanceof HTMLElement)) return false;
    return target.matches('input, textarea, select, [contenteditable="true"]') || target.isContentEditable;
  };

  const setStatus = (message: string) => {
    if (status) status.textContent = message;
  };

  const lockScroll = () => {
    lockedScrollY = globalThis.scrollY;
    document.body.dataset.searchScrollLock = 'true';
    document.body.style.top = `-${lockedScrollY}px`;
  };

  const unlockScroll = () => {
    if (document.body.dataset.searchScrollLock !== 'true') return;
    delete document.body.dataset.searchScrollLock;
    document.body.style.top = '';
    globalThis.scrollTo(0, lockedScrollY);
  };

  const resetDialogViewport = () => {
    dialog?.style.removeProperty('--xp-search-viewport-height');
    dialog?.style.removeProperty('--xp-search-viewport-top');
  };

  const syncDialogViewport = () => {
    if (!dialog?.open || !visualViewport || !mobileDialogQuery.matches) {
      resetDialogViewport();
      return;
    }
    dialog.style.setProperty('--xp-search-viewport-height', `${Math.round(visualViewport.height)}px`);
    dialog.style.setProperty('--xp-search-viewport-top', `${Math.round(visualViewport.offsetTop)}px`);
  };

  const loadSourceFilters = async (api: PagefindApi) => {
    const availableFilters = await api.filters();
    const sourceCounts = availableFilters.contentType ?? {};
    const hasWebsite = (sourceCounts.Website ?? 0) > 0;
    const hasBlog = (sourceCounts.Blog ?? 0) > 0;
    filterBar?.classList.toggle('uno-flex', hasWebsite && hasBlog);
    filterBar?.classList.toggle('uno-hidden', !(hasWebsite && hasBlog));
  };

  const loadPagefind = async (): Promise<PagefindApi> => {
    if (pagefind) return pagefind;
    if (pagefindPromise) return pagefindPromise;
    pagefindPromise = (async () => {
      const pagefindPath = '/pagefind/pagefind.js';
      const module = await import(/* @vite-ignore */ pagefindPath) as PagefindApi;
      await module.options({
        excerptLength: 24,
        ranking: {
          metaWeights: {title: 8, description: 2, keywords: 1.5, aliases: 1.5, section: 0},
        },
      });
      await module.init();
      pagefind = module;
      void loadSourceFilters(module).catch(() => undefined);
      return module;
    })().catch((error: unknown) => {
      pagefindPromise = undefined;
      setStatus('Search is unavailable because its local index could not be loaded. Try running npm run build.');
      throw error instanceof Error ? error : new Error('Pagefind assets are unavailable.');
    });
    return pagefindPromise;
  };

  const openSearch = (trigger?: HTMLElement) => {
    if (!dialog || dialog.open) return;
    opener = trigger ?? document.activeElement as HTMLElement;
    dialog.showModal();
    lockScroll();
    syncDialogViewport();
    input?.focus({preventScroll: true});
    globalThis.requestAnimationFrame(() => {
      syncDialogViewport();
      if (document.activeElement !== input) input?.focus({preventScroll: true});
    });
    void loadPagefind().catch(() => undefined);
  };

  const closeSearch = () => dialog?.close();

  const updateActiveResult = (nextIndex: number) => {
    const links = [...(results?.querySelectorAll<HTMLAnchorElement>('a[data-search-result]') ?? [])];
    if (links.length === 0) {
      activeIndex = -1;
      input?.removeAttribute('aria-activedescendant');
      return;
    }
    activeIndex = (nextIndex + links.length) % links.length;
    links.forEach((link, index) => {
      const active = index === activeIndex;
      link.toggleAttribute('data-active', active);
      link.parentElement?.setAttribute('aria-selected', String(active));
      if (active) {
        input?.setAttribute('aria-activedescendant', link.parentElement?.id ?? '');
        link.scrollIntoView({block: 'nearest'});
      }
    });
  };

  const formatDate = (value?: string) => {
    if (!value) return '';
    const date = new Date(value);
    return Number.isNaN(date.valueOf()) ? '' : new Intl.DateTimeFormat('en', {month: 'short', year: 'numeric'}).format(date);
  };

  const escapeHtml = (value: string) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

  const canonicalResultKey = (value: string) => {
    const url = new URL(value, globalThis.location.origin);
    url.search = '';
    url.hash = '';
    let pathname = url.pathname.replace(/\/index\.html$/, '/');
    if (!pathname.endsWith('/') && !/\.[a-z0-9]+$/i.test(pathname)) pathname += '/';
    return pathname;
  };

  const deduplicateResults = (items: PagefindResultData[]) => {
    const seen = new Set<string>();
    return items.filter((item) => {
      const key = canonicalResultKey(item.meta.canonical || item.url);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  };

  const applyPromotedOrder = (items: PagefindResultData[], query: string) => {
    const priorities = new Map(
      promotedUrlsForQuery(query).map((url, index) => [canonicalResultKey(url), index]),
    );
    if (priorities.size === 0) return items;
    return items
      .map((item, index) => ({
        item,
        index,
        priority: priorities.get(canonicalResultKey(item.meta.canonical || item.url)) ?? Number.MAX_SAFE_INTEGER,
      }))
      .sort((left, right) => left.priority - right.priority || left.index - right.index)
      .map(({item}) => item);
  };

  const updateFilterButtons = () => {
    for (const button of filterButtons) {
      const active = button.dataset.searchFilter === selectedContentType;
      button.setAttribute('aria-pressed', String(active));
    }
  };

  const renderResults = (items: PagefindResultData[]) => {
    if (!results) return;
    results.innerHTML = items.map((item, index) => {
      const contentType = item.meta.contentType || (item.url.startsWith('/blog/') ? 'Blog' : 'Website');
      const section = item.meta.section || item.meta.contentType || 'Website';
      const date = formatDate(item.meta.published);
      const excerpt = item.excerpt || escapeHtml(item.meta.excerpt ?? '');
      const sourceLabel = contentType === 'Blog' ? 'Xen Project Blog' : 'Xen Project website';
      const sourceIcon = contentType === 'Blog' ? 'i-carbon-notebook' : 'i-carbon-document';
      return `<li id="xp-search-result-${index}" class="uno-m-0 uno-p-0" role="option" aria-selected="false">
        <a href="${escapeHtml(item.url)}" data-search-result data-search-source="${escapeHtml(contentType)}" data-search-score="${item.score ?? 0}" class="xen-focus xp-search-result-card uno-relative uno-grid uno-gap-[.38rem] uno-overflow-hidden uno-rounded-xp-md uno-border uno-border-solid uno-border-xp-border-muted uno-bg-[rgb(20_34_56_/_0.34)] uno-py-[.9rem] uno-pl-6 uno-pr-3 uno-text-xp-text-secondary uno-no-underline uno-shadow-[var(--xp-inner-highlight)] uno-transition-[background-color,border-color,transform,box-shadow] uno-duration-[var(--xp-motion-fast)]">
          <span class="xp-search-result-meta uno-flex uno-flex-wrap uno-items-center uno-gap-x-[.55rem] uno-gap-y-[.4rem] uno-font-mono uno-text-[.68rem] uno-font-semibold uno-leading-[1.3] uno-tracking-[.045em] uno-text-xp-text-muted uno-uppercase">
            <span class="xp-search-result-source uno-inline-flex uno-items-center uno-gap-[.3rem] uno-text-xp-text-primary"><span class="${sourceIcon} uno-h-[.85rem] uno-w-[.85rem]" aria-hidden="true"></span>${escapeHtml(sourceLabel)}</span>
            <span class="xp-search-result-section uno-rounded-full uno-border uno-border-solid uno-border-xp-border-muted uno-px-[.42rem] uno-py-[.12rem]">${escapeHtml(section)}</span>
            ${date ? `<time class="uno-text-xp-text-muted">${escapeHtml(date)}</time>` : ''}
          </span>
          <strong class="uno-font-sans uno-text-base uno-font-bold uno-leading-[1.3] uno-text-xp-text-primary">${escapeHtml(item.meta.title || item.url)}</strong>
          <span class="xp-search-excerpt uno-line-clamp-2 uno-overflow-hidden uno-font-sans uno-text-[.82rem] uno-font-normal uno-leading-[1.5] uno-text-xp-text-secondary">${excerpt}</span>
          <span class="xp-search-url uno-overflow-hidden uno-text-ellipsis uno-whitespace-nowrap uno-font-mono uno-text-[.69rem] uno-font-medium uno-leading-[1.4] uno-text-xp-text-muted">${escapeHtml(item.url)}</span>
        </a>
      </li>`;
    }).join('');
    activeIndex = -1;
  };

  const performSearch = async () => {
    const query = input?.value.trim() ?? '';
    const thisRequest = ++requestNumber;
    if (query.length < 2) {
      if (results) results.innerHTML = '';
      setStatus('Enter at least two characters to search the Xen Project website and blog.');
      return;
    }
    setStatus('Searching…');
    try {
      const api = await loadPagefind();
      const response = await api.search(query, selectedContentType === 'All'
        ? undefined
        : {filters: {contentType: selectedContentType}});
      if (thisRequest !== requestNumber) return;
      const candidateLimit = promotedUrlsForQuery(query).length > 0 ? 48 : 24;
      const candidates = deduplicateResults(await Promise.all(response.results.slice(0, candidateLimit).map(async result => ({
        ...await result.data(),
        score: result.score,
      }))));
      const loaded = applyPromotedOrder(candidates, query).slice(0, 12);
      if (thisRequest !== requestNumber) return;
      renderResults(loaded);
      const resultCount = response.results.length;
      const sourceSuffix = selectedContentType === 'All' ? '' : ` in ${selectedContentType}`;
      setStatus(loaded.length === 0 ? `No results found for “${query}”${sourceSuffix}.` : `${resultCount} result${resultCount === 1 ? '' : 's'} found for “${query}”${sourceSuffix}.`);
    } catch {
      if (thisRequest === requestNumber) {
        if (results) results.innerHTML = '';
        setStatus('Search is temporarily unavailable. The Pagefind index may not have been generated yet.');
      }
    }
  };

  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  input?.addEventListener('input', () => {
    globalThis.clearTimeout(debounceTimer);
    debounceTimer = globalThis.setTimeout(() => void performSearch(), 120);
  });
  input?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      event.preventDefault();
      closeSearch();
    } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      updateActiveResult(activeIndex + (event.key === 'ArrowDown' ? 1 : -1));
    } else if (event.key === 'Enter' && activeIndex >= 0) {
      event.preventDefault();
      results?.querySelectorAll<HTMLAnchorElement>('a[data-search-result]')[activeIndex]?.click();
    }
  });

  for (const button of filterButtons) {
    button.addEventListener('click', () => {
      selectedContentType = button.dataset.searchFilter ?? 'All';
      updateFilterButtons();
      void performSearch();
    });
  }

  results?.addEventListener('pointermove', event => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-search-result]');
    if (!link) return;
    updateActiveResult([...results.querySelectorAll('a[data-search-result]')].indexOf(link));
  });
  dialog?.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);
  dialog?.addEventListener('click', event => {
    if (event.target === dialog) closeSearch();
  });
  dialog?.addEventListener('close', () => {
    resetDialogViewport();
    unlockScroll();
    opener?.focus({preventScroll: true});
  });
  visualViewport?.addEventListener('resize', syncDialogViewport, {passive: true});
  visualViewport?.addEventListener('scroll', syncDialogViewport, {passive: true});
  mobileDialogQuery.addEventListener('change', syncDialogViewport);
  for (const trigger of triggers) trigger.addEventListener('click', () => openSearch(trigger));
  document.addEventListener('keydown', event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k' && !isTypingTarget(event.target)) {
      event.preventDefault();
      openSearch();
    }
  });
</script>

<style is:global>
  body[data-search-scroll-lock='true'] { position: fixed; left: 0; right: 0; width: 100%; overflow: hidden; }
  .xp-search-dialog { width: min(46rem, calc(100vw - 2rem)); max-height: min(48rem, calc(100dvh - 2rem)); margin: max(1rem, 8dvh) auto auto; padding: 0; border: 1px solid var(--xp-border-layered-popover); border-radius: var(--xp-radius-lg); background: rgb(11 19 32 / 0.98); color: var(--xp-text-primary); box-shadow: var(--xp-shadow-lg); overflow: hidden; opacity: 0; transform: translateY(-0.5rem) scale(0.985); transition: opacity var(--xp-motion-base) var(--xp-ease-standard), transform var(--xp-motion-base) var(--xp-ease-standard), overlay var(--xp-motion-base) allow-discrete, display var(--xp-motion-base) allow-discrete; z-index: var(--xp-z-modal); }
  .xp-search-dialog[open] { opacity: 1; transform: none; }
  @starting-style { .xp-search-dialog[open] { opacity: 0; transform: translateY(-0.5rem) scale(0.985); } }
  .xp-search-dialog::backdrop { background: rgb(1 4 9 / 0.72); backdrop-filter: blur(5px); opacity: 1; transition: opacity var(--xp-motion-base) var(--xp-ease-standard); }
  .xp-search-shell { max-height: min(48rem, calc(100dvh - 2rem)); }
  .xp-search-filters button[aria-pressed='true'] { border-color: var(--xp-accent-primary); background: var(--xp-accent-primary-soft); color: var(--xp-text-primary); }
  .xp-search-result-card::before { content: ''; position: absolute; inset-block: .65rem; left: .55rem; width: 3px; border-radius: 999px; background: var(--xp-search-result-accent); box-shadow: 0 0 12px var(--xp-search-result-accent-soft); }
  .xp-search-result-card[data-search-source='Website'] { --xp-search-result-accent: var(--xp-accent-secondary); --xp-search-result-accent-soft: var(--xp-accent-secondary-soft); }
  .xp-search-result-card[data-search-source='Blog'] { --xp-search-result-accent: var(--xp-accent-primary); --xp-search-result-accent-soft: var(--xp-accent-primary-soft); }
  .xp-search-result-card:hover, .xp-search-result-card[data-active] { border-color: var(--xp-border-strong); background: var(--xp-surface-2); color: var(--xp-text-primary); box-shadow: var(--xp-shadow-sm); transform: translateY(-1px); }
  .xp-search-excerpt mark { border-radius: .15rem; background: rgb(133 194 65 / .28); color: var(--xp-text-primary); padding: 0 .08em; }
  .xp-search-results { scrollbar-color: var(--xp-border-strong) transparent; scrollbar-width: thin; }
  .xp-search-results::-webkit-scrollbar { width: .4rem; }
  .xp-search-results::-webkit-scrollbar-track { background: transparent; }
  .xp-search-results::-webkit-scrollbar-thumb { border-radius: 999px; background: var(--xp-border-strong); }
  .xp-search-footer { padding-bottom: max(.75rem, env(safe-area-inset-bottom)); }
  @media (max-width: 40rem) {
    .xp-search-dialog { position: fixed; top: var(--xp-search-viewport-top, 0); right: 0; bottom: auto; left: 0; width: 100vw; max-width: none; height: var(--xp-search-viewport-height, 100dvh); max-height: var(--xp-search-viewport-height, 100dvh); margin: 0; border-width: 0; border-radius: 0; }
    .xp-search-shell { max-height: 100%; height: 100%; padding-top: env(safe-area-inset-top); }
    .xp-search-filters { scrollbar-width: none; }
    .xp-search-filters::-webkit-scrollbar { display: none; }
    .xp-search-filters button { flex: 0 0 auto; }
    .xp-search-results { padding-bottom: max(.75rem, env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .xp-search-dialog, .xp-search-dialog::backdrop, .xp-search-input-wrap, .xp-search-filters button, .xp-search-result-card { transition: none; }
    .xp-search-result-card:hover, .xp-search-result-card[data-active] { transform: none; }
  }
</style>
