---
import Surface from '../../primitives/Surface.astro';
---

<Surface
  as="aside"
  tone="2"
  border="muted"
  radius="lg"
  shadow="none"
  padding="lg"
  class="xp-platform-diagram lg:uno-ml-auto lg:uno-max-w-[38rem]"
  aria-labelledby="platform-layers-title"
>
  <div class="xp-platform-diagram__grid" aria-hidden="true"></div>
  <div class="xp-platform-diagram__header">
    <span id="platform-layers-title" class="xp-platform-diagram__eyebrow">Platform layers</span>
    <span class="i-carbon-car uno-text-3xl uno-text-xp-accent-primary" aria-hidden="true"></span>
  </div>

  <div class="xp-platform-stack" role="group" aria-label="Guest systems sit above Xen, and Xen sits above hardware.">
    <section class="xp-layer-plane xp-layer-plane--guests" aria-labelledby="guest-domains-title">
      <span class="xp-layer-plane__mark xp-layer-plane__mark--start" aria-hidden="true"></span>
      <span class="xp-layer-plane__mark xp-layer-plane__mark--end" aria-hidden="true"></span>
      <h3 id="guest-domains-title" class="xp-layer-plane__title">Guest domains</h3>
      <ul class="xp-domain-list" aria-label="Guest domain examples">
        <li class="xp-layer-chip">Linux</li>
        <li class="xp-layer-chip">RTOS</li>
        <li class="xp-layer-chip">Services</li>
      </ul>
    </section>

    <div class="xp-platform-connector" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <section class="xp-layer-plane xp-layer-plane--xen" aria-labelledby="xen-boundary-title">
      <span class="xp-layer-plane__mark xp-layer-plane__mark--start" aria-hidden="true"></span>
      <span class="xp-layer-plane__mark xp-layer-plane__mark--end" aria-hidden="true"></span>
      <h3 id="xen-boundary-title" class="xp-layer-plane__title">Xen hypervisor boundary</h3>
      <ul class="xp-capability-list" aria-label="Xen boundary responsibilities">
        <li>isolation</li>
        <li>scheduling</li>
        <li>device assignment</li>
        <li>platform control</li>
      </ul>
    </section>

    <div class="xp-platform-connector" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <section class="xp-layer-plane xp-layer-plane--hardware" aria-labelledby="hardware-platform-title">
      <span class="xp-layer-plane__mark xp-layer-plane__mark--start" aria-hidden="true"></span>
      <span class="xp-layer-plane__mark xp-layer-plane__mark--end" aria-hidden="true"></span>
      <span class="xp-hardware-trace xp-hardware-trace--one" aria-hidden="true"></span>
      <span class="xp-hardware-trace xp-hardware-trace--two" aria-hidden="true"></span>
      <h3 id="hardware-platform-title" class="xp-layer-plane__title">Hardware platform</h3>
      <ul class="xp-capability-list xp-capability-list--hardware" aria-label="Hardware platform responsibilities">
        <li>compute</li>
        <li>memory</li>
        <li>interrupts</li>
        <li>devices</li>
        <li>long-lived product integration</li>
      </ul>
    </section>
  </div>
</Surface>

<style>
  :global(.xp-platform-diagram) {
    --diagram-blue: rgb(42 153 255);
    --diagram-cyan: rgb(96 202 255);
    --diagram-green: rgb(133 194 65);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-color: rgb(108 166 220 / 0.18);
    background:
      linear-gradient(150deg, rgb(255 255 255 / 0.032), transparent 42%),
      radial-gradient(circle at 82% 12%, rgb(42 153 255 / 0.09), transparent 30%),
      radial-gradient(circle at 18% 88%, rgb(133 194 65 / 0.055), transparent 34%),
      rgb(12 24 39 / 0.58);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.025) inset,
      0 1.1rem 2.1rem -1.65rem rgb(0 0 0 / 0.42);
  }

  .xp-platform-diagram__grid {
    position: absolute;
    inset: 0.6rem;
    z-index: -1;
    border-radius: calc(var(--xp-radius-lg) - 0.4rem);
    background-image:
      linear-gradient(rgb(138 190 232 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(138 190 232 / 0.045) 1px, transparent 1px);
    background-size: 2rem 2rem;
    mask-image: linear-gradient(135deg, transparent 2%, black 30%, black 68%, transparent 96%);
  }

  .xp-platform-diagram__header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgb(142 187 225 / 0.11);
  }

  .xp-platform-stack {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0;
    padding: 2rem 0.25rem 0.6rem;
  }

  .xp-layer-plane {
    position: relative;
    min-width: 0;
    padding: 1rem 1.15rem 1.05rem;
    border: 1px solid rgb(105 187 255 / 0.2);
    border-radius: 0.9rem;
    clip-path: polygon(4% 0, 100% 0, 96% 100%, 0 100%);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 1.1rem 1.6rem -1.35rem rgb(0 0 0 / 0.64);
  }

  .xp-layer-plane::before,
  .xp-layer-plane::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .xp-layer-plane::before {
    inset: 0.55rem 1.05rem auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(138 211 255 / 0.42), transparent);
  }

  .xp-layer-plane::after {
    inset: 0;
    border-radius: inherit;
    background-image:
      linear-gradient(90deg, transparent 0 0.9rem, rgb(255 255 255 / 0.055) 0.9rem 0.96rem, transparent 0.96rem),
      linear-gradient(transparent 0 1.55rem, rgb(255 255 255 / 0.04) 1.55rem 1.61rem, transparent 1.61rem);
    background-size: 4.4rem 3.4rem;
    opacity: 0.62;
  }

  .xp-layer-plane--guests {
    z-index: 3;
    width: 88%;
    margin-inline: auto 4%;
    background:
      linear-gradient(135deg, rgb(83 176 255 / 0.2), transparent 36%),
      linear-gradient(180deg, rgb(30 58 95 / 0.95), rgb(13 33 65 / 0.95));
    transform: translateX(-0.15rem) skewY(-2.8deg);
  }

  .xp-layer-plane--xen {
    z-index: 2;
    width: 94%;
    margin-inline: 2% auto;
    border-color: rgb(108 202 255 / 0.24);
    background:
      linear-gradient(125deg, rgb(42 153 255 / 0.2), transparent 38%),
      linear-gradient(180deg, rgb(20 47 77 / 0.96), rgb(10 30 53 / 0.96));
    transform: translateX(0.3rem) skewY(-1.8deg);
  }

  .xp-layer-plane--hardware {
    z-index: 1;
    width: 100%;
    border-color: rgb(133 194 65 / 0.24);
    background:
      radial-gradient(circle at 80% 68%, rgb(133 194 65 / 0.13), transparent 28%),
      linear-gradient(90deg, rgb(133 194 65 / 0.08) 1px, transparent 1px),
      linear-gradient(rgb(133 194 65 / 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgb(22 44 40 / 0.97), rgb(10 30 35 / 0.97));
    background-size: auto, 2rem 2rem, 2rem 2rem, auto;
    transform: skewY(-1deg);
  }

  .xp-platform-diagram__eyebrow {
    margin: 0;
    color: var(--xp-accent-primary);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .xp-layer-plane__title {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--xp-accent-primary);
    font-family: var(--xp-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .xp-layer-plane__mark {
    position: absolute;
    z-index: 1;
    width: 0.62rem;
    height: 0.62rem;
    border-color: rgb(141 207 255 / 0.5);
    pointer-events: none;
  }

  .xp-layer-plane__mark--start {
    top: 0.72rem;
    left: 0.78rem;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .xp-layer-plane__mark--end {
    right: 0.78rem;
    bottom: 0.72rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .xp-domain-list,
  .xp-capability-list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .xp-domain-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .xp-layer-chip,
  .xp-capability-list li {
    min-width: 0;
    border: 1px solid rgb(139 207 255 / 0.22);
    background: rgb(6 18 34 / 0.32);
    color: var(--xp-text-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .xp-layer-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    padding: 0.65rem 0.7rem;
    text-align: center;
    border-radius: 0.62rem;
  }

  .xp-capability-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.48rem 0.58rem;
    border-radius: 999px;
  }

  .xp-capability-list li::before {
    content: '';
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--diagram-cyan);
    opacity: 0.72;
  }

  .xp-capability-list--hardware li {
    border-color: rgb(149 213 86 / 0.24);
  }

  .xp-capability-list--hardware li::before {
    background: var(--diagram-green);
  }

  .xp-platform-connector {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(3, 1px);
    justify-content: center;
    gap: clamp(3.4rem, 16vw, 8rem);
    min-height: 2.45rem;
    margin: -0.18rem 0;
    transform: skewY(-1.6deg);
  }

  .xp-platform-connector span {
    position: relative;
    display: block;
    width: 1px;
    background: linear-gradient(180deg, rgb(104 194 255 / 0.08), rgb(104 194 255 / 0.46), rgb(133 194 65 / 0.24));
  }

  .xp-platform-connector span::before,
  .xp-platform-connector span::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 0.32rem;
    height: 0.32rem;
    border: 1px solid rgb(142 211 255 / 0.52);
    border-radius: 999px;
    background: rgb(13 30 50);
    transform: translateX(-50%);
  }

  .xp-platform-connector span::before {
    top: 0.24rem;
  }

  .xp-platform-connector span::after {
    bottom: 0.24rem;
  }

  .xp-hardware-trace {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    width: 5.4rem;
    height: 2.1rem;
    border: 1px solid rgb(133 194 65 / 0.28);
    border-left: 0;
    border-bottom: 0;
    pointer-events: none;
  }

  .xp-hardware-trace::after {
    content: '';
    position: absolute;
    right: -0.16rem;
    top: -0.16rem;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 999px;
    background: var(--diagram-green);
    opacity: 0.78;
  }

  .xp-hardware-trace--one {
    top: 1.05rem;
  }

  .xp-hardware-trace--two {
    right: 2.4rem;
    bottom: 1rem;
    width: 4.2rem;
    transform: rotate(180deg);
    opacity: 0.62;
  }

  @media (max-width: 639px) {
    :global(.xp-platform-diagram) {
      overflow: hidden;
    }

    .xp-platform-stack {
      padding-top: 1.35rem;
    }

    .xp-layer-plane,
    .xp-layer-plane--guests,
    .xp-layer-plane--xen,
    .xp-layer-plane--hardware {
      width: 100%;
      margin-inline: 0;
      clip-path: polygon(1.5% 0, 100% 0, 98.5% 100%, 0 100%);
      transform: skewY(-0.8deg);
    }

    .xp-domain-list {
      grid-template-columns: 1fr;
    }

    .xp-platform-connector {
      gap: clamp(2rem, 20vw, 4.6rem);
      min-height: 1.6rem;
      margin: -0.05rem 0;
      transform: none;
    }

    .xp-hardware-trace {
      opacity: 0.45;
    }
  }

  @media (max-width: 479px) {
    :global(.xp-platform-diagram) {
      padding: 1rem;
    }

    .xp-layer-plane {
      padding-inline: 0.9rem;
    }

    .xp-capability-list {
      gap: 0.42rem;
    }
  }

  @media print {
    :global(.xp-platform-diagram) {
      background: transparent;
      box-shadow: none;
    }

    .xp-platform-diagram__grid,
    .xp-layer-plane::before,
    .xp-layer-plane::after,
    .xp-layer-plane__mark,
    .xp-platform-connector,
    .xp-hardware-trace {
      display: none;
    }

    .xp-platform-stack {
      gap: 0.75rem;
      padding-top: 1rem;
    }

    .xp-layer-plane,
    .xp-layer-plane--guests,
    .xp-layer-plane--xen,
    .xp-layer-plane--hardware {
      width: 100%;
      margin-inline: 0;
      border: 1px solid #9ca3af;
      background: transparent;
      box-shadow: none;
      clip-path: none;
      transform: none;
    }
  }
</style>
