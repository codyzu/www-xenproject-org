---
import Layer from "../../diagrams/Layer.astro";

---

<div class="xp-platform-diagram lg:uno-ml-auto lg:uno-max-w-[40rem]">
  <div class="xp-platform-diagram__header">
    <p class="xp-platform-diagram__eyebrow">Platform layers</p>
    <span class="xp-platform-diagram__scale" aria-hidden="true">01 / 03</span>
  </div>

  <div class="xp-platform-stack">
    <Layer title="Applications">
      <p class="uno-font-bold">Applications running in user space</p>
    </Layer>
    <Layer title="Guest Systems">
      <p>Domains running operating systems with different hardware requirements</p>
    </Layer>
    <Layer title="Xen Hypervisor">
      <p>Isolation, scheduling, device assignment, and platform control decisions stay visible.</p>
    </Layer>
    <Layer title="Hardware">
      <p>Multi-core device specific SoC with hardware peripherals</p>
    </Layer>
    <div class="xp-plane xp-plane--guests">
      <div class="xp-plane__drafting" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="xp-plane__content">
        <p class="xp-plane__title">Guest domains</p>
        <div class="xp-domain-list">
          <span>
            <span class="xp-domain-module xp-domain-module--linux" aria-hidden="true"></span>
            <span>Linux</span>
          </span>
          <span>
            <span class="xp-domain-module xp-domain-module--rtos" aria-hidden="true"></span>
            <span>RTOS</span>
          </span>
          <span>
            <span class="xp-domain-module xp-domain-module--services" aria-hidden="true"></span>
            <span>Services</span>
          </span>
        </div>
      </div>
    </div>

    <div class="xp-connector xp-connector--upper" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="xp-plane xp-plane--xen">
      <div class="xp-plane__drafting" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="xp-plane__content xp-plane__content--split">
        <span class="xp-boundary-symbol" aria-hidden="true"></span>
        <div>
          <p class="xp-plane__title">Xen hypervisor boundary</p>
          <p class="xp-plane__description">Isolation, scheduling, device assignment, and platform control decisions stay visible.</p>
        </div>
      </div>
    </div>

    <div class="xp-connector xp-connector--lower" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="xp-plane xp-plane--hardware">
      <div class="xp-plane__drafting" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="xp-hardware-grid" aria-hidden="true"></div>
      <div class="xp-plane__content xp-plane__content--split">
        <span class="xp-hardware-symbol" aria-hidden="true"></span>
        <div>
          <p class="xp-plane__title">Hardware platform</p>
          <p class="xp-plane__description">Compute, memory, interrupts, devices, and long-lived product integration.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .xp-platform-diagram {
    --diagram-blue: var(--xp-accent-secondary);
    --diagram-cyan: #67d9df;
    --diagram-green: var(--xp-accent-primary);
    --plane-skew: -8deg;
    --plane-cut: 12%;
    position: relative;
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.35rem);
    border: 1px solid rgb(198 214 235 / 0.12);
    border-radius: var(--xp-radius-lg);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 0.03), transparent 38%),
      linear-gradient(180deg, rgb(11 19 32 / 0.74), rgb(5 8 14 / 0.2));
    overflow: hidden;
  }

  .xp-platform-diagram::before {
    content: '';
    position: absolute;
    inset: 0.85rem;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, rgb(198 214 235 / 0.055) 1px, transparent 1px),
      linear-gradient(rgb(198 214 235 / 0.045) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(130deg, transparent 0%, black 26%, black 70%, transparent 100%);
  }

  .xp-platform-diagram__header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.2rem, 3vw, 1.8rem);
  }

  .xp-platform-diagram__eyebrow,
  .xp-platform-diagram__scale {
    margin: 0;
    color: var(--xp-accent-primary);
    font-family: var(--xp-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .xp-platform-diagram__scale {
    color: var(--xp-text-muted);
    font-weight: 500;
  }

  .xp-platform-stack {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    padding: 0.15rem 0 1.35rem;
  }

  .xp-layer-card {
    position: relative;
    width: min(16rem, 68%);
    min-height: 7rem;
    margin-bottom: 1.1rem;
    background:
      linear-gradient(145deg, rgb(79 179 255 / 0.98), rgb(31 68 122 / 0.9));
    box-shadow:
      0 1.9rem 3.2rem -1.2rem rgb(0 0 0 / 0.78),
      inset 0 1px 0 rgb(255 255 255 / 0.3);
    transform: perspective(1100px) rotateX(54deg) rotateZ(-18deg) translateY(0.3rem);
    transform-style: preserve-3d;
  }

  .xp-layer-card::before {
    content: '';
    position: absolute;
    inset: 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.8rem;
    pointer-events: none;
  }

  .xp-layer-card::after {
    content: '';
    position: absolute;
    inset: auto -0.8rem -0.95rem auto;
    width: 3.4rem;
    height: 1.1rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.28);
    filter: blur(0.5rem);
    transform: skewX(-36deg);
  }

  .xp-layer-card__label {
    position: relative;
    z-index: 1;
    margin: 0;
    color: rgb(255 255 255 / 0.96);
    font-family: var(--xp-font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 0.2rem 0.5rem rgb(0 0 0 / 0.25);
  }

  .xp-plane {
    position: relative;
    min-width: 0;
    clip-path: polygon(var(--plane-cut) 0, 100% 0, calc(100% - var(--plane-cut)) 100%, 0 100%);
    border: 1px solid rgb(79 179 255 / 0.48);
    background:
      linear-gradient(115deg, rgb(79 179 255 / 0.16), transparent 42%),
      rgb(15 30 51 / 0.78);
    box-shadow:
      0 1.15rem 2.1rem -1.8rem rgb(0 0 0 / 0.74),
      inset 0 1px 0 rgb(255 255 255 / 0.07);
    transform: skewY(var(--plane-skew));
  }

  .xp-plane::before,
  .xp-plane::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .xp-plane::before {
    inset: 0.85rem 10% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    color: rgb(117 201 255 / 0.42);
  }

  .xp-plane::after {
    right: 12%;
    bottom: 0.95rem;
    width: 4.75rem;
    height: 1px;
    background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 10px);
    color: rgb(117 201 255 / 0.48);
  }

  .xp-plane--guests {
    z-index: 3;
    width: 91%;
    margin-inline: auto 2%;
  }

  .xp-plane--xen {
    z-index: 2;
    width: 96%;
    margin-inline: 2% auto;
    border-color: rgb(103 217 223 / 0.58);
    background:
      linear-gradient(120deg, rgb(103 217 223 / 0.12), transparent 46%),
      rgb(12 36 48 / 0.84);
  }

  .xp-plane--xen::before,
  .xp-plane--xen::after {
    color: rgb(103 217 223 / 0.46);
  }

  .xp-plane--hardware {
    z-index: 1;
    width: 100%;
    border-color: rgb(133 194 65 / 0.62);
    background:
      linear-gradient(130deg, rgb(133 194 65 / 0.16), transparent 44%),
      rgb(20 42 36 / 0.86);
  }

  .xp-plane--hardware::before,
  .xp-plane--hardware::after {
    color: rgb(133 194 65 / 0.46);
  }

  .xp-plane__content {
    position: relative;
    z-index: 2;
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.35rem) clamp(2.6rem, 6vw, 4.8rem);
    transform: skewY(calc(var(--plane-skew) * -1));
  }

  .xp-plane__content--split {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .xp-plane__title {
    margin: 0;
    color: var(--xp-accent-primary);
    font-family: var(--xp-font-mono);
    font-size: clamp(0.72rem, 1.6vw, 0.82rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .xp-plane--guests .xp-plane__title {
    color: var(--diagram-blue);
  }

  .xp-plane--xen .xp-plane__title {
    color: var(--diagram-cyan);
  }

  .xp-plane__description {
    max-width: 24rem;
    margin: 0.45rem 0 0;
    color: var(--xp-text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .xp-plane__drafting {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .xp-plane__drafting span {
    position: absolute;
    width: 0.65rem;
    height: 0.65rem;
    border-color: currentColor;
    color: rgb(117 201 255 / 0.62);
  }

  .xp-plane__drafting span:first-child {
    top: 0.75rem;
    left: 8%;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .xp-plane__drafting span:last-child {
    right: 8%;
    bottom: 0.75rem;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .xp-plane--xen .xp-plane__drafting span {
    color: rgb(103 217 223 / 0.66);
  }

  .xp-plane--hardware .xp-plane__drafting span {
    color: rgb(133 194 65 / 0.66);
  }

  .xp-domain-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.65rem, 2vw, 1rem);
    margin: 1rem 0 0;
  }

  .xp-domain-list > span {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding-block: 0.2rem;
    color: var(--xp-text-primary);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .xp-domain-module,
  .xp-boundary-symbol,
  .xp-hardware-symbol {
    position: relative;
    display: inline-block;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
  }

  .xp-domain-module {
    border: 1px solid rgb(117 201 255 / 0.76);
    background: rgb(79 179 255 / 0.07);
  }

  .xp-domain-module--linux::after {
    content: '';
    position: absolute;
    inset: 0.48rem;
    border: 1px solid rgb(117 201 255 / 0.58);
  }

  .xp-domain-module--rtos {
    border-style: dashed;
  }

  .xp-domain-module--rtos::before,
  .xp-domain-module--rtos::after {
    content: '';
    position: absolute;
    background: rgb(117 201 255 / 0.78);
  }

  .xp-domain-module--rtos::before {
    inset: 0.58rem;
  }

  .xp-domain-module--rtos::after {
    inset: -0.35rem 0.88rem;
    box-shadow:
      -0.54rem 0.54rem 0 -0.16rem rgb(117 201 255 / 0.78),
      0.54rem 0.54rem 0 -0.16rem rgb(117 201 255 / 0.78),
      -0.54rem 1.08rem 0 -0.16rem rgb(117 201 255 / 0.78),
      0.54rem 1.08rem 0 -0.16rem rgb(117 201 255 / 0.78),
      -0.54rem 1.62rem 0 -0.16rem rgb(117 201 255 / 0.78),
      0.54rem 1.62rem 0 -0.16rem rgb(117 201 255 / 0.78);
  }

  .xp-domain-module--services {
    border: 0;
    background:
      linear-gradient(150deg, transparent 42%, rgb(117 201 255 / 0.72) 42% 47%, transparent 47%) 0 0 / 100% 100%,
      linear-gradient(30deg, transparent 42%, rgb(117 201 255 / 0.72) 42% 47%, transparent 47%) 0 0 / 100% 100%;
  }

  .xp-domain-module--services::before,
  .xp-domain-module--services::after {
    content: '';
    position: absolute;
    inset: 0.35rem 0.18rem;
    border-top: 1px solid rgb(117 201 255 / 0.7);
    border-bottom: 1px solid rgb(117 201 255 / 0.7);
    transform: skewY(-25deg);
  }

  .xp-domain-module--services::after {
    inset: 0.75rem 0.18rem -0.05rem;
  }

  .xp-boundary-symbol {
    width: 2.35rem;
    height: 2.75rem;
    border: 1px solid rgb(103 217 223 / 0.78);
    border-top: 0;
    clip-path: polygon(50% 0, 100% 16%, 100% 55%, 50% 100%, 0 55%, 0 16%);
    background: rgb(103 217 223 / 0.06);
  }

  .xp-boundary-symbol::after {
    content: '';
    position: absolute;
    inset: 0.55rem 0.72rem;
    border-left: 1px solid rgb(103 217 223 / 0.48);
    border-right: 1px solid rgb(103 217 223 / 0.48);
  }

  .xp-hardware-symbol {
    border: 1px solid rgb(133 194 65 / 0.8);
    background: rgb(133 194 65 / 0.08);
  }

  .xp-hardware-symbol::before {
    content: '';
    position: absolute;
    inset: 0.52rem;
    border: 1px solid rgb(133 194 65 / 0.62);
    background: rgb(133 194 65 / 0.1);
  }

  .xp-hardware-symbol::after {
    content: '';
    position: absolute;
    inset: -0.38rem;
    background:
      linear-gradient(90deg, transparent 0 0.2rem, rgb(133 194 65 / 0.72) 0.2rem 0.3rem, transparent 0.3rem 0.56rem) 50% 0 / 1.1rem 0.25rem repeat-x,
      linear-gradient(90deg, transparent 0 0.2rem, rgb(133 194 65 / 0.72) 0.2rem 0.3rem, transparent 0.3rem 0.56rem) 50% 100% / 1.1rem 0.25rem repeat-x,
      linear-gradient(0deg, transparent 0 0.2rem, rgb(133 194 65 / 0.72) 0.2rem 0.3rem, transparent 0.3rem 0.56rem) 0 50% / 0.25rem 1.1rem repeat-y,
      linear-gradient(0deg, transparent 0 0.2rem, rgb(133 194 65 / 0.72) 0.2rem 0.3rem, transparent 0.3rem 0.56rem) 100% 50% / 0.25rem 1.1rem repeat-y;
    background-repeat: repeat-x, repeat-x, repeat-y, repeat-y;
  }

  .xp-hardware-grid {
    position: absolute;
    inset: 0.55rem 9%;
    z-index: 1;
    background-image:
      linear-gradient(90deg, rgb(133 194 65 / 0.1) 1px, transparent 1px),
      linear-gradient(rgb(133 194 65 / 0.085) 1px, transparent 1px);
    background-size: 1.8rem 1.8rem;
    mask-image: linear-gradient(90deg, black, transparent 74%);
    pointer-events: none;
  }

  .xp-connector {
    display: grid;
    grid-template-columns: repeat(3, 1px);
    justify-content: center;
    gap: clamp(3.2rem, 15vw, 7.8rem);
    min-height: clamp(2rem, 5vw, 3rem);
    transform: skewY(var(--plane-skew));
  }

  .xp-connector span {
    position: relative;
    display: block;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgb(117 201 255 / 0.56), transparent);
  }

  .xp-connector--lower span {
    background: linear-gradient(180deg, transparent, rgb(133 194 65 / 0.5), transparent);
  }

  .xp-connector span::before,
  .xp-connector span::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 0.34rem;
    height: 0.34rem;
    border: 1px solid currentColor;
    background: var(--xp-surface-1);
    transform: translateX(-50%) rotate(45deg);
  }

  .xp-connector span::before {
    top: 0.18rem;
  }

  .xp-connector span::after {
    bottom: 0.18rem;
  }

  .xp-connector--upper span {
    color: rgb(117 201 255 / 0.68);
  }

  .xp-connector--lower span {
    color: rgb(133 194 65 / 0.68);
  }

  @media (max-width: 639px) {
    .xp-platform-diagram {
      --plane-skew: -2deg;
      --plane-cut: 4%;
      padding: 1rem;
      border-radius: var(--xp-radius-md);
    }

    .xp-platform-diagram::before {
      inset: 0.65rem;
      background-size: 2rem 2rem;
      opacity: 0.7;
    }

    .xp-platform-diagram__header {
      margin-bottom: 1rem;
    }

    .xp-plane,
    .xp-plane--guests,
    .xp-plane--xen,
    .xp-plane--hardware {
      width: 100%;
      margin-inline: 0;
    }

    .xp-plane__content {
      padding: 1rem 0.95rem;
    }

    .xp-plane__content--split {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .xp-domain-list {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .xp-domain-list > span {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .xp-connector {
      gap: clamp(2.1rem, 22vw, 4.3rem);
      min-height: 1.7rem;
      transform: none;
    }

    .xp-plane__description {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 419px) {
    .xp-platform-diagram__scale {
      display: none;
    }

    .xp-plane::after {
      width: 3rem;
    }
  }

  @media print {
    .xp-platform-diagram {
      border: 1px solid #9ca3af;
      background: transparent;
    }

    .xp-platform-diagram::before,
    .xp-plane::before,
    .xp-plane::after,
    .xp-plane__drafting,
    .xp-connector,
    .xp-hardware-grid {
      display: none;
    }

    .xp-platform-stack {
      gap: 0.75rem;
    }

    .xp-plane,
    .xp-plane--guests,
    .xp-plane--xen,
    .xp-plane--hardware,
    .xp-plane__content {
      width: 100%;
      margin-inline: 0;
      clip-path: none;
      background: transparent;
      box-shadow: none;
      transform: none;
    }
  }
</style>
