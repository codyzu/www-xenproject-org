---
import applicationsSrc from '../../../assets/illustrations/layered-platform/applications.png?url';
import guestSystemsSrc from '../../../assets/illustrations/layered-platform/guest-systems.png?url';
import hardwareSrc from '../../../assets/illustrations/layered-platform/hardware.png?url';
import xenHypervisorSrc from '../../../assets/illustrations/layered-platform/xen-hypervisor.png?url';

const descriptionId = 'hero-layered-platform-description';

const layers = [
  {
    key: 'applications',
    title: 'Applications',
    description: 'Workloads and services running in user space.',
    src: applicationsSrc,
    y: '-14.5rem',
    mobileY: '-10.25rem',
    hoverY: '-0.5rem',
    parallax: 4,
  },
  {
    key: 'guest-systems',
    title: 'Guest systems',
    description: 'Isolated operating systems and runtimes.',
    src: guestSystemsSrc,
    y: '-5.25rem',
    mobileY: '-3.75rem',
    hoverY: '-0.3125rem',
    parallax: 3,
  },
  {
    key: 'xen-hypervisor',
    title: 'Xen hypervisor',
    description: 'The thin virtualization control layer that provides isolation and manages hardware.',
    src: xenHypervisorSrc,
    y: '3.75rem',
    mobileY: '2.7rem',
    hoverY: '-0.1875rem',
    parallax: 2,
  },
  {
    key: 'hardware',
    title: 'Hardware',
    description: 'Physical compute resources.',
    src: hardwareSrc,
    y: '13rem',
    mobileY: '9.25rem',
    hoverY: '0rem',
    parallax: 1,
  },
];

const paintedLayers = [...layers].reverse();
---

<figure
  class="hero-layered-platform"
  role="img"
  aria-labelledby={descriptionId}
  data-hero-layered-platform
  data-motion="subtle"
>
  <figcaption id={descriptionId} class="hero-layered-platform__description">
    Exploded Xen architecture scene showing applications above guest systems, a thin luminous Xen hypervisor layer, and a substantial hardware platform foundation.
  </figcaption>

  <div class="hero-layered-platform__stage" aria-hidden="true">
    <div class="hero-layered-platform__aura"></div>
    <div class="hero-layered-platform__grid"></div>
    <div class="hero-layered-platform__guides">
      <span style="--x: 24%;"></span>
      <span style="--x: 76%;"></span>
    </div>

    <div class="hero-layered-platform__stack">
      {paintedLayers.map(layer => (
        <div
          class:list={[
            'hero-layered-platform__layer',
            `hero-layered-platform__layer--${layer.key}`,
          ]}
          style={`--layer-y: ${layer.y}; --layer-mobile-y: ${layer.mobileY}; --layer-hover-y: ${layer.hoverY}; --layer-parallax-strength: ${layer.parallax};`}
          data-platform-layer={layer.key}
          data-platform-layer-asset="image"
        >
          <img src={layer.src} alt="" loading="eager" decoding="async" fetchpriority={layer.key === 'applications' ? 'high' : 'auto'} />
        </div>
      ))}
    </div>

    <div class="hero-layered-platform__labels">
      {layers.map(layer => (
        <div class:list={[
          'hero-layered-platform__label',
          `hero-layered-platform__label--${layer.key}`,
        ]} style={`--layer-y: ${layer.y}; --layer-mobile-y: ${layer.mobileY};`}>
          <svg class="hero-layered-platform__connector" viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true">
            <line x1="1" y1="6" x2="119" y2="6"></line>
            <circle cx="1" cy="6" r="2.7"></circle>
            <circle cx="119" cy="6" r="1.8"></circle>
          </svg>
          <span class="hero-layered-platform__icon" aria-hidden="true">
            {layer.key === 'xen-hypervisor' ? 'X' : ''}
          </span>
          <span>
            <strong>{layer.title}</strong>
            <small>{layer.description}</small>
          </span>
        </div>
      ))}
    </div>
  </div>
</figure>

<script>
  const mediaQuery = globalThis.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointerQuery = globalThis.matchMedia('(pointer: fine)');
  const stage = document.querySelector<HTMLElement>('[data-hero-layered-platform]');

  if (stage && !mediaQuery.matches && finePointerQuery.matches) {
    const layers = [...stage.querySelectorAll<HTMLElement>('[data-platform-layer]')];
    let frame = 0;
    let targetX = 0;
    let targetY = 0;

    const updateParallax = () => {
      frame = 0;
      for (const layer of layers) {
        const strength = Number(layer.style.getPropertyValue('--layer-parallax-strength')) || 0;
        layer.style.setProperty('--layer-pointer-x', `${(targetX * strength).toFixed(3)}px`);
        layer.style.setProperty('--layer-pointer-y', `${(targetY * strength * -0.45).toFixed(3)}px`);
      }
    };

    stage.addEventListener('pointermove', event => {
      const rect = stage.getBoundingClientRect();
      targetX = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      targetY = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

      if (frame === 0) {
        frame = globalThis.requestAnimationFrame(updateParallax);
      }
    });

    stage.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;

      if (frame === 0) {
        frame = globalThis.requestAnimationFrame(updateParallax);
      }
    });
  }
</script>

<style>
  .hero-layered-platform {
    position: relative;
    --stage-label-width: clamp(8.75rem, 12vw, 10.25rem);
    --stage-connector-width: clamp(3.5rem, 7vw, 5.75rem);
    --stage-label-gap: clamp(1.15rem, 2vw, 1.75rem);
    --stage-label-zone: calc(var(--stage-label-width) + var(--stage-connector-width) + var(--stage-label-gap));
    --stage-artwork-width: min(100%, 46rem);
    width: min(100%, 62rem);
    margin: 0;
    margin-inline: auto;
    overflow: visible;
  }

  .hero-layered-platform__description {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-layered-platform__stage {
    position: relative;
    min-height: clamp(32rem, 55vw, 45rem);
    overflow: visible;
    isolation: isolate;
    contain: layout;
  }

  .hero-layered-platform__aura,
  .hero-layered-platform__grid,
  .hero-layered-platform__lighting,
  .hero-layered-platform__stage::before,
  .hero-layered-platform__stage::after {
    position: absolute;
    pointer-events: none;
    inset: 8% var(--stage-label-zone) 3% 0;
    z-index: 0;
  }

  .hero-layered-platform__aura {
    background:
      radial-gradient(circle at 48% 58%, rgb(140 255 0 / 0.2), transparent 20rem),
      radial-gradient(circle at 62% 31%, rgb(58 152 255 / 0.18), transparent 22rem),
      radial-gradient(circle at 47% 78%, rgb(0 0 0 / 0.7), transparent 26rem);
    filter: blur(18px);
  }

  .hero-layered-platform__stage::before,
  .hero-layered-platform__stage::after {
    content: "";
  }

  .hero-layered-platform__stage::before {
    z-index: 1;
    background:
      linear-gradient(105deg, transparent 12%, rgb(255 255 255 / 0.1) 31%, transparent 46%),
      radial-gradient(ellipse at 45% 52%, transparent 0 42%, rgb(1 5 12 / 0.22) 74%, rgb(1 5 12 / 0.42));
    mix-blend-mode: screen;
    opacity: 0.28;
    mask-image: radial-gradient(ellipse at center, black 0 48%, transparent 76%);
    animation: hero-platform-specular 18s linear infinite;
  }

  .hero-layered-platform__stage::after {
    z-index: 2;
    background: radial-gradient(ellipse at 45% 54%, transparent 0 48%, rgb(2 6 14 / 0.32) 82%);
    opacity: 0.7;
    mix-blend-mode: multiply;
  }

  .hero-layered-platform__grid {
    opacity: 0.22;
    background-image:
      linear-gradient(rgb(79 179 255 / 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgb(79 179 255 / 0.16) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(56rem) rotateX(62deg) rotateZ(-28deg) translate3d(-2rem, 15rem, 0);
    transform-origin: center;
    mask-image: radial-gradient(ellipse at center, black 0 36%, transparent 72%);
  }

  .hero-layered-platform__guides {
    position: absolute;
    inset: 13% var(--stage-label-zone) 17% 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero-layered-platform__guides span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(79 179 255 / 0.52) 18%,
      rgb(140 255 0 / 0.62) 64%,
      transparent
    );
    opacity: 0.72;
    box-shadow: 0 0 14px rgb(79 179 255 / 0.28);
  }

  .hero-layered-platform__stack {
    position: absolute;
    z-index: 3;
    inset: 0 var(--stage-label-zone) 0 0;
    animation: hero-platform-float 8s var(--xp-ease-standard) infinite;
  }

  .hero-layered-platform__layer {
    position: absolute;
    --layer-hover-shift: 0rem;
    --layer-pointer-x: 0px;
    --layer-pointer-y: 0px;
    top: 50%;
    left: 50%;
    width: var(--stage-artwork-width);
    transform: translate3d(
        calc(-50% + var(--layer-pointer-x)),
        calc(-50% + var(--layer-y) + var(--layer-hover-shift) + var(--layer-pointer-y)),
        0
      )
      scale(var(--layer-scale, 1));
    transition:
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 620ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 620ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .hero-layered-platform__layer img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    filter:
      drop-shadow(0 2.2rem 2rem rgb(0 0 0 / 0.36))
      drop-shadow(0 0 1.2rem rgb(79 179 255 / 0.14));
  }

  .hero-layered-platform__layer--applications {
    --layer-scale: 0.985;
    z-index: 4;
  }

  .hero-layered-platform__layer--applications img {
    filter:
      brightness(1.025)
      contrast(1.015)
      drop-shadow(0 1.8rem 1.7rem rgb(0 0 0 / 0.3))
      drop-shadow(0 0 1.1rem rgb(79 179 255 / 0.15));
  }

  .hero-layered-platform__layer--guest-systems {
    --layer-scale: 0.995;
    z-index: 3;
  }

  .hero-layered-platform__layer--guest-systems img {
    filter:
      brightness(1.01)
      contrast(1.01)
      drop-shadow(0 2.1rem 1.85rem rgb(0 0 0 / 0.34))
      drop-shadow(0 0 1.2rem rgb(79 179 255 / 0.13));
  }

  .hero-layered-platform__layer--xen-hypervisor {
    z-index: 2;
  }

  .hero-layered-platform__layer--xen-hypervisor img {
    filter:
      brightness(1.035)
      contrast(1.04)
      saturate(1.04)
      drop-shadow(0 1.3rem 1.2rem rgb(0 0 0 / 0.38))
      drop-shadow(0 0 1.3rem rgb(140 255 0 / 0.34));
  }

  .hero-layered-platform__layer--hardware {
    z-index: 1;
  }

  .hero-layered-platform__layer--hardware img {
    filter:
      brightness(0.98)
      contrast(1.025)
      drop-shadow(0 3rem 2.6rem rgb(0 0 0 / 0.56))
      drop-shadow(0 0 1rem rgb(140 255 0 / 0.14));
  }

  .hero-layered-platform__labels {
    position: absolute;
    z-index: 4;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--stage-label-width);
    pointer-events: none;
    animation: hero-platform-float 8s var(--xp-ease-standard) infinite;
  }

  .hero-layered-platform__label {
    position: absolute;
    top: calc(50% + var(--layer-y));
    left: 0;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
    max-width: 100%;
    color: var(--xp-text-secondary);
    opacity: 0.88;
    transform: translateY(-50%);
  }

  .hero-layered-platform__connector {
    position: absolute;
    top: 50%;
    right: calc(100% + var(--stage-label-gap));
    width: var(--stage-connector-width);
    height: 0.75rem;
    overflow: visible;
    opacity: 0.34;
    transform: translateY(-50%);
  }

  .hero-layered-platform__connector line {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero-layered-platform__connector circle {
    fill: currentColor;
    filter: drop-shadow(0 0 0.28rem currentColor);
  }

  .hero-layered-platform__icon {
    display: grid;
    width: 1.75rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(198 214 235 / 0.22);
    border-radius: 0.42rem;
    background: rgb(5 8 14 / 0.34);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
    color: currentColor;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
  }

  .hero-layered-platform__label strong {
    display: block;
    color: var(--xp-text-primary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-layered-platform__label small {
    display: block;
    margin-top: 0.22rem;
    color: var(--xp-text-muted);
    font-size: 0.64rem;
    line-height: 1.35;
  }

  .hero-layered-platform__label--applications,
  .hero-layered-platform__label--guest-systems {
    color: #59b7ff;
  }

  .hero-layered-platform__label--xen-hypervisor {
    color: #8cff00;
  }

  .hero-layered-platform__label--hardware {
    color: #97a3b5;
  }

  .hero-layered-platform__label--xen-hypervisor .hero-layered-platform__icon {
    border-color: rgb(140 255 0 / 0.24);
    background: rgb(133 194 65 / 0.09);
    text-shadow: 0 0 10px rgb(140 255 0 / 0.36);
  }

  .hero-layered-platform__label:not(.hero-layered-platform__label--xen-hypervisor) .hero-layered-platform__icon::before {
    width: 0.88rem;
    height: 0.88rem;
    content: "";
    border: 1px solid currentColor;
    border-radius: 0.16rem;
    opacity: 0.58;
    transform: rotate(30deg) skewX(-18deg);
  }

  @keyframes hero-platform-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -0.45rem, 0);
    }
  }

  @keyframes hero-platform-specular {
    0% {
      transform: translate3d(-10%, -2%, 0);
      opacity: 0.06;
    }

    36%,
    70% {
      opacity: 0.28;
    }

    100% {
      transform: translate3d(10%, 2%, 0);
      opacity: 0.08;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-layered-platform:hover .hero-layered-platform__layer {
      --layer-hover-shift: var(--layer-hover-y);
    }

    .hero-layered-platform:hover .hero-layered-platform__layer:not(.hero-layered-platform__layer--xen-hypervisor) img {
      filter:
        brightness(0.965)
        contrast(1.01)
        drop-shadow(0 2.1rem 1.9rem rgb(0 0 0 / 0.37))
        drop-shadow(0 0 1rem rgb(79 179 255 / 0.1));
    }

    .hero-layered-platform:hover .hero-layered-platform__layer--hardware img {
      filter:
        brightness(0.955)
        contrast(1.025)
        drop-shadow(0 3rem 2.6rem rgb(0 0 0 / 0.58))
        drop-shadow(0 0 0.95rem rgb(140 255 0 / 0.12));
    }

    .hero-layered-platform:hover .hero-layered-platform__layer--xen-hypervisor img {
      filter:
        brightness(1.11)
        contrast(1.1)
        saturate(1.08)
        drop-shadow(0 1.35rem 1.2rem rgb(0 0 0 / 0.4))
        drop-shadow(0 0 1.45rem rgb(140 255 0 / 0.42));
    }

    .hero-layered-platform:hover .hero-layered-platform__label:not(.hero-layered-platform__label--xen-hypervisor) {
      opacity: 0.8;
    }

    .hero-layered-platform:hover .hero-layered-platform__label--xen-hypervisor {
      opacity: 1;
    }
  }

  @media (max-width: 63.9375rem) {
    .hero-layered-platform {
      --stage-label-zone: 0rem;
      --stage-artwork-width: min(100%, 38rem);
      width: min(100%, 42rem);
    }

    .hero-layered-platform__stage {
      min-height: clamp(25rem, 74vw, 34rem);
    }

    .hero-layered-platform__layer {
      transform: translate3d(
          calc(-50% + var(--layer-pointer-x)),
          calc(
            -50% + var(--layer-mobile-y) + var(--layer-hover-shift) + var(--layer-pointer-y)
          ),
          0
        )
        scale(var(--layer-scale, 1));
    }

    .hero-layered-platform__labels {
      display: none;
    }

    .hero-layered-platform__guides {
      inset-inline: 9%;
    }
  }

  @media (max-width: 39.9375rem) {
    .hero-layered-platform {
      --stage-artwork-width: min(100%, 33rem);
    }

    .hero-layered-platform__stage {
      min-height: clamp(21rem, 90vw, 27rem);
    }

    .hero-layered-platform__aura,
    .hero-layered-platform__grid {
      inset-inline: -14%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-layered-platform__stage::before {
      animation: none;
    }

    .hero-layered-platform__stack {
      animation: none;
    }

    .hero-layered-platform__labels {
      animation: none;
    }

    .hero-layered-platform__layer {
      transition: none;
      will-change: auto;
    }
  }
</style>
