---
import applicationsSrc from '../../../assets/illustrations/layered-platform/applications.png?url';
import guestSystemsSrc from '../../../assets/illustrations/layered-platform/guest-systems.png?url';
import hardwareSrc from '../../../assets/illustrations/layered-platform/hardware.png?url';
import xenHypervisorSrc from '../../../assets/illustrations/layered-platform/xen-hypervisor.png?url';

const descriptionId = 'hero-layered-platform-description';

const layers = [
  {
    key: 'applications',
    title: 'Applications',
    description: 'Workloads and services running in user space.',
    src: applicationsSrc,
    y: '-14.5rem',
    mobileY: '-10.25rem',
  },
  {
    key: 'guest-systems',
    title: 'Guest systems',
    description: 'Isolated operating systems and runtimes.',
    src: guestSystemsSrc,
    y: '-5.25rem',
    mobileY: '-3.75rem',
  },
  {
    key: 'xen-hypervisor',
    title: 'Xen hypervisor',
    description: 'The thin virtualization control layer that provides isolation and manages hardware.',
    src: xenHypervisorSrc,
    y: '3.75rem',
    mobileY: '2.7rem',
  },
  {
    key: 'hardware',
    title: 'Hardware',
    description: 'Physical compute resources.',
    src: hardwareSrc,
    y: '13rem',
    mobileY: '9.25rem',
  },
];
---

<figure
  class="hero-layered-platform"
  role="img"
  aria-labelledby={descriptionId}
  data-hero-layered-platform
  data-motion="subtle"
>
  <figcaption id={descriptionId} class="hero-layered-platform__description">
    Exploded Xen architecture scene showing applications above guest systems, a thin luminous Xen hypervisor layer, and a substantial hardware platform foundation.
  </figcaption>

  <div class="hero-layered-platform__stage" aria-hidden="true">
    <div class="hero-layered-platform__aura"></div>
    <div class="hero-layered-platform__grid"></div>
    <div class="hero-layered-platform__guides">
      <span style="--x: 24%;"></span>
      <span style="--x: 76%;"></span>
    </div>

    <div class="hero-layered-platform__stack">
      {layers.map((layer, index) => (
        <div
          class:list={[
            'hero-layered-platform__layer',
            `hero-layered-platform__layer--${layer.key}`,
          ]}
          style={`--layer-y: ${layer.y}; --layer-mobile-y: ${layer.mobileY}; --layer-index: ${index};`}
          data-platform-layer={layer.key}
          data-platform-layer-asset="image"
        >
          <img src={layer.src} alt="" loading="eager" decoding="async" fetchpriority={index === 0 ? 'high' : 'auto'} />
        </div>
      ))}
    </div>

    <div class="hero-layered-platform__labels">
      {layers.map(layer => (
        <div class:list={[
          'hero-layered-platform__label',
          `hero-layered-platform__label--${layer.key}`,
        ]}>
          <span class="hero-layered-platform__connector"></span>
          <span class="hero-layered-platform__icon" aria-hidden="true">
            {layer.key === 'xen-hypervisor' ? 'X' : ''}
          </span>
          <span>
            <strong>{layer.title}</strong>
            <small>{layer.description}</small>
          </span>
        </div>
      ))}
    </div>
  </div>
</figure>

<style>
  .hero-layered-platform {
    position: relative;
    width: min(100%, 58rem);
    margin: 0;
    margin-inline: auto;
  }

  .hero-layered-platform__description {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-layered-platform__stage {
    position: relative;
    min-height: clamp(31rem, 54vw, 45rem);
    overflow: visible;
    isolation: isolate;
  }

  .hero-layered-platform__aura,
  .hero-layered-platform__grid {
    position: absolute;
    pointer-events: none;
    inset: 8% 4% 3% -4%;
    z-index: 0;
  }

  .hero-layered-platform__aura {
    background:
      radial-gradient(circle at 45% 58%, rgb(140 255 0 / 0.22), transparent 21rem),
      radial-gradient(circle at 64% 32%, rgb(58 152 255 / 0.22), transparent 22rem),
      radial-gradient(circle at 42% 74%, rgb(0 0 0 / 0.72), transparent 26rem);
    filter: blur(16px);
  }

  .hero-layered-platform__grid {
    opacity: 0.22;
    background-image:
      linear-gradient(rgb(79 179 255 / 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgb(79 179 255 / 0.16) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(56rem) rotateX(62deg) rotateZ(-28deg) translate3d(-2rem, 15rem, 0);
    transform-origin: center;
    mask-image: radial-gradient(ellipse at center, black 0 36%, transparent 72%);
  }

  .hero-layered-platform__guides {
    position: absolute;
    inset: 13% 16% 17% 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero-layered-platform__guides span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(79 179 255 / 0.52) 18%,
      rgb(140 255 0 / 0.62) 64%,
      transparent
    );
    opacity: 0.72;
    box-shadow: 0 0 14px rgb(79 179 255 / 0.28);
  }

  .hero-layered-platform__stack {
    position: absolute;
    z-index: 3;
    inset: 0 18% 0 -14%;
    animation: hero-platform-float 8s var(--xp-ease-standard) infinite;
  }

  .hero-layered-platform__layer {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(100%, 46rem);
    transform: translate3d(-50%, calc(-50% + var(--layer-y)), 0);
    transition:
      transform var(--xp-motion-slow) var(--xp-ease-standard),
      filter var(--xp-motion-slow) var(--xp-ease-standard),
      opacity var(--xp-motion-slow) var(--xp-ease-standard);
    will-change: transform;
  }

  .hero-layered-platform__layer img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    filter:
      drop-shadow(0 2.2rem 2rem rgb(0 0 0 / 0.36))
      drop-shadow(0 0 1.2rem rgb(79 179 255 / 0.14));
  }

  .hero-layered-platform__layer--xen-hypervisor img {
    filter:
      drop-shadow(0 1.3rem 1.2rem rgb(0 0 0 / 0.38))
      drop-shadow(0 0 1.35rem rgb(140 255 0 / 0.40));
  }

  .hero-layered-platform__layer--hardware img {
    filter:
      drop-shadow(0 3rem 2.6rem rgb(0 0 0 / 0.56))
      drop-shadow(0 0 1rem rgb(140 255 0 / 0.16));
  }

  .hero-layered-platform__labels {
    position: absolute;
    z-index: 4;
    top: 12%;
    right: 0;
    bottom: 11%;
    width: min(13.25rem, 30vw);
    pointer-events: none;
  }

  .hero-layered-platform__label {
    position: absolute;
    left: 0;
    display: grid;
    grid-template-columns: 2.85rem 1fr;
    gap: 0.65rem;
    align-items: center;
    color: var(--xp-text-secondary);
  }

  .hero-layered-platform__label--applications {
    top: 4%;
  }

  .hero-layered-platform__label--guest-systems {
    top: 30%;
  }

  .hero-layered-platform__label--xen-hypervisor {
    top: 55%;
  }

  .hero-layered-platform__label--hardware {
    top: 80%;
  }

  .hero-layered-platform__connector {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.65rem);
    width: clamp(1.8rem, 4vw, 3.8rem);
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor);
    opacity: 0.62;
  }

  .hero-layered-platform__connector::before,
  .hero-layered-platform__connector::after {
    position: absolute;
    top: 50%;
    width: 0.34rem;
    height: 0.34rem;
    content: "";
    border-radius: 999px;
    background: currentColor;
    transform: translateY(-50%);
    box-shadow: 0 0 12px currentColor;
  }

  .hero-layered-platform__connector::before {
    left: 0;
  }

  .hero-layered-platform__connector::after {
    right: 0;
  }

  .hero-layered-platform__icon {
    display: grid;
    width: 2.85rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(198 214 235 / 0.34);
    border-radius: 0.55rem;
    background: rgb(5 8 14 / 0.58);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    color: currentColor;
    font-size: 1.58rem;
    font-weight: 800;
    line-height: 1;
  }

  .hero-layered-platform__label strong {
    display: block;
    color: var(--xp-text-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-layered-platform__label small {
    display: block;
    margin-top: 0.34rem;
    color: var(--xp-text-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .hero-layered-platform__label--applications,
  .hero-layered-platform__label--guest-systems {
    color: #59b7ff;
  }

  .hero-layered-platform__label--xen-hypervisor {
    color: #8cff00;
  }

  .hero-layered-platform__label--hardware {
    color: #97a3b5;
  }

  .hero-layered-platform__label--xen-hypervisor .hero-layered-platform__icon {
    border-color: rgb(140 255 0 / 0.32);
    background: rgb(133 194 65 / 0.14);
    text-shadow: 0 0 16px rgb(140 255 0 / 0.44);
  }

  .hero-layered-platform__label:not(.hero-layered-platform__label--xen-hypervisor) .hero-layered-platform__icon::before {
    width: 1.45rem;
    height: 1.45rem;
    content: "";
    border: 1px solid currentColor;
    border-radius: 0.22rem;
    opacity: 0.76;
    transform: rotate(30deg) skewX(-18deg);
  }

  @keyframes hero-platform-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -0.45rem, 0);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-layered-platform__stack:hover .hero-layered-platform__layer--applications {
      transform: translate3d(-50%, calc(-50% + var(--layer-y) - 0.45rem), 0);
    }

    .hero-layered-platform__stack:hover .hero-layered-platform__layer--guest-systems {
      transform: translate3d(-50%, calc(-50% + var(--layer-y) - 0.3rem), 0);
    }

    .hero-layered-platform__stack:hover .hero-layered-platform__layer--xen-hypervisor {
      transform: translate3d(-50%, calc(-50% + var(--layer-y) - 0.18rem), 0);
      filter: brightness(1.1) saturate(1.12);
    }
  }

  @media (max-width: 63.9375rem) {
    .hero-layered-platform {
      width: min(100%, 42rem);
    }

    .hero-layered-platform__stage {
      min-height: clamp(25rem, 74vw, 34rem);
    }

    .hero-layered-platform__stack {
      inset: 0;
    }

    .hero-layered-platform__layer {
      width: min(100%, 38rem);
      transform: translate3d(-50%, calc(-50% + var(--layer-mobile-y)), 0);
    }

    .hero-layered-platform__labels {
      display: none;
    }

    .hero-layered-platform__guides {
      inset-inline: 9%;
    }
  }

  @media (max-width: 39.9375rem) {
    .hero-layered-platform__stage {
      min-height: clamp(21rem, 90vw, 27rem);
    }

    .hero-layered-platform__layer {
      width: 33rem;
      max-width: 118vw;
    }

    .hero-layered-platform__aura,
    .hero-layered-platform__grid {
      inset-inline: -14%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-layered-platform__stack {
      animation: none;
    }

    .hero-layered-platform__layer {
      transition: none;
      will-change: auto;
    }
  }
</style>
