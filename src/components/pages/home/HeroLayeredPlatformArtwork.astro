---
import {Picture} from 'astro:assets';
import applicationsSrc from '../../../assets/illustrations/layered-platform/applications.png';
import guestSystemsSrc from '../../../assets/illustrations/layered-platform/guest-systems.png';
import hardwareSrc from '../../../assets/illustrations/layered-platform/hardware.png';
import xenHypervisorSrc from '../../../assets/illustrations/layered-platform/xen-hypervisor.png';

const descriptionId = 'hero-layered-platform-description';

const layers = [
  {
    key: 'applications',
    title: 'Applications',
    description: 'Workloads and services running in user space.',
    src: applicationsSrc,
    y: '-14.5rem',
    mobileY: '-10.25rem',
    hoverY: '-0.5rem',
    parallax: 4,
    icon: 'i-carbon-application-web',
  },
  {
    key: 'guest-systems',
    title: 'Guest systems',
    description: 'Isolated operating systems and runtimes.',
    src: guestSystemsSrc,
    y: '-5.25rem',
    mobileY: '-3.75rem',
    hoverY: '-0.3125rem',
    parallax: 3,
    icon: 'i-carbon-virtual-machine',
  },
  {
    key: 'xen-hypervisor',
    title: 'Xen hypervisor',
    description: 'The thin virtualization control layer that provides isolation and manages hardware.',
    src: xenHypervisorSrc,
    y: '3.75rem',
    mobileY: '2.7rem',
    hoverY: '-0.1875rem',
    parallax: 2,
    icon: '',
  },
  {
    key: 'hardware',
    title: 'Hardware',
    description: 'Physical compute resources.',
    src: hardwareSrc,
    y: '13rem',
    mobileY: '9.25rem',
    hoverY: '0rem',
    parallax: 1,
    icon: 'i-carbon-chip',
  },
];

const paintedLayers = [...layers].reverse();
---

<figure
  class="hero-layered-platform"
  role="img"
  aria-labelledby={descriptionId}
  data-hero-layered-platform
  data-motion="subtle"
>
  <figcaption id={descriptionId} class="hero-layered-platform__description">
    Exploded Xen architecture scene showing applications above guest systems, a thin luminous Xen hypervisor layer, and a substantial hardware platform foundation.
  </figcaption>

  <div class="hero-layered-platform__stage" aria-hidden="true">
    <div class="hero-layered-platform__aura"></div>
    <div class="hero-layered-platform__grid"></div>
    <div class="hero-layered-platform__guides">
      <span style="--guide-x: var(--guide-left-x);"></span>
      <span style="--guide-x: var(--guide-right-x);"></span>
    </div>

    <div class="hero-layered-platform__stack">
      {paintedLayers.map(layer => (
        <div
          class:list={[
            'hero-layered-platform__layer',
            `hero-layered-platform__layer--${layer.key}`,
          ]}
          style={`--layer-y: ${layer.y}; --layer-mobile-y: ${layer.mobileY}; --layer-hover-y: ${layer.hoverY}; --layer-parallax-strength: ${layer.parallax};`}
          data-platform-layer={layer.key}
          data-platform-layer-asset="image"
        >
          <Picture
            src={layer.src}
            alt=""
            widths={[736, 920, 1104, 1472]}
            sizes="(max-width: 639px) 100vw, (max-width: 1023px) 38rem, 46rem"
            formats={['avif', 'webp']}
            loading="eager"
            decoding="async"
            fetchpriority={layer.key === 'applications' ? 'high' : 'auto'}
          />
        </div>
      ))}
    </div>

    <div class="hero-layered-platform__labels">
      {layers.map(layer => (
        <div class:list={[
          'hero-layered-platform__label',
          `hero-layered-platform__label--${layer.key}`,
        ]} style={`--layer-y: ${layer.y}; --layer-mobile-y: ${layer.mobileY};`}>
          <span class="hero-layered-platform__connector" aria-hidden="true">
            <span class="hero-layered-platform__connector-line"></span>
            <span class="hero-layered-platform__connector-node hero-layered-platform__connector-node--layer"></span>
            <span class="hero-layered-platform__connector-node hero-layered-platform__connector-node--label"></span>
          </span>
          <span class="hero-layered-platform__icon" aria-hidden="true">
            {layer.key === 'xen-hypervisor' ? (
              <svg class="hero-layered-platform__xen-mark" viewBox="0 0 24 24" focusable="false">
                <path d="M4.2 3.8h4.1l3.8 5.6 3.7-5.6h4l-5.6 8 6 8.4h-4.2l-4.1-6-4 6h-4.1l6-8.4-5.6-8z" />
              </svg>
            ) : (
              <span class={['hero-layered-platform__icon-glyph', layer.icon].filter(Boolean).join(' ')}></span>
            )}
          </span>
          <span class="hero-layered-platform__label-copy">
            <strong>{layer.title}</strong>
            <small>{layer.description}</small>
          </span>
        </div>
      ))}
    </div>
  </div>
</figure>

<script>
  const mediaQuery = globalThis.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointerQuery = globalThis.matchMedia('(pointer: fine)');
  const stage = document.querySelector<HTMLElement>('[data-hero-layered-platform]');

  if (stage && !mediaQuery.matches && finePointerQuery.matches) {
    const layers = [...stage.querySelectorAll<HTMLElement>('[data-platform-layer]')];
    let frame = 0;
    let targetX = 0;
    let targetY = 0;

    const updateParallax = () => {
      frame = 0;
      for (const layer of layers) {
        const strength = Number(layer.style.getPropertyValue('--layer-parallax-strength')) || 0;
        layer.style.setProperty('--layer-pointer-x', `${(targetX * strength).toFixed(3)}px`);
        layer.style.setProperty('--layer-pointer-y', `${(targetY * strength * -0.45).toFixed(3)}px`);
      }
    };

    stage.addEventListener('pointermove', event => {
      const rect = stage.getBoundingClientRect();
      targetX = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      targetY = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

      if (frame === 0) {
        frame = globalThis.requestAnimationFrame(updateParallax);
      }
    });

    stage.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;

      if (frame === 0) {
        frame = globalThis.requestAnimationFrame(updateParallax);
      }
    });
  }
</script>

<style>
  .hero-layered-platform {
    position: relative;
    --stage-label-width: clamp(12.4rem, 16vw, 14.8rem);
    --stage-label-right-offset: clamp(0.55rem, 1vw, 1rem);
    --stage-label-zone: calc(var(--stage-label-width) + 2.35rem + var(--callout-gap) + var(--stage-label-right-offset));
    --stage-artwork-width: min(100%, 46rem);
    --callout-gap: clamp(0.28rem, 0.45vw, 0.42rem);
    --callout-line-length: clamp(5.35rem, 7vw, 6.6rem);
    --callout-label-x: calc(100% - var(--stage-label-right-offset) - var(--stage-label-width));
    --callout-rail-x: calc(var(--callout-label-x) - var(--callout-gap) - var(--callout-line-length));
    --callout-y-nudge: 0.04rem;
    --guide-left-x: 27.6%;
    --guide-right-x: 72.4%;
    --stage-guide-opacity: 0.54;
    --stage-guide-glow: 0.18;
    --stage-aura-opacity: 0.82;
    --stage-grid-opacity: 0.13;
    --stage-xen-glow-opacity: 0.16;
    width: min(100%, 62rem);
    margin: 0;
    margin-inline: auto;
    overflow: visible;
  }

  .hero-layered-platform__description {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-layered-platform__stage {
    position: relative;
    min-height: clamp(32rem, 55vw, 45rem);
    overflow: visible;
    isolation: isolate;
    contain: layout;
  }

  .hero-layered-platform__aura,
  .hero-layered-platform__grid,
  .hero-layered-platform__lighting,
  .hero-layered-platform__stage::before,
  .hero-layered-platform__stage::after {
    position: absolute;
    pointer-events: none;
    inset: -10% -7% -9% -13%;
    z-index: 0;
  }

  .hero-layered-platform__aura {
    opacity: var(--stage-aura-opacity);
    background:
      radial-gradient(circle at 46% 59%, rgb(140 255 0 / var(--stage-xen-glow-opacity)), transparent 17rem),
      radial-gradient(circle at 58% 35%, rgb(58 152 255 / 0.11), transparent 25rem),
      radial-gradient(ellipse at 43% 78%, rgb(0 0 0 / 0.5), transparent 32rem);
    filter: blur(22px);
    mask-image: radial-gradient(ellipse at 45% 56%, black 0 42%, transparent 80%);
  }

  .hero-layered-platform__stage::before,
  .hero-layered-platform__stage::after {
    content: "";
  }

  .hero-layered-platform__stage::before {
    z-index: 1;
    background:
      linear-gradient(105deg, transparent 15%, rgb(255 255 255 / 0.08) 32%, transparent 49%),
      radial-gradient(ellipse at 42% 52%, transparent 0 36%, rgb(1 5 12 / 0.14) 72%, transparent 90%);
    mix-blend-mode: screen;
    opacity: 0.24;
    mask-image: radial-gradient(ellipse at 43% 51%, black 0 43%, transparent 74%);
    animation: hero-platform-specular 18s linear infinite;
  }

  .hero-layered-platform__stage::after {
    z-index: 2;
    background: radial-gradient(ellipse at 43% 57%, transparent 0 40%, rgb(2 6 14 / 0.17) 77%, transparent 93%);
    opacity: 0.56;
    mix-blend-mode: multiply;
  }

  .hero-layered-platform__grid {
    opacity: var(--stage-grid-opacity);
    background-image:
      linear-gradient(rgb(79 179 255 / 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgb(79 179 255 / 0.13) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(58rem) rotateX(62deg) rotateZ(-28deg) translate3d(-4.25rem, 16.25rem, 0);
    transform-origin: center;
    mask-image: radial-gradient(ellipse at 42% 62%, black 0 28%, transparent 72%);
  }

  .hero-layered-platform__guides {
    position: absolute;
    inset: 13% var(--stage-label-zone) 17% 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero-layered-platform__guides span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--guide-x);
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgb(79 179 255 / 0.36) 19%,
      rgb(140 255 0 / 0.44) 63%,
      transparent
    );
    opacity: var(--stage-guide-opacity);
    box-shadow: 0 0 14px rgb(79 179 255 / var(--stage-guide-glow));
  }

  .hero-layered-platform__stack {
    position: absolute;
    z-index: 3;
    inset: 0 var(--stage-label-zone) 0 0;
    animation: hero-platform-float 8s var(--xp-ease-standard) infinite;
  }

  .hero-layered-platform__layer {
    position: absolute;
    --layer-hover-shift: 0rem;
    --layer-pointer-x: 0px;
    --layer-pointer-y: 0px;
    top: 50%;
    left: 50%;
    width: var(--stage-artwork-width);
    transform: translate3d(
        calc(-50% + var(--layer-pointer-x)),
        calc(-50% + var(--layer-y) + var(--layer-hover-shift) + var(--layer-pointer-y)),
        0
      )
      scale(var(--layer-scale, 1));
    transition:
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 620ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 620ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .hero-layered-platform__layer img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    filter:
      drop-shadow(0 2.2rem 2rem rgb(0 0 0 / 0.36))
      drop-shadow(0 0 1.2rem rgb(79 179 255 / 0.14));
  }

  .hero-layered-platform__layer--applications {
    --layer-scale: 0.985;
    z-index: 4;
  }

  .hero-layered-platform__layer--applications img {
    filter:
      brightness(1.025)
      contrast(1.015)
      drop-shadow(0 1.8rem 1.7rem rgb(0 0 0 / 0.3))
      drop-shadow(0 0 1.1rem rgb(79 179 255 / 0.15));
  }

  .hero-layered-platform__layer--guest-systems {
    --layer-scale: 0.995;
    z-index: 3;
  }

  .hero-layered-platform__layer--guest-systems img {
    filter:
      brightness(1.01)
      contrast(1.01)
      drop-shadow(0 2.1rem 1.85rem rgb(0 0 0 / 0.34))
      drop-shadow(0 0 1.2rem rgb(79 179 255 / 0.13));
  }

  .hero-layered-platform__layer--xen-hypervisor {
    z-index: 2;
  }

  .hero-layered-platform__layer--xen-hypervisor img {
    filter:
      brightness(1.035)
      contrast(1.04)
      saturate(1.04)
      drop-shadow(0 1.3rem 1.2rem rgb(0 0 0 / 0.38))
      drop-shadow(0 0 1.3rem rgb(140 255 0 / 0.34));
  }

  .hero-layered-platform__layer--hardware {
    z-index: 1;
  }

  .hero-layered-platform__layer--hardware img {
    filter:
      brightness(0.98)
      contrast(1.025)
      drop-shadow(0 3rem 2.6rem rgb(0 0 0 / 0.56))
      drop-shadow(0 0 1rem rgb(140 255 0 / 0.14));
  }

  .hero-layered-platform__labels {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
    animation: hero-platform-float 8s var(--xp-ease-standard) infinite;
  }

  .hero-layered-platform__label {
    position: absolute;
    top: calc(50% + var(--layer-y) + var(--callout-y-nudge));
    left: var(--callout-label-x);
    display: grid;
    grid-template-columns: 1.85rem minmax(0, 1fr);
    column-gap: 0.55rem;
    align-items: center;
    width: var(--stage-label-width);
    max-width: 100%;
    color: var(--xp-text-secondary);
    opacity: 0.94;
    transform: translateY(-50%);
  }

  .hero-layered-platform__connector {
    position: absolute;
    top: 50%;
    right: calc(100% + var(--callout-gap));
    display: block;
    width: var(--callout-line-length);
    height: 0.85rem;
    color: var(--connector-color, currentColor);
    opacity: 0.64;
    transform: translateY(-50%);
  }

  .hero-layered-platform__connector-line {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, currentColor, rgb(198 214 235 / 0.34));
    transform: translateY(-50%);
  }

  .hero-layered-platform__connector-node {
    position: absolute;
    top: 50%;
    display: block;
    border-radius: 999px;
    background: currentColor;
    transform: translateY(-50%);
  }

  .hero-layered-platform__connector-node--layer {
    left: -0.18rem;
    width: 0.38rem;
    height: 0.38rem;
    box-shadow: 0 0 0 1px rgb(4 8 14 / 0.82), 0 0 0.44rem currentColor;
  }

  .hero-layered-platform__connector-node--label {
    right: -0.08rem;
    width: 0.24rem;
    height: 0.24rem;
    opacity: 0.72;
  }

  .hero-layered-platform__icon {
    display: grid;
    width: 1.85rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(198 214 235 / 0.24);
    border-radius: 0.42rem;
    background: rgb(5 8 14 / 0.46);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 0.4rem 1rem rgb(0 0 0 / 0.16);
    color: currentColor;
    font-size: 1rem;
    line-height: 1;
  }

  .hero-layered-platform__icon-glyph {
    display: block;
  }

  .hero-layered-platform__xen-mark {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .hero-layered-platform__label strong {
    display: block;
    color: var(--xp-text-primary);
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-layered-platform__label small {
    display: block;
    margin-top: 0.25rem;
    color: rgb(220 230 245 / 0.8);
    font-size: clamp(0.82rem, 0.9vw, 0.875rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .hero-layered-platform__label--applications,
  .hero-layered-platform__label--guest-systems {
    color: #4da7ea;
  }

  .hero-layered-platform__label--xen-hypervisor {
    color: #8cff00;
    --connector-color: #8cff00;
  }

  .hero-layered-platform__label--hardware {
    color: #97a3b5;
  }

  .hero-layered-platform__label--xen-hypervisor .hero-layered-platform__icon {
    border-color: rgb(140 255 0 / 0.24);
    background: rgb(133 194 65 / 0.11);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 0 0.78rem rgb(140 255 0 / 0.14);
  }

  .hero-layered-platform__label--xen-hypervisor strong {
    color: color-mix(in srgb, var(--xp-text-primary) 88%, #8cff00);
  }

  @keyframes hero-platform-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -0.45rem, 0);
    }
  }

  @keyframes hero-platform-specular {
    0% {
      transform: translate3d(-10%, -2%, 0);
      opacity: 0.06;
    }

    36%,
    70% {
      opacity: 0.28;
    }

    100% {
      transform: translate3d(10%, 2%, 0);
      opacity: 0.08;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-layered-platform:hover .hero-layered-platform__layer {
      --layer-hover-shift: var(--layer-hover-y);
    }

    .hero-layered-platform:hover .hero-layered-platform__layer:not(.hero-layered-platform__layer--xen-hypervisor) img {
      filter:
        brightness(0.965)
        contrast(1.01)
        drop-shadow(0 2.1rem 1.9rem rgb(0 0 0 / 0.37))
        drop-shadow(0 0 1rem rgb(79 179 255 / 0.1));
    }

    .hero-layered-platform:hover .hero-layered-platform__layer--hardware img {
      filter:
        brightness(0.955)
        contrast(1.025)
        drop-shadow(0 3rem 2.6rem rgb(0 0 0 / 0.58))
        drop-shadow(0 0 0.95rem rgb(140 255 0 / 0.12));
    }

    .hero-layered-platform:hover .hero-layered-platform__layer--xen-hypervisor img {
      filter:
        brightness(1.11)
        contrast(1.1)
        saturate(1.08)
        drop-shadow(0 1.35rem 1.2rem rgb(0 0 0 / 0.4))
        drop-shadow(0 0 1.45rem rgb(140 255 0 / 0.42));
    }

    .hero-layered-platform:hover .hero-layered-platform__label:not(.hero-layered-platform__label--xen-hypervisor) {
      opacity: 0.8;
    }

    .hero-layered-platform:hover .hero-layered-platform__label--xen-hypervisor {
      opacity: 1;
    }
  }

  @media (max-width: 63.9375rem) {
    .hero-layered-platform {
      --stage-label-zone: 0rem;
      --stage-artwork-width: min(100%, 38rem);
      width: min(100%, 42rem);
    }

    .hero-layered-platform__stage {
      min-height: clamp(25rem, 74vw, 34rem);
    }

    .hero-layered-platform__layer {
      transform: translate3d(
          calc(-50% + var(--layer-pointer-x)),
          calc(
            -50% + var(--layer-mobile-y) + var(--layer-hover-shift) + var(--layer-pointer-y)
          ),
          0
        )
        scale(var(--layer-scale, 1));
    }

    .hero-layered-platform__labels {
      display: none;
    }

    .hero-layered-platform__guides {
      inset-inline: 9%;
    }
  }

  @media (max-width: 39.9375rem) {
    .hero-layered-platform {
      --stage-artwork-width: min(100%, 33rem);
    }

    .hero-layered-platform__stage {
      min-height: clamp(21rem, 90vw, 27rem);
    }

    .hero-layered-platform__aura,
    .hero-layered-platform__grid {
      inset-inline: -14%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-layered-platform__stage::before {
      animation: none;
    }

    .hero-layered-platform__stack {
      animation: none;
    }

    .hero-layered-platform__labels {
      animation: none;
    }

    .hero-layered-platform__layer {
      transition: none;
      will-change: auto;
    }
  }
</style>
