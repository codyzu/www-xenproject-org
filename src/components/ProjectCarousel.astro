---
import Card from './Card.astro';
import type {Project} from '../data/projects';

type Props = {
  projects: Project[];
};

const {projects} = Astro.props;
---

<div class="carousel-container mg-t-lg" data-project-carousel role="region" aria-label="Xen Project technologies">
  <div class="carousel-content">
    <div class="carousel-content-inner">
      <div class="carousel">
        {projects.map((project) => (
          <Card title={project.title} class="carousel-item project-carousel-card">
            <p>{project.description}</p>
            <a href={project.route} class="btn btn-tertiary">Discover <i class="fas fa-arrow-right"></i></a>
          </Card>
        ))}
      </div>
    </div>
    <div class="carousel-buttons">
      <button class="carousel-button prev" type="button" aria-label="Previous projects">
        <i class="fas fa-arrow-left"></i>
      </button>
      <button class="carousel-button next" type="button" aria-label="Next projects">
        <i class="fas fa-arrow-right"></i>
      </button>
    </div>
  </div>
</div>

<script>
  import {initializeCarousel} from '../scripts/carousel';

  document.documentElement.classList.add('has-js');

  for (const root of document.querySelectorAll<HTMLElement>('[data-project-carousel]')) {
    initializeCarousel(root);
  }
</script>
