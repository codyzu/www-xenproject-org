---
type Props = {
  as?: 'div' | 'section';
  align?: 'start' | 'center';
  breakpoint?: 'lg' | 'xl';
  class?: string;
};

const {
  as = 'div',
  align = 'start',
  breakpoint = 'lg',
  class: className = '',
} = Astro.props as Props;

const Tag = as;
const layoutClasses = {
  lg: 'lg:uno-grid-cols-[minmax(0,1fr)_minmax(22rem,0.72fr)]',
  xl: 'xl:uno-grid-cols-[minmax(0,1fr)_minmax(22rem,0.72fr)]',
};
const alignClasses = {
  lg: {
    start: 'lg:uno-items-start',
    center: 'lg:uno-items-center',
  },
  xl: {
    start: 'xl:uno-items-start',
    center: 'xl:uno-items-center',
  },
};
---

<Tag class:list={[
  'uno-grid uno-min-w-0 uno-grid-cols-1 uno-gap-6',
  layoutClasses[breakpoint],
  alignClasses[breakpoint][align],
  className,
]}>
  <slot />
</Tag>
