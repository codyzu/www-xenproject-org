---
type Props = {
  as?: 'div' | 'section';
  align?: 'start' | 'center';
  class?: string;
};

const {
  as = 'div',
  align = 'start',
  class: className = '',
} = Astro.props as Props;

const Tag = as;
const alignClasses = {
  start: 'lg:uno-items-start',
  center: 'lg:uno-items-center',
};
---

<Tag class:list={[
  'uno-grid uno-min-w-0 uno-grid-cols-1 uno-gap-6 lg:uno-grid-cols-[minmax(0,1fr)_minmax(22rem,0.72fr)]',
  alignClasses[align],
  className,
]}>
  <slot />
</Tag>
