---
type HeadingLevel = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
type HeadingSize = 'display-xl' | 'display-l' | 'heading-xl' | 'heading-l' | 'heading-m' | 'hero' | 'display' | 'section' | 'subsection' | 'card';
type HeadingTone = 'primary' | 'muted' | 'on-light';

type Props = {
  as?: HeadingLevel;
  size?: HeadingSize;
  tone?: HeadingTone;
  class?: string;
};

const {
  as = 'h2',
  size = 'section',
  tone = 'primary',
  class: className = '',
} = Astro.props as Props;

const Tag = as;
const sizeClasses: Record<HeadingSize, string> = {
  'display-xl': 'uno-text-5xl md:uno-text-[length:var(--xp-type-display-xl)] uno-font-extrabold uno-leading-[var(--xp-line-tight)]',
  'display-l': 'uno-text-4xl md:uno-text-[length:var(--xp-type-display-l)] uno-font-extrabold uno-leading-[var(--xp-line-tight)]',
  'heading-xl': 'uno-text-4xl md:uno-text-[length:var(--xp-type-heading-xl)]',
  'heading-l': 'uno-text-3xl md:uno-text-[length:var(--xp-type-heading-l)]',
  'heading-m': 'uno-text-[length:var(--xp-type-heading-m)]',
  hero: 'uno-text-5xl md:uno-text-[length:var(--xp-type-display-xl)] uno-font-extrabold uno-leading-[var(--xp-line-tight)]',
  display: 'uno-text-4xl md:uno-text-[length:var(--xp-type-display-l)] uno-font-extrabold uno-leading-[var(--xp-line-tight)]',
  section: 'uno-text-3xl md:uno-text-[length:var(--xp-type-heading-l)]',
  subsection: 'uno-text-2xl md:uno-text-[length:var(--xp-type-heading-m)]',
  card: 'uno-text-xl',
};
const toneClasses: Record<HeadingTone, string> = {
  primary: 'uno-text-xp-text-primary',
  muted: 'uno-text-xp-text-secondary',
  'on-light': 'uno-text-[var(--xp-text-on-light)]',
};
---

<Tag class:list={[
  'uno-m-0 uno-min-w-0 uno-break-words uno-font-sans uno-font-bold uno-leading-[var(--xp-line-heading)]',
  sizeClasses[size],
  toneClasses[tone],
  className,
]}>
  <slot />
</Tag>
