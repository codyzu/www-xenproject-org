---
type ButtonVariant = 'primary' | 'secondary' | 'text';
type ButtonType = 'button' | 'submit' | 'reset';

type Props = {
  href?: string;
  variant?: ButtonVariant;
  type?: ButtonType;
  target?: '_blank';
  rel?: string;
  class?: string;
};

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const variantClasses: Record<ButtonVariant, string> = {
  primary: 'xen-action-primary',
  secondary: 'xen-action-secondary',
  text: 'xen-action-text hover:xen-action-text-hover active:xen-action-text-active',
};
const classes = [variantClasses[variant], className];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
  </button>
)}
