---
import type {DownloadGroup} from '../data/downloads';

type Props = {groups: DownloadGroup[]};
const {groups} = Astro.props;
---

<div class="vertical-lists" style={`--cols:${Math.min(groups.length, 3)}`}>
  {groups.map((group) => (
    <div class="list-column list-column--sublists">
      <h2>{group.name}</h2>
      <ul>
        {group.versions.map((version) => (
          <li>
            {'link' in version && version.link ? <a href={version.link}><span>{group.name} {version.name === 'default' ? 'Download' : version.name}</span><i class="fas fa-arrow-right"></i></a> : <span>{group.name} {version.name === 'default' ? 'Download' : `${version.name} Series`}</span>}
            <ul>
              {('subversions' in version ? version.subversions : version.files.map((file) => ({name: file.name, link: file.url, files: []}))).map((release) => (
                <li><a href={release.link}><span>{group.name} {release.name}</span><i class="fas fa-arrow-right"></i></a></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
