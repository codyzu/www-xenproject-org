---
import Layer from './Layer.astro';
import type {PlatformLayersDiagramData} from './platform-layers';

type Props = PlatformLayersDiagramData & {
  id?: string;
};

const {
  id = 'platform-layers',
  title,
  metaLabel,
  summary,
  layers,
  variant = 'standard',
} = Astro.props;

const titleId = `${id}-title`;
const summaryId = `${id}-summary`;
const midpoint = (layers.length - 1) / 2;
const itemCounts = layers.map(layer => layer.items?.length ?? 0);
const maximumItemCount = Math.max(0, ...itemCounts);
// Conservative input heuristics reserve space before rendering; geometry never
// depends on viewport-time DOM measurement or page-specific offsets.
const hasDenseLayer = layers.some((layer, index) =>
  itemCounts[index] >= 4 || layer.title.length > 30 || layer.description.length > 110,
);
const layerDepth = [
  'var(--platform-plate-height)',
  ...Array.from({length: Math.max(layers.length - 1, 0)}, () => 'var(--platform-layer-gap)'),
].join(' + ');
const heroHoverOffsets = [
  {x: '0.18rem', y: '-0.24rem'},
  {x: '0.12rem', y: '-0.16rem'},
  {x: '0.06rem', y: '-0.08rem'},
  {x: '0.02rem', y: '-0.03rem'},
];
---

<figure
  class:list={[
    'xp-platform-diagram',
    `xp-platform-diagram--${variant}`,
    `xp-platform-diagram--layers-${Math.min(Math.max(layers.length, 3), 6)}`,
    `xp-platform-diagram--max-items-${Math.min(maximumItemCount, 4)}`,
    hasDenseLayer && 'xp-platform-diagram--density-dense',
  ]}
  style={`--platform-layer-count: ${layers.length}; --platform-max-item-count: ${maximumItemCount};`}
  aria-labelledby={titleId}
  tabindex="0"
>
  <figcaption class="xp-platform-diagram__header">
    <p class="xp-platform-diagram__eyebrow" id={titleId}>{title}</p>
    {metaLabel && <span class="xp-platform-diagram__scale" aria-hidden="true">{metaLabel}</span>}
  </figcaption>

  <div class="xp-platform-stack" style={`--platform-stack-depth: calc(${layerDepth});`} aria-describedby={summaryId}>
    <div class="xp-platform-stack__plates">
      {layers.map((layer, index) => {
        const offsetStep = index - midpoint;
        const receivesShadow = index > 0;
        const hoverOffset = variant === 'hero' ? (heroHoverOffsets[index] ?? heroHoverOffsets[heroHoverOffsets.length - 1]) : undefined;

        return (
          <Layer
            title={layer.title}
            eyebrow={layer.eyebrow}
            tone={layer.tone}
            emphasis={layer.emphasis}
            offset={`calc(var(--platform-layer-gap) * ${offsetStep})`}
            bodyWidth={variant === 'hero' ? '22rem' : '28rem'}
            hoverX={hoverOffset?.x}
            hoverY={hoverOffset?.y}
            zIndex={layers.length - index}
            receivesShadow={receivesShadow}
          >
            <p>{layer.description}</p>
            {layer.items && layer.items.length > 0 && (
              <ul
                class:list={['xp-domain-strip', `xp-domain-strip--items-${Math.min(layer.items.length, 5)}`]}
              >
                {layer.items.map(item => (
                  <li>
                    {item.icon && <i class:list={['xp-domain-icon', item.icon]} aria-hidden="true"></i>}
                    {item.label}
                  </li>
                ))}
              </ul>
            )}
          </Layer>
        );
      })}
    </div>
  </div>

  <p class="xp-platform-diagram__summary" id={summaryId}>
    {summary}
  </p>
</figure>

<style>
  .xp-platform-diagram {
    --platform-perspective: 88rem;
    --platform-rotate-x: 32deg;
    --platform-rotate-z: -10deg;
    position: relative;
    width: 100%;
    max-width: none;
    min-width: 0;
    margin: 0;
    padding: clamp(0.9rem, 1.8vw, 1.15rem);
    overflow: hidden;
    border: 1px solid rgb(198 214 235 / 0.12);
    border-radius: var(--xp-radius-lg);
    background:
      radial-gradient(circle at 74% 18%, rgb(133 194 65 / 0.16), transparent 32%),
      linear-gradient(145deg, rgb(255 255 255 / 0.03), transparent 38%),
      linear-gradient(180deg, rgb(11 19 32 / 0.82), rgb(5 8 14 / 0.22));
    transform: translateY(0);
    transition:
      border-color 560ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .xp-platform-diagram::before {
    content: '';
    position: absolute;
    inset: 0.85rem;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, rgb(198 214 235 / 0.055) 1px, transparent 1px),
      linear-gradient(rgb(198 214 235 / 0.045) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(130deg, transparent 0%, black 26%, black 70%, transparent 100%);
    opacity: 0.92;
    transition: opacity 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .xp-platform-diagram__header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 clamp(1rem, 2vw, 1.35rem);
  }

  .xp-platform-diagram__eyebrow,
  .xp-platform-diagram__scale {
    margin: 0;
    color: var(--xp-accent-primary);
    font-family: var(--xp-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .xp-platform-diagram__scale {
    color: var(--xp-text-muted);
    font-weight: 500;
  }

  .xp-platform-stack {
    --platform-plate-width: min(34rem, 94%);
    --platform-plate-height: clamp(9rem, 14.5vw, 10.4rem);
    --platform-layer-gap: clamp(6.25rem, 9.8vw, 7.35rem);
    --platform-frame-padding-block: clamp(2.35rem, 4.6vw, 3.2rem);
    --platform-overflow-bottom: 0rem;
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    min-height: calc(var(--platform-stack-depth) + var(--platform-frame-padding-block) - var(--platform-overflow-bottom));
    align-content: center;
    padding: clamp(0.65rem, 1.6vw, 0.95rem) 0 clamp(1.7rem, 3vw, 2.25rem);
  }

  .xp-platform-diagram--hero {
    --platform-perspective: 58rem;
    --platform-rotate-x: 54deg;
    --platform-rotate-z: -24deg;
    max-width: 45rem;
    padding: clamp(1rem, 2.2vw, 1.35rem);
  }

  .xp-platform-diagram {
    outline-offset: 0.45rem;
  }

  .xp-platform-diagram:is(:hover, :focus-visible, :focus-within) {
    border-color: rgb(198 214 235 / 0.2);
    filter: brightness(1.055);
    transform: translateY(-0.28rem);
  }

  .xp-platform-diagram:is(:hover, :focus-visible, :focus-within)::before {
    opacity: 1;
  }

  .xp-platform-diagram--hero:is(:hover, :focus-visible, :focus-within) :global(.xp-diagram-layer) {
    --layer-extra-x: var(--layer-hover-x);
    --layer-extra-y: var(--layer-hover-y);
  }

  .xp-platform-diagram:is(:hover, :focus-visible, :focus-within) :global(.xp-diagram-layer__surface) {
    filter: brightness(1.035);
    border-color: color-mix(in srgb, var(--layer-edge) 88%, white);
    box-shadow:
      1rem 1.35rem 2.7rem -1.25rem rgb(0 0 0 / 0.68),
      0.3rem 0.48rem 1.15rem -0.72rem rgb(0 0 0 / 0.46),
      0 0 1.65rem -0.9rem color-mix(in srgb, var(--layer-accent) 38%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      inset 1px 0 0 rgb(255 255 255 / 0.12),
      inset -1px -1px 0 rgb(0 0 0 / 0.16);
  }

  .xp-platform-diagram:is(:hover, :focus-visible, :focus-within) :global(.xp-diagram-layer__surface)::after {
    opacity: 0.78;
  }

  .xp-platform-diagram:is(:hover, :focus-visible, :focus-within) :global(.xp-diagram-layer__receiver) {
    opacity: 0.98;
    box-shadow:
      0 0.86rem 1.35rem rgb(0 0 0 / 0.4),
      inset 0 0 2.2rem rgb(0 0 0 / 0.2);
  }

  .xp-platform-diagram--hero .xp-platform-diagram__header {
    margin-bottom: clamp(1.35rem, 3vw, 2rem);
  }

  .xp-platform-diagram--hero .xp-platform-stack {
    --platform-plate-width: min(36rem, 96%);
    --platform-plate-height: clamp(9.65rem, 18.5vw, 11.85rem);
    --platform-layer-gap: clamp(7.25rem, 13vw, 8.85rem);
    --platform-frame-padding-block: clamp(1.6rem, 4vw, 4.45rem);
    padding-block: clamp(1rem, 3vw, 1.6rem) clamp(2.1rem, 4vw, 2.8rem);
  }

  .xp-platform-diagram--standard .xp-platform-stack {
    --platform-plate-width: min(39rem, 96%);
    --platform-plate-height: clamp(11.5rem, 18vw, 12.5rem);
    --platform-layer-gap: clamp(9.4rem, 14vw, 10.5rem);
    --platform-frame-padding-block: clamp(3rem, 4.5vw, 3.75rem);
    padding-block: clamp(1rem, 2vw, 1.35rem) clamp(2.25rem, 3.5vw, 3rem);
  }

  .xp-platform-diagram--standard.xp-platform-diagram--density-dense .xp-platform-stack {
    --platform-plate-height: clamp(12.5rem, 20vw, 13.25rem);
    --platform-layer-gap: clamp(11.25rem, 17vw, 12.25rem);
  }

  .xp-platform-diagram--standard.xp-platform-diagram--layers-5 .xp-platform-stack,
  .xp-platform-diagram--standard.xp-platform-diagram--layers-6 .xp-platform-stack {
    --platform-layer-gap: clamp(9.8rem, 15vw, 11rem);
  }

  .xp-platform-diagram--hero.xp-platform-diagram--layers-5 .xp-platform-stack,
  .xp-platform-diagram--hero.xp-platform-diagram--layers-6 .xp-platform-stack {
    --platform-plate-height: clamp(11.75rem, 20vw, 12.75rem);
    --platform-layer-gap: clamp(7.5rem, 12vw, 8.4rem);
    --platform-frame-padding-block: clamp(3rem, 4.5vw, 4rem);
    padding-bottom: clamp(2.8rem, 5vw, 3.8rem);
  }

  .xp-platform-diagram--hero .xp-platform-stack__plates {
    translate: clamp(-1.35rem, -2vw, -0.75rem) clamp(0.75rem, 1.8vw, 1.25rem);
  }

  .xp-platform-diagram--standard .xp-platform-stack {
    --platform-overflow-bottom: clamp(0.2rem, 0.7vw, 0.45rem);
  }

  .xp-platform-diagram--hero .xp-platform-stack {
    --platform-overflow-bottom: clamp(0.55rem, 1.6vw, 1.05rem);
  }

  .xp-platform-diagram {
    overflow: visible;
  }

  .xp-platform-diagram--hero .xp-domain-strip {
    max-width: 20rem;
    gap: 0.6rem;
  }

  .xp-platform-diagram--hero .xp-domain-strip li {
    font-size: 0.72rem;
  }

  .xp-platform-stack__plates {
    position: relative;
    z-index: 1;
    display: grid;
    width: var(--platform-plate-width);
    min-width: 0;
    height: var(--platform-plate-height);
    margin-inline: auto;
    translate: clamp(-1rem, -1.5vw, -0.55rem) clamp(0.25rem, 0.7vw, 0.5rem);
    transform-style: preserve-3d;
  }

  .xp-platform-diagram--standard .xp-platform-stack__plates {
    translate: clamp(-0.4rem, -0.6vw, -0.2rem) clamp(0.18rem, 0.45vw, 0.35rem);
  }

  .xp-platform-diagram--standard :global(.xp-diagram-layer__content) {
    padding: clamp(1.2rem, 2.5vw, 1.7rem) clamp(1.35rem, 3.5vw, 2.15rem);
  }

  .xp-platform-diagram--standard :global(.xp-diagram-layer__title) {
    font-size: clamp(1.08rem, 2.2vw, 1.34rem);
  }

  .xp-platform-diagram--standard :global(.xp-diagram-layer__body) {
    gap: 0.82rem;
    margin-top: 0.72rem;
    font-size: clamp(0.84rem, 1.55vw, 0.96rem);
    line-height: 1.42;
  }

  .xp-domain-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 26rem;
    margin: 0;
    padding: 0;
    gap: 0.45rem;
  }

  .xp-domain-strip--items-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 21rem;
    column-gap: 0.8rem;
    row-gap: 0.4rem;
  }

  .xp-domain-strip--items-1,
  .xp-domain-strip--items-2 {
    grid-template-columns: repeat(2, minmax(0, max-content));
  }

  .xp-domain-strip li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    color: var(--xp-text-secondary);
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1.2;
    list-style: none;
  }

  .xp-domain-icon {
    display: inline-block;
    width: 1.2rem;
    height: 1.2rem;
    color: rgb(103 217 223 / 0.68);
    flex: 0 0 auto;
  }

  .xp-platform-diagram__summary {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 639px) {
    .xp-platform-diagram {
      padding: 1rem;
      border-radius: var(--xp-radius-md);
    }

    .xp-platform-diagram::before {
      inset: 0.65rem;
      background-size: 2rem 2rem;
      opacity: 0.7;
    }

    .xp-platform-diagram__header {
      margin-bottom: 1rem;
    }

    .xp-platform-diagram__scale {
      display: none;
    }

    .xp-platform-stack {
      min-height: auto;
      padding: 0;
    }

    .xp-platform-stack__plates {
      display: grid;
      width: 100%;
      height: auto;
      min-height: auto;
      gap: 0.85rem;
      translate: none;
      transform: none;
    }

    .xp-platform-diagram {
      overflow: hidden;
    }

    .xp-platform-diagram--hero,
    .xp-platform-diagram--standard {
      max-width: none;
    }

    .xp-domain-strip,
    .xp-domain-strip--items-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .xp-platform-diagram--hero {
      margin-left: auto;
    }

    .xp-platform-diagram--hero .xp-platform-stack__plates {
      animation: xp-platform-breathe 12s ease-in-out infinite;
    }

    .xp-platform-diagram::before {
      animation: xp-platform-glow-breathe 14s ease-in-out infinite;
    }

    .xp-platform-diagram :global(.xp-diagram-layer--emphasis-primary .xp-diagram-layer__surface)::after {
      animation: xp-platform-primary-breathe 13s ease-in-out infinite;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .xp-platform-diagram--hero .xp-platform-stack {
      --platform-plate-height: clamp(11.25rem, 22vw, 12rem);
      --platform-overflow-bottom: 0rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xp-platform-diagram,
    .xp-platform-diagram::before,
    :global(.xp-diagram-layer),
    :global(.xp-diagram-layer__surface),
    :global(.xp-diagram-layer__surface)::after,
    :global(.xp-diagram-layer__receiver),
    .xp-platform-stack__plates {
      animation: none !important;
      transition-duration: 1ms !important;
    }

    .xp-platform-diagram:is(:hover, :focus-visible, :focus-within) {
      transform: none;
    }

    .xp-platform-diagram:is(:hover, :focus-visible, :focus-within) :global(.xp-diagram-layer) {
      --layer-extra-x: 0rem;
      --layer-extra-y: 0rem;
    }
  }

  @media print {
    .xp-platform-diagram {
      border: 1px solid #9ca3af;
      background: transparent;
    }

    .xp-platform-diagram::before {
      display: none;
    }
  }

  @keyframes xp-platform-breathe {
    0%,
    100% {
      filter: brightness(1);
      transform: translate3d(0, 0, 0);
    }

    50% {
      filter: brightness(1.025);
      transform: translate3d(0.06rem, -0.1rem, 0);
    }
  }

  @keyframes xp-platform-glow-breathe {
    0%,
    100% {
      opacity: 0.82;
    }

    50% {
      opacity: 1;
    }
  }

  @keyframes xp-platform-primary-breathe {
    0%,
    100% {
      opacity: 0.68;
    }

    50% {
      opacity: 0.88;
    }
  }
</style>
