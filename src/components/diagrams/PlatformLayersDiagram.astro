---
import Layer from './Layer.astro';
import type {PlatformLayersDiagramData} from './platform-layers';

type Props = PlatformLayersDiagramData & {
  id?: string;
  defaultShadowReceivers?: boolean;
  class?: string;
};

const {
  id = 'platform-layers',
  title,
  eyebrow = title,
  metaLabel = 'CSS layer model',
  summary,
  layers,
  variant = 'standard',
  defaultShadowReceivers = true,
  class: className = '',
} = Astro.props;

const titleId = `${id}-title`;
const summaryId = `${id}-summary`;
const midpoint = (layers.length - 1) / 2;
---

<figure
  class:list={[
    'xp-platform-diagram',
    `xp-platform-diagram--${variant}`,
    className,
  ]}
  aria-labelledby={titleId}
>
  <figcaption class="xp-platform-diagram__header">
    <p class="xp-platform-diagram__eyebrow" id={titleId}>{eyebrow}</p>
    {metaLabel && <span class="xp-platform-diagram__scale" aria-hidden="true">{metaLabel}</span>}
  </figcaption>

  <div class="xp-platform-stack" aria-describedby={summaryId}>
    <div class="xp-platform-stack__plates">
      {layers.map((layer, index) => {
        const offsetStep = index - midpoint;
        const receivesShadow = layer.receivesShadow ?? (defaultShadowReceivers && index > 0);

        return (
          <Layer
            title={layer.title}
            eyebrow={layer.eyebrow}
            tone={layer.tone}
            offset={`calc(var(--platform-layer-gap) * ${offsetStep})`}
            bodyWidth={variant === 'hero' ? '22rem' : '28rem'}
            zIndex={layers.length - index}
            receivesShadow={receivesShadow}
          >
            <p>{layer.description}</p>
            {layer.items && layer.items.length > 0 && (
              <div class="xp-domain-strip" aria-label={layer.itemsLabel}>
                {layer.items.map(item => (
                  <span>
                    {item.icon && <i class:list={['xp-domain-icon', item.icon]} aria-hidden="true"></i>}
                    {item.label}
                  </span>
                ))}
              </div>
            )}
          </Layer>
        );
      })}
    </div>
  </div>

  <p class="xp-platform-diagram__summary" id={summaryId}>
    {summary}
  </p>
</figure>

<style>
  .xp-platform-diagram {
    position: relative;
    width: 100%;
    max-width: none;
    min-width: 0;
    margin: 0;
    padding: clamp(0.9rem, 1.8vw, 1.15rem);
    overflow: hidden;
    border: 1px solid rgb(198 214 235 / 0.12);
    border-radius: var(--xp-radius-lg);
    background:
      radial-gradient(circle at 74% 18%, rgb(133 194 65 / 0.16), transparent 32%),
      linear-gradient(145deg, rgb(255 255 255 / 0.03), transparent 38%),
      linear-gradient(180deg, rgb(11 19 32 / 0.82), rgb(5 8 14 / 0.22));
  }

  .xp-platform-diagram::before {
    content: '';
    position: absolute;
    inset: 0.85rem;
    pointer-events: none;
    background-image:
      linear-gradient(90deg, rgb(198 214 235 / 0.055) 1px, transparent 1px),
      linear-gradient(rgb(198 214 235 / 0.045) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(130deg, transparent 0%, black 26%, black 70%, transparent 100%);
  }

  .xp-platform-diagram__header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 clamp(1rem, 2vw, 1.35rem);
  }

  .xp-platform-diagram__eyebrow,
  .xp-platform-diagram__scale {
    margin: 0;
    color: var(--xp-accent-primary);
    font-family: var(--xp-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .xp-platform-diagram__scale {
    color: var(--xp-text-muted);
    font-weight: 500;
  }

  .xp-platform-stack {
    --platform-plate-width: min(34rem, 94%);
    --platform-plate-height: clamp(9rem, 14.5vw, 10.4rem);
    --platform-layer-gap: clamp(6.25rem, 9.8vw, 7.35rem);
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    min-height: clamp(32.5rem, 52vw, 37rem);
    align-content: center;
    padding: clamp(0.65rem, 1.6vw, 0.95rem) 0 clamp(1.7rem, 3vw, 2.25rem);
  }

  .xp-platform-diagram--hero {
    max-width: 45rem;
    padding: clamp(1rem, 2.2vw, 1.35rem);
  }

  .xp-platform-diagram--hero .xp-platform-diagram__header {
    margin-bottom: clamp(1.35rem, 3vw, 2rem);
  }

  .xp-platform-diagram--hero .xp-platform-stack {
    --platform-plate-width: min(36rem, 96%);
    --platform-plate-height: clamp(9.65rem, 18.5vw, 11.85rem);
    --platform-layer-gap: clamp(7.25rem, 13vw, 8.85rem);
    min-height: clamp(33rem, 64vw, 43rem);
    padding-block: clamp(1rem, 3vw, 1.6rem) clamp(2.1rem, 4vw, 2.8rem);
  }

  .xp-platform-diagram--hero .xp-platform-stack__plates {
    translate: clamp(-1.35rem, -2vw, -0.75rem) clamp(0.75rem, 1.8vw, 1.25rem);
  }

  .xp-platform-diagram--hero .xp-domain-strip {
    max-width: 20rem;
    gap: 0.6rem;
  }

  .xp-platform-diagram--hero .xp-domain-strip span {
    font-size: 0.72rem;
  }

  .xp-platform-stack__plates {
    position: relative;
    z-index: 1;
    display: grid;
    width: var(--platform-plate-width);
    min-width: 0;
    height: var(--platform-plate-height);
    margin-inline: auto;
    translate: clamp(-1rem, -1.5vw, -0.55rem) clamp(0.25rem, 0.7vw, 0.5rem);
    transform-style: preserve-3d;
  }

  .xp-domain-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 26rem;
    gap: 0.45rem;
  }

  .xp-domain-strip span {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    color: var(--xp-text-secondary);
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .xp-domain-icon {
    display: inline-block;
    width: 1.2rem;
    height: 1.2rem;
    color: rgb(103 217 223 / 0.68);
    flex: 0 0 auto;
  }

  .xp-platform-diagram__summary {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 639px) {
    .xp-platform-diagram {
      padding: 1rem;
      border-radius: var(--xp-radius-md);
    }

    .xp-platform-diagram::before {
      inset: 0.65rem;
      background-size: 2rem 2rem;
      opacity: 0.7;
    }

    .xp-platform-diagram__header {
      margin-bottom: 1rem;
    }

    .xp-platform-diagram__scale {
      display: none;
    }

    .xp-platform-stack {
      min-height: auto;
      padding: 0;
    }

    .xp-platform-stack__plates {
      display: grid;
      width: 100%;
      height: auto;
      min-height: auto;
      gap: 0.85rem;
      translate: none;
      transform: none;
    }

    .xp-platform-diagram--hero,
    .xp-platform-diagram--standard {
      max-width: none;
    }

    .xp-domain-strip {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) {
    .xp-platform-diagram--hero {
      margin-left: auto;
      overflow: visible;
    }
  }

  @media print {
    .xp-platform-diagram {
      border: 1px solid #9ca3af;
      background: transparent;
    }

    .xp-platform-diagram::before {
      display: none;
    }
  }
</style>
