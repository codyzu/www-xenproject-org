---
interface Props {
  title: string;
  eyebrow?: string;
  tone?: 'applications' | 'guests' | 'xen' | 'hardware';
  width?: string;
  shift?: string;
  offset?: string;
  zIndex?: number;
}

const {
  title,
  eyebrow,
  tone = 'guests',
  width = '100%',
  shift = '0rem',
  offset = '0rem',
  zIndex = 1,
} = Astro.props;
---

<section
  class:list={['xp-diagram-layer', `xp-diagram-layer--${tone}`]}
  style={`--layer-width: ${width}; --layer-shift: ${shift}; --layer-offset: ${offset}; --layer-z: ${zIndex};`}
>
  <div class="xp-diagram-layer__surface">
    <div class="xp-diagram-layer__grid" aria-hidden="true"></div>
    <div class="xp-diagram-layer__content">
      {eyebrow && <p class="xp-diagram-layer__eyebrow">{eyebrow}</p>}
      <p class="xp-diagram-layer__title">{title}</p>
      <div class="xp-diagram-layer__body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .xp-diagram-layer {
    --layer-accent: var(--xp-accent-secondary);
    --layer-accent-soft: rgb(79 179 255 / 0.18);
    --layer-fill: rgb(14 31 55 / 0.9);
    --layer-edge: rgb(79 179 255 / 0.62);
    --layer-glow: rgb(79 179 255 / 0.32);
    position: relative;
    z-index: var(--layer-z);
    width: var(--layer-width);
    height: var(--platform-plate-height, clamp(8rem, 18vw, 10.75rem));
    min-width: 0;
    margin-inline: auto;
    grid-area: 1 / 1;
    transform:
      translate3d(var(--layer-shift), var(--layer-offset), 0)
      perspective(58rem)
      rotateX(54deg)
      rotateZ(-24deg);
    transform-style: preserve-3d;
  }

  .xp-diagram-layer + .xp-diagram-layer {
    margin-top: 0;
  }

  .xp-diagram-layer__surface {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--layer-edge);
    border-radius: 0.9rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.12), transparent 32%),
      linear-gradient(130deg, var(--layer-accent-soft), transparent 50%),
      var(--layer-fill);
    box-shadow:
      0 2.2rem 3.8rem -2.2rem rgb(0 0 0 / 0.82),
      0 0 2.1rem -1rem var(--layer-glow),
      inset 0 1px 0 rgb(255 255 255 / 0.18);
    transform-style: preserve-3d;
  }

  .xp-diagram-layer__surface::before,
  .xp-diagram-layer__surface::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .xp-diagram-layer__surface::before {
    inset: 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.65rem;
  }

  .xp-diagram-layer__surface::after {
    right: clamp(1rem, 6vw, 4rem);
    bottom: 0.95rem;
    width: clamp(3.5rem, 12vw, 6.5rem);
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--layer-accent) 0 0.2rem, transparent 0.2rem 0.65rem);
    opacity: 0.62;
  }

  .xp-diagram-layer__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, color-mix(in srgb, var(--layer-accent) 20%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--layer-accent) 16%, transparent) 1px, transparent 1px);
    background-size: 2rem 2rem;
    mask-image: linear-gradient(90deg, transparent, black 22%, black 74%, transparent);
    opacity: 0.5;
  }

  .xp-diagram-layer__content {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    height: 100%;
    min-height: 0;
    padding: clamp(1.1rem, 3vw, 1.55rem) clamp(1.2rem, 4vw, 2rem);
  }

  .xp-diagram-layer__eyebrow,
  .xp-diagram-layer__title,
  .xp-diagram-layer__body :global(p) {
    margin: 0;
  }

  .xp-diagram-layer__eyebrow {
    color: var(--layer-accent);
    font-family: var(--xp-font-mono);
    font-size: clamp(0.68rem, 1.6vw, 0.74rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .xp-diagram-layer__title {
    margin-top: 0.28rem;
    color: var(--xp-text-primary);
    font-family: var(--xp-font-mono);
    font-size: clamp(1rem, 2.5vw, 1.28rem);
    font-weight: 800;
    line-height: 1.15;
    text-shadow: 0 0.2rem 0.55rem rgb(0 0 0 / 0.34);
    text-transform: uppercase;
  }

  .xp-diagram-layer__body {
    display: grid;
    gap: 0.75rem;
    max-width: 22rem;
    margin-top: 0.68rem;
    color: var(--xp-text-secondary);
    font-size: clamp(0.78rem, 1.7vw, 0.92rem);
    font-weight: 600;
    line-height: 1.45;
  }

  .xp-diagram-layer--applications {
    --layer-accent: var(--xp-accent-secondary);
    --layer-accent-soft: rgb(79 179 255 / 0.2);
    --layer-fill: rgb(14 32 58 / 0.92);
    --layer-edge: rgb(79 179 255 / 0.68);
    --layer-glow: rgb(79 179 255 / 0.36);
  }

  .xp-diagram-layer--guests {
    --layer-accent: #67d9df;
    --layer-accent-soft: rgb(103 217 223 / 0.18);
    --layer-fill: rgb(14 41 54 / 0.92);
    --layer-edge: rgb(103 217 223 / 0.66);
    --layer-glow: rgb(103 217 223 / 0.28);
  }

  .xp-diagram-layer--xen {
    --layer-accent: var(--xp-accent-primary);
    --layer-accent-soft: rgb(133 194 65 / 0.2);
    --layer-fill: rgb(20 44 35 / 0.94);
    --layer-edge: rgb(133 194 65 / 0.72);
    --layer-glow: rgb(133 194 65 / 0.32);
  }

  .xp-diagram-layer--hardware {
    --layer-accent: #d0df7a;
    --layer-accent-soft: rgb(208 223 122 / 0.16);
    --layer-fill: rgb(43 48 31 / 0.94);
    --layer-edge: rgb(208 223 122 / 0.58);
    --layer-glow: rgb(208 223 122 / 0.22);
  }

  @media (max-width: 639px) {
    .xp-diagram-layer {
      grid-area: auto;
      width: 100%;
      height: auto;
      transform: none;
    }

    .xp-diagram-layer + .xp-diagram-layer {
      margin-top: 0.85rem;
    }

    .xp-diagram-layer__surface {
      height: auto;
      min-height: auto;
      border-radius: var(--xp-radius-md);
    }

    .xp-diagram-layer__content {
      height: auto;
      padding: 1rem;
    }
  }
</style>
