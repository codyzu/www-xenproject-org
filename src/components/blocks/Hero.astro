---
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Section from '../primitives/Section.astro';
import Stack from '../primitives/Stack.astro';
import Text from '../primitives/Text.astro';

type Action = {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  target?: '_blank';
  rel?: string;
};
type HeadingLevel = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
type Props = {
  id?: string;
  eyebrow?: string;
  title: string;
  statement?: string;
  description?: string;
  actions?: Action[];
  headingLevel?: HeadingLevel;
  surface?: '0' | '1';
  containerSize?: 'content' | 'page' | 'wide';
  align?: 'split' | 'center';
  layout?: 'balanced' | 'media-dominant';
  class?: string;
};

const {
  id,
  eyebrow,
  title,
  statement,
  description,
  actions = [],
  headingLevel = 'h1',
  surface = '1',
  containerSize = 'wide',
  align = 'split',
  layout = 'balanced',
  class: className = '',
} = Astro.props as Props;
const hasActions = actions.length > 0;
const hasAside = Boolean(Astro.slots.has('media') || Astro.slots.has('proof') || Astro.slots.has('metadata'));
const splitLayoutClasses = {
  balanced: 'uno-grid uno-min-w-0 uno-grid-cols-1 uno-gap-6 lg:uno-grid-cols-[minmax(0,1fr)_minmax(22rem,0.72fr)] lg:uno-items-center',
  'media-dominant': 'uno-grid uno-min-w-0 uno-grid-cols-1 uno-gap-8 xl:uno-grid-cols-[minmax(30rem,34rem)_minmax(0,1fr)] xl:uno-items-center xl:uno-gap-10',
};
const contentClasses = {
  balanced: 'uno-max-w-xp-page',
  'media-dominant': 'uno-max-w-[34rem]',
};
const headingClasses = {
  balanced: 'uno-max-w-5xl',
  'media-dominant': 'uno-max-w-[36rem]',
};
const descriptionClasses = {
  balanced: 'uno-max-w-xp-content',
  'media-dominant': 'uno-max-w-[32rem]',
};
---

<Section id={id} surface={surface} variant="hero" class={className}>
  <Container size={containerSize}>
    {align === 'center' || !hasAside ? (
      <Stack gap="5" class="uno-mx-auto uno-max-w-xp-page uno-items-start uno-text-left md:uno-items-center md:uno-text-center">
        {eyebrow && <Text size="eyebrow" tone="accent-primary">{eyebrow}</Text>}
        <Heading as={headingLevel} size="display-xl" class="uno-max-w-5xl">{title}</Heading>
        {statement && <Text size="lead" tone="primary" class="uno-max-w-3xl uno-font-semibold">{statement}</Text>}
        {description && <Text size="lead" class="uno-max-w-xp-content">{description}</Text>}
        {hasActions && (
          <div class="uno-flex uno-w-full uno-flex-col uno-gap-3 uno-pt-2 sm:uno-w-auto sm:uno-flex-row sm:uno-flex-wrap sm:uno-justify-center">
            {actions.map(action => (
              <Button href={action.href} variant={action.variant ?? 'primary'} target={action.target} rel={action.rel} class="uno-w-full sm:uno-w-auto">{action.label}</Button>
            ))}
          </div>
        )}
        {Astro.slots.has('metadata') && <slot name="metadata" />}
        {Astro.slots.has('proof') && <slot name="proof" />}
        {Astro.slots.has('media') && <slot name="media" />}
      </Stack>
    ) : (
      <div class={splitLayoutClasses[layout]} data-hero-layout={layout}>
        <div class="uno-min-w-0" data-hero-content>
          <Stack gap="5" class={contentClasses[layout]}>
            {eyebrow && <Text size="eyebrow" tone="accent-primary">{eyebrow}</Text>}
            <Heading as={headingLevel} size="display-xl" class={headingClasses[layout]}>{title}</Heading>
            {statement && <Text size="lead" tone="primary" class={descriptionClasses[layout] + ' uno-font-semibold'}>{statement}</Text>}
            {description && <Text size="lead" class={descriptionClasses[layout]}>{description}</Text>}
            {hasActions && (
              <div class="uno-flex uno-w-full uno-flex-col uno-gap-3 uno-pt-2 sm:uno-w-auto sm:uno-flex-row sm:uno-flex-wrap">
                {actions.map(action => (
                  <Button href={action.href} variant={action.variant ?? 'primary'} target={action.target} rel={action.rel} class="uno-w-full sm:uno-w-auto">{action.label}</Button>
                ))}
              </div>
            )}
            {Astro.slots.has('metadata') && <slot name="metadata" />}
          </Stack>
        </div>
        <div class="uno-min-w-0" data-hero-media>
          <Stack gap="4" class="uno-min-w-0">
            {Astro.slots.has('media') && <slot name="media" />}
            {Astro.slots.has('proof') && <slot name="proof" />}
          </Stack>
        </div>
      </div>
    )}
  </Container>
</Section>
