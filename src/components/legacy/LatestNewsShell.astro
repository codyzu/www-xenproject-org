---
import {readGhostCache, type NormalizedGhostPost} from '../../../scripts/search/ghost.ts';
import {compactGhostExcerpt, formatGhostPublicationDate} from '../../data/homepage-news';

let posts: NormalizedGhostPost[] = [];
try {
  const cache = await readGhostCache();
  posts = [...(cache?.posts ?? [])]
    .sort((left, right) => Date.parse(right.publishedAt) - Date.parse(left.publishedAt))
    .slice(0, 10);
  if (!cache) console.warn('Ghost cache is unavailable; omitting the legacy latest-news carousel.');
} catch (error) {
  console.warn(
    `Unable to read cached Ghost posts; omitting the legacy latest-news carousel. ${error instanceof Error ? error.message : ''}`.trim(),
  );
}
---

{posts.length > 0 && (
  <div class="latest-news" data-latest-news data-max-cards="10">
    <div class="container">
      <h2>Latest <strong>news</strong> <a href="/blog" class="title-external-link">Read all news <i class="fas fa-arrow-right"></i></a></h2>
    </div>
    <div class="carousel-container carousel-container-width" data-latest-news-carousel role="region" aria-label="Latest Xen Project news">
      <div class="carousel-content">
        <div class="carousel-content-inner">
          <div class="carousel latest-news_container" data-copy-parity-external="ghost" data-pagefind-ignore>
            {posts.map(post => (
              <article class="carousel-item card card--news">
                <a class="card__link" href={post.url} aria-hidden="true" tabindex="-1"></a>
                <h3 class="card__label">{post.title}</h3>
                <div class="card__date">
                  <time datetime={post.publishedAt}>{formatGhostPublicationDate(post.publishedAt)}</time>
                </div>
                {post.tags.length > 0 && (
                  <div class="card__tags">
                    {post.tags.map(tag => <span class="card__tag">{tag}</span>)}
                  </div>
                )}
                <p class="card__content">{compactGhostExcerpt(post.excerpt, 240)}</p>
                {post.authors.length > 0 && <div class="card__author">by {post.authors.join(', ')}</div>}
                <div class="card__actions">
                  <a class="join-button btn btn-tertiary" href={post.url} aria-label={`Read more about ${post.title}`}>
                    Read more <i class="fas fa-arrow-right" aria-hidden="true"></i>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="carousel-buttons">
          <button class="carousel-button prev" type="button" aria-label="Previous news" disabled><i class="fas fa-arrow-left"></i></button>
          <button class="carousel-button next" type="button" aria-label="Next news" disabled><i class="fas fa-arrow-right"></i></button>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  import {initializeCarousel} from '../../scripts/carousel';

  for (const carousel of document.querySelectorAll<HTMLElement>('[data-latest-news-carousel]')) {
    document.documentElement.classList.add('has-js');
    initializeCarousel(carousel);
  }
</script>
