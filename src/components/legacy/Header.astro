---
import {navigationItems} from '../../data/navigation';
import Menu from './Menu.astro';
import Socials from './Socials.astro';

type Props = {
  currentPath: string;
};

const {currentPath} = Astro.props;
---

<header class="header" data-pagefind-ignore>
  <div class="header-inner">
    <div class="header-logo">
      <a href="/">
        <img src="/img/logo-xen-reverse.svg" alt="Xen-Project" />
      </a>
    </div>
    <button
      type="button"
      class="legacy-search-trigger xen-focus uno-inline-flex uno-min-h-11 uno-min-w-11 uno-cursor-pointer uno-items-center uno-justify-center uno-gap-[.45rem] uno-rounded-[.35rem] uno-border uno-border-solid uno-border-[rgb(255_255_255_/_0.22)] uno-bg-[rgb(0_0_0_/_0.12)] uno-px-[.7rem] uno-py-[.45rem] uno-font-sans uno-text-[.8rem] uno-font-semibold uno-leading-none uno-text-white hover:uno-border-brand-fill focus-visible:uno-border-brand-fill max-lg:uno-absolute max-lg:uno-right-[10px] max-lg:uno-z-1 max-lg:uno-ml-0"
      data-search-open
      aria-label="Search Xen Project"
    >
      <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
      <span class="max-lg:uno-hidden">Search</span>
    </button>
    <button type="button" class="menu-toggle" title="Toggle menu" aria-label="Toggle menu" aria-expanded="false" aria-controls="legacy-site-menu"></button>
    <div id="legacy-site-menu" class="header-content" data-menu-title="Menu">
      <nav class="header-nav">
        <ul class="menu">
          <Menu items={navigationItems} currentPath={currentPath} />
        </ul>
      </nav>
      <Socials />
    </div>
  </div>
</header>

<style>
  @media (max-width: 1023px) {
    .header.active .legacy-search-trigger { visibility: hidden; pointer-events: none; }
  }
</style>
