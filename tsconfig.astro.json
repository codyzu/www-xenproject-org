{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.mjs",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "themes",
    "content",
    "public",
    "dist-astro"
  ]
}
