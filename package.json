{
  "name": "xen-project",
  "version": "1.0.0",
  "description": "## Tools",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "doc": "node scripts/documentation/generate-thumbnails.js && node scripts/documentation/images.js",
    "downloads": "node scripts/downloads/getLinks.js",
    "dev": "npm run research && astro dev --host",
    "build": "npm run clean && npm run research && npm run astro:build",
    "astro:dev": "astro dev --host",
    "astro:build": "astro build",
    "astro:preview": "astro preview --host 127.0.0.1",
    "astro:check": "astro check --tsconfig tsconfig.astro.json",
    "research": "node scripts/research/parse-research-papers.js",
    "test:astro:smoke": "playwright test --config playwright.astro.config.ts",
    "test:astro:smoke:public": "PLAYWRIGHT_START_SERVER=1 playwright test --config playwright.astro.config.ts",
    "test:astro:staging": "PLAYWRIGHT_BASE_URL=https://beta.xenproject.org SITE_URL=https://beta.xenproject.org playwright test --config playwright.astro.config.ts",
    "test:astro:staging:homepage-guardrails": "PLAYWRIGHT_BASE_URL=https://beta.xenproject.org SITE_URL=https://beta.xenproject.org playwright test tests/astro/homepage-guardrails.spec.ts --config playwright.astro.config.ts",
    "test:astro:staging:ghost": "GHOST_LIVE_TEST=1 PLAYWRIGHT_BASE_URL=https://beta.xenproject.org playwright test tests/astro/ghost-live.spec.ts --config playwright.astro.config.ts",
    "test:astro:dev:ghost": "GHOST_DEV_TEST=1 PLAYWRIGHT_START_SERVER=1 PLAYWRIGHT_DEV_SERVER=1 PLAYWRIGHT_PORT=4322 playwright test tests/astro/ghost-development.spec.ts --config playwright.astro.config.ts",
    "test:astro:links": "node scripts/astro/check-public-artifact.js && node scripts/astro/check-redesign-boundaries.js",
    "test:astro:standalone": "npm run build && node scripts/astro/check-public-artifact.js public --standalone",
    "test:astro:copy-parity": "PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/copy-parity.spec.ts tests/astro/copy-parity-guardrails.spec.ts --config playwright.astro.config.ts",
    "test:astro:copy-parity:update": "PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/copy-parity.spec.ts --config playwright.astro.config.ts --update-snapshots=all --update-source-method=overwrite",
    "test:astro:smoke:update": "playwright test --config playwright.astro.config.ts --grep-invert @copy-parity --update-snapshots",
    "lint": "xo",
    "clean": "rm -rf public",
    "serve": "serve public"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/bi": "^1.2.3",
    "@iconify-json/carbon": "^1.2.8",
    "@iconify-json/fa6-solid": "^1.2.3",
    "@iconify-json/file-icons": "^1.2.1",
    "@iconify-json/lineicons": "^1.2.4",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.33",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react-dom": "^19.1.6",
    "@unocss/vite": "^66.1.0-beta.12",
    "astro": "^6.4.6",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "js-yaml": "^4.2.0",
    "marked": "^18.0.5",
    "prettier": "^3.3.3",
    "prettier-plugin-go-template": "^0.0.15",
    "serve": "^14.2.4",
    "typescript": "^6.0.3",
    "unocss": "^66.1.0-beta.12",
    "xo": "^0.61.0-2",
    "zod": "^3.24.3"
  },
  "dependencies": {
    "@react-hook/resize-observer": "^2.0.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-globe.gl": "^2.33.2",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.0",
    "sass": "^1.80.6",
    "sharp": "^0.33.2"
  }
}
