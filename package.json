    "embla-carousel-react": "^8.6.0",
    "preact": "^10.26.5",
    "puppeteer": "^23.7.0",
    "react-chartjs-2": "^5.3.0",
    "react-globe.gl": "^2.33.2",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.0",
    "sass": "^1.80.6",
    "sharp": "^0.33.2"
