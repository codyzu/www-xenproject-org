{
  "name": "xen-project",
  "version": "1.0.0",
  "description": "## Tools",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "hugo": "npx hugo",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook-tasks": "node scripts/storybook-tasks.js",
    "sb-images": "node scripts/storytasks/storybook-images.js",
    "doc": "node scripts/documentation/generate-thumbnails.js && node scripts/documentation/images.js",
    "downloads": "node scripts/downloads/getLinks.js",
    "dev": "npm run research && concurrently --names vite,hugo --prefix-colors green,blue npm:vite:dev npm:hugo:dev",
    "build": "npm run clean && npm run research && npm run vite:build && npm run hugo:build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "hugo:dev": "hugo server -D --logLevel debug --config hugo.yaml,hugo.dev.yaml --disableFastRender",
    "hugo:build": "hugo --minify",
    "research": "node scripts/research/parse-research-papers.js",
    "lint": "xo",
    "clean": "rm -rf public"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@iconify-json/bi": "^1.2.3",
    "@iconify-json/carbon": "^1.2.8",
