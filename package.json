{
  "name": "xen-project",
  "version": "1.0.0",
  "description": "## Tools",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook-tasks": "node scripts/storybook-tasks.js",
    "sb-images": "node scripts/storytasks/storybook-images.js",
    "doc": "node scripts/documentation/generate-thumbnails.js && node scripts/documentation/images.js",
    "downloads": "node scripts/downloads/getLinks.js",
    "dev": "npm run research && concurrently --names vite,hugo --prefix-colors green,blue npm:vite:dev npm:hugo:dev",
    "build": "npm run clean && npm run research && npm run vite:build && npm run hugo:build",
    "build:astro-spike": "npm run build && npm run astro:build && node scripts/astro/overlay-migrated-routes.js",
    "astro:dev": "astro dev --host 127.0.0.1",
    "astro:build": "astro build",
    "astro:overlay": "node scripts/astro/overlay-migrated-routes.js",
    "astro:preview": "astro preview --host 127.0.0.1",
    "astro:check": "astro check --tsconfig tsconfig.astro.json",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "hugo:dev": "hugo server -D --logLevel debug --config hugo.yaml,hugo.dev.yaml --disableFastRender --disableLiveReload",
    "hugo:build": "hugo --minify",
    "research": "node scripts/research/parse-research-papers.js",
    "test:astro:smoke": "playwright test --config playwright.astro.config.ts",
    "test:astro:smoke:public": "PLAYWRIGHT_START_SERVER=1 playwright test --config playwright.astro.config.ts",
    "test:astro:links": "node scripts/astro/check-public-artifact.js",
    "test:astro:smoke:hugo-baseline": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173 playwright test --config playwright.astro.config.ts --update-snapshots",
    "test:astro:smoke:update": "playwright test --config playwright.astro.config.ts --update-snapshots",
    "lint": "xo",
    "clean": "rm -rf public",
    "serve": "serve public"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@iconify-json/bi": "^1.2.3",
    "@iconify-json/carbon": "^1.2.8",
    "@iconify-json/fa6-solid": "^1.2.3",
    "@iconify-json/file-icons": "^1.2.1",
    "@iconify-json/lineicons": "^1.2.4",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.33",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "^8.4.2",
    "@storybook/addon-links": "^8.4.2",
    "@storybook/blocks": "^8.4.2",
    "@storybook/manager-api": "^8.4.2",
    "@storybook/test": "^8.4.2",
    "@storybook/theming": "^8.4.2",
    "@storybook/web-components": "^8.4.2",
    "@storybook/web-components-vite": "^8.4.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react-dom": "^19.1.6",
    "@unocss/vite": "^66.1.0-beta.12",
    "astro": "^6.4.6",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "embla-carousel": "^8.6.0",
    "hugo-extended": "^0.147.0",
    "js-yaml": "^4.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-go-template": "^0.0.15",
    "serve": "^14.2.4",
    "storybook": "^8.4.2",
    "storybook-addon-sass-postcss": "^0.3.2",
    "typescript": "^6.0.3",
    "unocss": "^66.1.0-beta.12",
    "vite": "^6.3.5",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-markdown": "^2.2.0",
    "xo": "^0.61.0-2",
    "zod": "^3.24.3"
  },
  "dependencies": {
    "@react-hook/resize-observer": "^2.0.2",
    "@react-spring/parallax": "^10.0.1",
    "@storybook/preset-scss": "^1.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "^8.6.0",
    "puppeteer": "^23.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-globe.gl": "^2.33.2",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.0",
    "sass": "^1.80.6",
    "sharp": "^0.33.2"
  }
}
