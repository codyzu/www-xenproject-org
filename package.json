{
  "name": "xen-project",
  "version": "1.0.0",
  "description": "## Tools",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "npm run search:ensure && astro dev --host",
    "build": "astro build && npm run search:index",
    "build:test": "GHOST_SEARCH_CACHE_PATH=.cache/ghost-search/test-posts.json npm run search:fixture && DOWNLOADS_SOURCE=fixture GHOST_SEARCH_CACHE_PATH=.cache/ghost-search/test-posts.json SEARCH_RANKING_FIXTURE=1 npm run build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "npm run check:code && npm run test:docs && npm run test:unit",
    "check:code": "npm run lint && npm run typecheck",
    "check:dist": "npm run check:artifact && npm run check:boundaries",
    "check:artifact": "node scripts/astro/check-public-artifact.js dist --standalone",
    "check:boundaries": "node scripts/astro/check-redesign-boundaries.js",
    "lint": "xo",
    "typecheck": "DOWNLOADS_SOURCE=fixture astro check --tsconfig tsconfig.astro.json",
    "test:unit": "npm run test:downloads && npm run test:search",
    "test:docs": "node scripts/documentation/check-links.js",
    "test:downloads": "node --test tests/downloads/*.test.js",
    "test:search": "node --test tests/search/*.test.ts",
    "test:e2e": "npm run build:test && npm run check:dist && npm run test:e2e:run",
    "test:e2e:run": "PLAYWRIGHT_SKIP_SEARCH=1 PLAYWRIGHT_START_SERVER=1 playwright test --config playwright.astro.config.ts && SEARCH_FIXTURE_TEST=1 PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/search.spec.ts --config playwright.astro.config.ts --workers=1",
    "test:e2e:high-value": "PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/high-value-responsive.spec.ts tests/astro/high-value-navigation.spec.ts tests/astro/high-value-webkit-mobile.spec.ts tests/astro/homepage-latest.spec.ts --config playwright.astro.config.ts",
    "test:e2e:search": "GHOST_SEARCH_CACHE_PATH=.cache/ghost-search/test-posts.json npm run search:fixture && GHOST_SEARCH_CACHE_PATH=.cache/ghost-search/test-posts.json SEARCH_RANKING_FIXTURE=1 npm run search:index && SEARCH_FIXTURE_TEST=1 PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/search.spec.ts --config playwright.astro.config.ts --workers=1",
    "test:e2e:copy": "PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/copy-parity.spec.ts tests/astro/copy-parity-guardrails.spec.ts --config playwright.astro.config.ts",
    "test:e2e:copy:update": "PLAYWRIGHT_START_SERVER=1 playwright test tests/astro/copy-parity.spec.ts --config playwright.astro.config.ts --update-snapshots=all --update-source-method=overwrite",
    "test:e2e:snapshots:update": "PLAYWRIGHT_SKIP_SEARCH=1 PLAYWRIGHT_START_SERVER=1 playwright test --config playwright.astro.config.ts --grep-invert @copy-parity --update-snapshots",
    "test:staging": "PLAYWRIGHT_BASE_URL=https://beta.xenproject.org SITE_URL=https://beta.xenproject.org playwright test --config playwright.astro.config.ts",
    "test:staging:homepage": "PLAYWRIGHT_BASE_URL=https://beta.xenproject.org SITE_URL=https://beta.xenproject.org playwright test tests/astro/homepage-guardrails.spec.ts --config playwright.astro.config.ts",
    "screenshots": "node scripts/astro/screenshots.ts",
    "search:refresh": "node --env-file-if-exists=.env.local scripts/search/refresh.ts",
    "search:ensure": "node scripts/search/ensure-cache.ts",
    "search:index": "node scripts/search/index.ts",
    "search:fixture": "node scripts/search/fixture-cache.ts"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "4.12.1",
    "@iconify-json/bi": "^1.2.3",
    "@iconify-json/carbon": "^1.2.8",
    "@iconify-json/fa6-solid": "^1.2.3",
    "@iconify-json/file-icons": "^1.2.1",
    "@iconify-json/lineicons": "^1.2.4",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.33",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "@playwright/test": "1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react-dom": "^19.1.6",
    "@unocss/vite": "^66.1.0-beta.12",
    "astro": "^6.4.6",
    "astro-expressive-code": "^0.44.1",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "js-yaml": "^4.2.0",
    "marked": "^18.0.5",
    "pagefind": "^1.5.2",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "unocss": "^66.1.0-beta.12",
    "xo": "^0.61.0-2",
    "zod": "^3.24.3"
  },
  "dependencies": {
    "@react-hook/resize-observer": "^2.0.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-globe.gl": "^2.33.2",
    "recharts": "^2.15.3",
    "sass": "^1.80.6",
    "sharp": "^0.33.2"
  }
}
